{
  "name": "@stopcock/fp-compiler",
  "version": "2.0.0-next.0",
  "description": "Build-time lowering for portable Stopcock FP pipelines",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdeaks/stopcock.git",
    "directory": "packages/fp-compiler"
  },
  "bin": {
    "stopcock": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate:ops": "bun run scripts/gen-ops-table.ts",
    "qualify:s11r": "node scripts/s11r-qualify.mjs",
    "qualify:s11r:hosts": "node scripts/s11r-extracted-matrix.mjs",
    "qualify:s11r:layouts": "node scripts/s11r-extracted-layouts.mjs",
    "test": "vp test run src/__tests__",
    "check:source": "tsc -p tsconfig.json --noEmit",
    "check:types": "tsc -p tsconfig.type-tests.json",
    "check:release": "bun run check:source && bun run check:types && bun run test"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "magic-string": "^1.0.0",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@rspack/core": "^2.1.1",
    "@stopcock/fp": "workspace:*",
    "@types/babel__traverse": "^7.28.0",
    "esbuild": "^0.28.1",
    "rollup": "^4.62.2",
    "vite": "^0.2.5",
    "vite-plus": "^0.2.5",
    "webpack": "^5.108.4"
  },
  "peerDependencies": {
    "@stopcock/fp": "2.0.0-next.0"
  },
  "engines": {
    "node": ">=22"
  }
}
