  "scripts": {
    "codegen": "bun run codegen/dual-inline.ts && bun run codegen/portable-templates.ts && bun run scripts/sync-module-manifest.ts",
    "codegen:check": "bun run codegen && git diff --exit-code -- src package.json module-manifest.ts",
    "manifest:check": "bun run scripts/sync-module-manifest.ts --check",
    "check:portable": "bun run scripts/check-portable-boundary.ts",
    "check:codegen-types": "tsc -p codegen/tsconfig.json --noEmit",
    "check:script-types": "tsc -p scripts/tsconfig.json --noEmit",
    "check:source": "tsc -p tsconfig.json --noEmit",
    "check:types": "tsc -p tsconfig.type-tests.json",
    "check:contract": "bun run scripts/check-package-contract.ts",
    "check:release": "bun run codegen:check && bun run manifest:check && bun run check:portable && bun run check:codegen-types && bun run check:script-types && bun run check:source && bun run check:types && node ../../tooling/build-package.mjs && bunx vitest run src/__tests__ && bun run check:contract"
  },
  "engines": {
    "node": ">=22"
  }
}
