{
  "name": "@stopcock/fp",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdeaks/stopcock.git",
    "directory": "packages/fp"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#jit-loader": {
      "stopcock-portable": "./src/jit-loader-portable.ts",
      "default": "./src/jit-loader.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lens": {
      "types": "./dist/lens.d.ts",
      "import": "./dist/lens.js"
    },
    "./dual": {
      "types": "./dist/dual-lite.d.ts",
      "import": "./dist/dual-lite.js"
    },
    "./guard": {
      "types": "./dist/guard.d.ts",
      "import": "./dist/guard.js"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "import": "./dist/result.js"
    },
    "./option": {
      "types": "./dist/option.d.ts",
      "import": "./dist/option.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js"
    },
    "./array": {
      "types": "./dist/array.d.ts",
      "import": "./dist/array.js"
    },
    "./object": {
      "types": "./dist/object.d.ts",
      "import": "./dist/object.js"
    },
    "./dict": {
      "types": "./dist/dict.d.ts",
      "import": "./dist/dict.js"
    },
    "./string": {
      "types": "./dist/string.d.ts",
      "import": "./dist/string.js"
    },
    "./number": {
      "types": "./dist/number.d.ts",
      "import": "./dist/number.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js"
    },
    "./boolean": {
      "types": "./dist/boolean.d.ts",
      "import": "./dist/boolean.js"
    },
    "./logic": {
      "types": "./dist/logic.d.ts",
      "import": "./dist/logic.js"
    },
    "./function": {
      "types": "./dist/function.d.ts",
      "import": "./dist/function.js"
    }
  },
  "scripts": {
    "codegen": "bun run codegen/dual-inline.ts && bun run codegen/portable-templates.ts",
    "check:portable": "bun run scripts/check-portable-boundary.ts"
  }
}
