{
  "name": "@stopcock/async",
  "version": "1.0.0",
  "description": "Lazy cancellable Task and AsyncIter utilities for TypeScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdeaks/stopcock.git",
    "directory": "packages/async"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./async-iter": {
      "types": "./dist/async-iter.d.ts",
      "import": "./dist/async-iter.js"
    },
    "./task": {
      "types": "./dist/task-namespace.d.ts",
      "import": "./dist/task.js"
    }
  },
  "dependencies": {
    "@stopcock/fp": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
