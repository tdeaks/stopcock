{
  "name": "@stopcock/parser",
  "version": "3.0.0",
  "description": "Fast, typed parser combinators with precise source errors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdeaks/stopcock.git",
    "directory": "packages/parser"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./combinators": {
      "types": "./dist/combinators.d.ts",
      "import": "./dist/combinators.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js"
    }
  },
  "scripts": {
    "check:types": "tsc -p tsconfig.type-tests.json"
  },
  "devDependencies": {
    "@stopcock/fp": "workspace:*",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@stopcock/fp": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
