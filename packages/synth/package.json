{
  "name": "@stopcock/synth",
  "version": "2.0.0-next.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdeaks/stopcock.git",
    "directory": "packages/synth"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build:wasm": "cargo build --manifest-path Cargo.toml --release --target wasm32-unknown-unknown --package stopcock_synth_wasm --target-dir wasm/target && bun run scripts/embed-wasm.ts",
    "bench:triggered": "bun run scripts/bench-triggered-wasm.ts",
    "test:wasm": "cargo test --manifest-path Cargo.toml --workspace",
    "test": "bun run test:wasm && bun run build:wasm && vp test run"
  },
  "dependencies": {
    "@stopcock/fp": "workspace:*",
    "@stopcock/signal": "workspace:*"
  }
}
