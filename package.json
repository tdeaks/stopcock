{
  "name": "stopcock-monorepo",
  "private": true,
  "type": "module",
  "description": "High-performance functional programming library for TypeScript",
  "license": "MIT",
  "workspaces": ["packages/*", "apps/*", "benchmarks"],
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*' --filter='!@stopcock/synth'",
    "test": "vitest run",
    "test:packages": "vitest run --exclude='packages/synth/**'",
    "docs:dev": "turbo run dev --filter=@stopcock/docs",
    "docs:build": "turbo run build --filter=@stopcock/docs",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@fast-check/vitest": "~0.4.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@rescript/language-server": "^1.72.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.0",
    "jotai": "^2.20.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "puppeteer": "^25.3.0"
  }
}
