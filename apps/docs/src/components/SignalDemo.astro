---
const id = 'signal-demo'
---

<div class="signal-demo not-content" id={id} data-signal-demo>
  <div class="sg-header">
    <div>
      <h2>Signal workbench</h2>
      <p>Typed-array DSP kernels running in the browser.</p>
    </div>
    <div class="sg-code" aria-live="polite">
      <span>pipeline</span>
      <code id={`${id}-pipeline`}></code>
    </div>
  </div>

  <div class="sg-layout">
    <section class="sg-panel sg-controls" aria-label="Signal controls">
      <div class="sg-group">
        <span class="sg-label">Source</span>
        <div class="sg-segments" id={`${id}-sources`} role="radiogroup" aria-label="Source waveform"></div>
      </div>

      <label class="sg-control" for={`${id}-cutoff`}>
        <span>Cutoff</span>
        <output id={`${id}-cutoff-value`}></output>
        <input id={`${id}-cutoff`} type="range" min="180" max="9800" step="20" value="1800" />
      </label>

      <label class="sg-control" for={`${id}-resonance`}>
        <span>Q</span>
        <output id={`${id}-resonance-value`}></output>
        <input id={`${id}-resonance`} type="range" min="0.4" max="8" step="0.1" value="0.9" />
      </label>

      <label class="sg-control" for={`${id}-tail`}>
        <span>Convolution tail</span>
        <output id={`${id}-tail-value`}></output>
        <input id={`${id}-tail`} type="range" min="0" max="0.95" step="0.01" value="0.35" />
      </label>

      <label class="sg-control" for={`${id}-ratio`}>
        <span>Resample</span>
        <output id={`${id}-ratio-value`}></output>
        <input id={`${id}-ratio`} type="range" min="0.5" max="1.8" step="0.01" value="1" />
      </label>

      <div class="sg-actions">
        <button type="button" id={`${id}-filter`}>Low-pass</button>
        <button type="button" id={`${id}-reset`}>Reset</button>
      </div>
    </section>

    <section class="sg-panel sg-visuals" aria-label="Signal visualizations">
      <div class="sg-chart">
        <div class="sg-chart-head">
          <span>Waveform</span>
          <output id={`${id}-samples`}></output>
        </div>
        <canvas id={`${id}-waveform`} width="720" height="240"></canvas>
      </div>
      <div class="sg-chart">
        <div class="sg-chart-head">
          <span>Spectrum</span>
          <output id={`${id}-centroid`}></output>
        </div>
        <canvas id={`${id}-spectrum`} width="720" height="180"></canvas>
      </div>
    </section>
  </div>

  <section class="sg-readout" aria-label="Signal analysis readout">
    <div>
      <span>rms</span>
      <output id={`${id}-rms`}></output>
    </div>
    <div>
      <span>peak</span>
      <output id={`${id}-peak`}></output>
    </div>
    <div>
      <span>zero crossings</span>
      <output id={`${id}-zcr`}></output>
    </div>
    <div>
      <span>rolloff</span>
      <output id={`${id}-rolloff`}></output>
    </div>
  </section>

  <section class="sg-lab-grid" aria-label="Focused signal demos">
    <article class="sg-panel sg-lab sg-lab-wide">
      <header class="sg-lab-head">
        <div>
          <h3>Filter response</h3>
          <p>biquad.freqResponse</p>
        </div>
        <code id={`${id}-response-code`}></code>
      </header>

      <div class="sg-lab-controls">
        <label class="sg-mini-control" for={`${id}-response-kind`}>
          <span>Kind</span>
          <select id={`${id}-response-kind`}>
            <option value="lowpass">lowpass</option>
            <option value="highpass">highpass</option>
            <option value="bandpass">bandpass</option>
            <option value="notch">notch</option>
            <option value="peak">peak</option>
            <option value="lowshelf">lowshelf</option>
            <option value="highshelf">highshelf</option>
            <option value="allpass">allpass</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-response-freq`}>
          <span>Freq</span>
          <output id={`${id}-response-freq-value`}></output>
          <input id={`${id}-response-freq`} type="range" min="80" max="12000" step="20" value="1600" />
        </label>
        <label class="sg-mini-control" for={`${id}-response-q`}>
          <span>Q</span>
          <output id={`${id}-response-q-value`}></output>
          <input id={`${id}-response-q`} type="range" min="0.35" max="8" step="0.05" value="1.2" />
        </label>
        <label class="sg-mini-control" for={`${id}-response-gain`}>
          <span>Gain</span>
          <output id={`${id}-response-gain-value`}></output>
          <input id={`${id}-response-gain`} type="range" min="-12" max="12" step="0.5" value="4" />
        </label>
      </div>

      <canvas id={`${id}-response`} width="720" height="220"></canvas>
      <div class="sg-lab-readout">
        <span>max <output id={`${id}-response-max`}></output></span>
        <span>min <output id={`${id}-response-min`}></output></span>
        <span>points <output id={`${id}-response-points`}></output></span>
      </div>
      <p class="sg-footnote">
        Shows the magnitude and phase curve produced by `biquad.freqResponse()`, so UI controls can preview a filter before processing audio.
      </p>
    </article>

    <article class="sg-panel sg-lab sg-lab-wide">
      <header class="sg-lab-head">
        <div>
          <h3>Overlap-add flush</h3>
          <p>convolve.overlapAdd + flush</p>
        </div>
        <code id={`${id}-conv-code`}></code>
      </header>

      <div class="sg-lab-controls">
        <label class="sg-mini-control" for={`${id}-conv-samples`}>
          <span>Samples</span>
          <output id={`${id}-conv-samples-value`}></output>
          <input id={`${id}-conv-samples`} type="range" min="160" max="420" step="1" value="275" />
        </label>
        <label class="sg-mini-control" for={`${id}-conv-block`}>
          <span>Block</span>
          <select id={`${id}-conv-block`}>
            <option value="32">32</option>
            <option value="64" selected>64</option>
            <option value="128">128</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-conv-kernel`}>
          <span>Kernel</span>
          <output id={`${id}-conv-kernel-value`}></output>
          <input id={`${id}-conv-kernel`} type="range" min="8" max="220" step="1" value="144" />
        </label>
        <label class="sg-mini-control" for={`${id}-conv-decay`}>
          <span>Decay</span>
          <output id={`${id}-conv-decay-value`}></output>
          <input id={`${id}-conv-decay`} type="range" min="0.1" max="0.95" step="0.01" value="0.52" />
        </label>
      </div>

      <canvas id={`${id}-convolution`} width="720" height="220"></canvas>
      <div class="sg-lab-readout">
        <span>blocks <output id={`${id}-conv-blocks`}></output></span>
        <span>tail <output id={`${id}-conv-tail`}></output></span>
        <span>max error <output id={`${id}-conv-error`}></output></span>
      </div>
      <p class="sg-footnote">
        Compares overlap-add streaming output with direct convolution and highlights the flushed tail that completes the full result.
      </p>
    </article>

    <article class="sg-panel sg-lab sg-lab-wide">
      <header class="sg-lab-head">
        <div>
          <h3>Windowed FFT</h3>
          <p>window.apply + fft.rfft</p>
        </div>
        <code id={`${id}-window-code`}></code>
      </header>

      <div class="sg-lab-controls">
        <label class="sg-mini-control" for={`${id}-window-kind`}>
          <span>Window</span>
          <select id={`${id}-window-kind`}>
            <option value="rect">rect</option>
            <option value="hann" selected>hann</option>
            <option value="hamming">hamming</option>
            <option value="blackman">blackman</option>
            <option value="blackman-harris">blackman-harris</option>
            <option value="triangular">triangular</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-window-size`}>
          <span>FFT</span>
          <select id={`${id}-window-size`}>
            <option value="512">512</option>
            <option value="1024" selected>1024</option>
            <option value="2048">2048</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-window-freq`}>
          <span>Tone</span>
          <output id={`${id}-window-freq-value`}></output>
          <input id={`${id}-window-freq`} type="range" min="120" max="3200" step="1" value="523" />
        </label>
      </div>

      <canvas id={`${id}-windowed-fft`} width="960" height="260"></canvas>
      <div class="sg-lab-readout">
        <span>peak <output id={`${id}-window-peak`}></output></span>
        <span>centroid <output id={`${id}-window-centroid`}></output></span>
        <span>flatness <output id={`${id}-window-flatness`}></output></span>
      </div>
      <p class="sg-footnote">
        Applies a selectable window before `fft.rfft()` so leakage, peak-bin placement, and spectral descriptors can be compared directly.
      </p>
    </article>

    <article class="sg-panel sg-lab sg-lab-wide">
      <header class="sg-lab-head">
        <div>
          <h3>FIR designer</h3>
          <p>fir.design + fft.rfft</p>
        </div>
        <code id={`${id}-fir-code`}></code>
      </header>

      <div class="sg-lab-controls">
        <label class="sg-mini-control" for={`${id}-fir-kind`}>
          <span>Kind</span>
          <select id={`${id}-fir-kind`}>
            <option value="lowpass" selected>lowpass</option>
            <option value="highpass">highpass</option>
            <option value="bandpass">bandpass</option>
            <option value="notch">notch</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-fir-window`}>
          <span>Window</span>
          <select id={`${id}-fir-window`}>
            <option value="hann" selected>hann</option>
            <option value="hamming">hamming</option>
            <option value="blackman">blackman</option>
            <option value="blackman-harris">blackman-harris</option>
            <option value="triangular">triangular</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-fir-freq`}>
          <span>Freq</span>
          <output id={`${id}-fir-freq-value`}></output>
          <input id={`${id}-fir-freq`} type="range" min="120" max="10000" step="20" value="1800" />
        </label>
        <label class="sg-mini-control" for={`${id}-fir-taps`}>
          <span>Taps</span>
          <output id={`${id}-fir-taps-value`}></output>
          <input id={`${id}-fir-taps`} type="range" min="15" max="127" step="2" value="63" />
        </label>
      </div>

      <canvas id={`${id}-fir`} width="720" height="220"></canvas>
      <div class="sg-lab-readout">
        <span>history <output id={`${id}-fir-history`}></output></span>
        <span>tap sum <output id={`${id}-fir-sum`}></output></span>
        <span>latency <output id={`${id}-fir-latency`}></output></span>
      </div>
      <p class="sg-footnote">
        Designs FIR taps, displays their impulse shape, and checks the response plus history length required by `fir.process()`.
      </p>
    </article>

    <article class="sg-panel sg-lab sg-lab-wide">
      <header class="sg-lab-head">
        <div>
          <h3>Resampling</h3>
          <p>resample.outputLength</p>
        </div>
        <code id={`${id}-resample-code`}></code>
      </header>

      <div class="sg-lab-controls">
        <label class="sg-mini-control" for={`${id}-resample-method`}>
          <span>Method</span>
          <select id={`${id}-resample-method`}>
            <option value="linear">linear</option>
            <option value="sinc" selected>sinc</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-resample-ratio`}>
          <span>Ratio</span>
          <output id={`${id}-resample-ratio-value`}></output>
          <input id={`${id}-resample-ratio`} type="range" min="0.35" max="2.4" step="0.01" value="1.35" />
        </label>
        <label class="sg-mini-control" for={`${id}-resample-width`}>
          <span>Width</span>
          <output id={`${id}-resample-width-value`}></output>
          <input id={`${id}-resample-width`} type="range" min="2" max="14" step="1" value="8" />
        </label>
      </div>

      <canvas id={`${id}-resample`} width="720" height="220"></canvas>
      <div class="sg-lab-readout">
        <span>input <output id={`${id}-resample-input`}></output></span>
        <span>output <output id={`${id}-resample-output`}></output></span>
        <span>peak <output id={`${id}-resample-peak`}></output></span>
      </div>
      <p class="sg-footnote">
        Contrasts one-shot linear and sinc resampling while keeping output sizing explicit through `resample.outputLength()`.
      </p>
    </article>

    <article class="sg-panel sg-lab sg-lab-wide">
      <header class="sg-lab-head">
        <div>
          <h3>Analysis contract</h3>
          <p>spectral features and zero-energy guard</p>
        </div>
        <code id={`${id}-analysis-code`}></code>
      </header>

      <div class="sg-lab-controls">
        <label class="sg-mini-control" for={`${id}-analysis-source`}>
          <span>Fixture</span>
          <select id={`${id}-analysis-source`}>
            <option value="silence">silence</option>
            <option value="tone">tone</option>
            <option value="noise" selected>noise</option>
            <option value="impulse">impulse</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-analysis-amp`}>
          <span>Level</span>
          <output id={`${id}-analysis-amp-value`}></output>
          <input id={`${id}-analysis-amp`} type="range" min="0" max="1" step="0.01" value="0.68" />
        </label>
        <label class="sg-mini-control" for={`${id}-analysis-rolloff`}>
          <span>Rolloff</span>
          <output id={`${id}-analysis-rolloff-value`}></output>
          <input id={`${id}-analysis-rolloff`} type="range" min="0.5" max="0.95" step="0.01" value="0.85" />
        </label>
      </div>

      <canvas id={`${id}-analysis`} width="960" height="240"></canvas>
      <div class="sg-lab-readout">
        <span>centroid <output id={`${id}-analysis-centroid`}></output></span>
        <span>flatness <output id={`${id}-analysis-flatness`}></output></span>
        <span>rolloff <output id={`${id}-analysis-rolloff-out`}></output></span>
      </div>
      <p class="sg-footnote">
        Exercises spectral descriptors on silence and non-silence fixtures, including the zero-energy contract that returns zero instead of NaN.
      </p>
    </article>

    <article class="sg-panel sg-lab sg-lab-wide sg-lab-wow">
      <header class="sg-lab-head">
        <div>
          <h3>Spectrogram painter</h3>
          <p>window.apply + fft.rfft across overlapping frames</p>
        </div>
        <code id={`${id}-spectro-code`}></code>
      </header>

      <div class="sg-lab-controls">
        <label class="sg-mini-control" for={`${id}-spectro-mode`}>
          <span>Scene</span>
          <select id={`${id}-spectro-mode`}>
            <option value="chirp" selected>chirp ladder</option>
            <option value="voiceprint">voiceprint</option>
            <option value="pulse">pulse train</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-spectro-window`}>
          <span>Window</span>
          <select id={`${id}-spectro-window`}>
            <option value="hann" selected>hann</option>
            <option value="hamming">hamming</option>
            <option value="blackman">blackman</option>
            <option value="blackman-harris">blackman-harris</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-spectro-size`}>
          <span>FFT</span>
          <select id={`${id}-spectro-size`}>
            <option value="256">256</option>
            <option value="512" selected>512</option>
            <option value="1024">1024</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-spectro-drive`}>
          <span>Glow</span>
          <output id={`${id}-spectro-drive-value`}></output>
          <input id={`${id}-spectro-drive`} type="range" min="1" max="8" step="0.1" value="4.2" />
        </label>
      </div>

      <canvas id={`${id}-spectrogram`} width="960" height="320"></canvas>
      <div class="sg-lab-readout">
        <span>frames <output id={`${id}-spectro-frames`}></output></span>
        <span>avg centroid <output id={`${id}-spectro-centroid`}></output></span>
        <span>peak bin <output id={`${id}-spectro-peak`}></output></span>
      </div>
      <p class="sg-footnote">
        Builds a small spectrogram by running windowed FFT analysis over overlapping frames, with the centroid trace drawn across time.
      </p>
    </article>

    <article class="sg-panel sg-lab sg-lab-wide sg-lab-wow">
      <header class="sg-lab-head">
        <div>
          <h3>Frequency sculptor</h3>
          <p>fft.rfft + spectral mask + fft.irfft</p>
        </div>
        <code id={`${id}-sculpt-code`}></code>
      </header>

      <div class="sg-lab-controls">
        <label class="sg-mini-control" for={`${id}-sculpt-mode`}>
          <span>Move</span>
          <select id={`${id}-sculpt-mode`}>
            <option value="spotlight" selected>spotlight</option>
            <option value="notch">notch</option>
            <option value="lift">lift</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-sculpt-center`}>
          <span>Center</span>
          <output id={`${id}-sculpt-center-value`}></output>
          <input id={`${id}-sculpt-center`} type="range" min="120" max="9000" step="20" value="1800" />
        </label>
        <label class="sg-mini-control" for={`${id}-sculpt-width`}>
          <span>Width</span>
          <output id={`${id}-sculpt-width-value`}></output>
          <input id={`${id}-sculpt-width`} type="range" min="0.18" max="2.6" step="0.02" value="0.72" />
        </label>
        <label class="sg-mini-control" for={`${id}-sculpt-depth`}>
          <span>Depth</span>
          <output id={`${id}-sculpt-depth-value`}></output>
          <input id={`${id}-sculpt-depth`} type="range" min="0" max="1" step="0.01" value="0.82" />
        </label>
      </div>

      <canvas id={`${id}-sculpt`} width="960" height="320"></canvas>
      <div class="sg-lab-readout">
        <span>before <output id={`${id}-sculpt-before`}></output></span>
        <span>after <output id={`${id}-sculpt-after`}></output></span>
        <span>changed <output id={`${id}-sculpt-changed`}></output></span>
      </div>
      <p class="sg-footnote">
        Shapes real FFT bins directly and reconstructs the signal with `fft.irfft()`, making spectral edits visible in frequency and time.
      </p>
    </article>

    <article class="sg-panel sg-lab sg-lab-wide">
      <header class="sg-lab-head">
        <div>
          <h3>Envelope follower</h3>
          <p>onepole.lp over rectified blocks</p>
        </div>
        <code id={`${id}-envelope-code`}></code>
      </header>

      <div class="sg-lab-controls">
        <label class="sg-mini-control" for={`${id}-envelope-source`}>
          <span>Source</span>
          <select id={`${id}-envelope-source`}>
            <option value="pluck" selected>pluck</option>
            <option value="drums">drums</option>
            <option value="speech">speech-ish</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-envelope-cutoff`}>
          <span>Follow</span>
          <output id={`${id}-envelope-cutoff-value`}></output>
          <input id={`${id}-envelope-cutoff`} type="range" min="4" max="180" step="1" value="32" />
        </label>
        <label class="sg-mini-control" for={`${id}-envelope-drive`}>
          <span>Drive</span>
          <output id={`${id}-envelope-drive-value`}></output>
          <input id={`${id}-envelope-drive`} type="range" min="0.3" max="2" step="0.01" value="1" />
        </label>
      </div>

      <canvas id={`${id}-envelope`} width="960" height="260"></canvas>
      <div class="sg-lab-readout">
        <span>signal peak <output id={`${id}-envelope-peak`}></output></span>
        <span>env peak <output id={`${id}-envelope-env-peak`}></output></span>
        <span>state <output id={`${id}-envelope-state`}></output></span>
      </div>
      <p class="sg-footnote">
        Rectifies an input block and smooths it with `onepole.process()`, the basic shape of envelope tracking and control-rate modulation.
      </p>
    </article>

    <article class="sg-panel sg-lab sg-lab-wide">
      <header class="sg-lab-head">
        <div>
          <h3>Polyphase one-shot</h3>
          <p>resample.polyphase</p>
        </div>
        <code id={`${id}-poly-code`}></code>
      </header>

      <div class="sg-lab-controls">
        <label class="sg-mini-control" for={`${id}-poly-ratio`}>
          <span>Ratio</span>
          <select id={`${id}-poly-ratio`}>
            <option value="2/1" selected>2:1</option>
            <option value="3/2">3:2</option>
            <option value="1/2">1:2</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-poly-taps`}>
          <span>Taps</span>
          <select id={`${id}-poly-taps`}>
            <option value="hold" selected>per-phase hold</option>
            <option value="soft">soft blend</option>
            <option value="stagger">staggered echo</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-poly-shape`}>
          <span>Fixture</span>
          <select id={`${id}-poly-shape`}>
            <option value="steps" selected>steps</option>
            <option value="wave">wave</option>
            <option value="impulses">impulses</option>
          </select>
        </label>
      </div>

      <canvas id={`${id}-polyphase`} width="960" height="260"></canvas>
      <div class="sg-lab-readout">
        <span>up/down <output id={`${id}-poly-ratio-out`}></output></span>
        <span>output <output id={`${id}-poly-output`}></output></span>
        <span>tap phases <output id={`${id}-poly-phases`}></output></span>
      </div>
      <p class="sg-footnote">
        Demonstrates the documented one-shot polyphase path: callers size the output, choose phase taps, and process a complete buffer.
      </p>
    </article>

    <article class="sg-panel sg-lab sg-lab-wide">
      <header class="sg-lab-head">
        <div>
          <h3>Chunked biquad</h3>
          <p>biquad.process with persistent state</p>
        </div>
        <code id={`${id}-stream-code`}></code>
      </header>

      <div class="sg-lab-controls">
        <label class="sg-mini-control" for={`${id}-stream-source`}>
          <span>Source</span>
          <select id={`${id}-stream-source`}>
            <option value="step" selected>step</option>
            <option value="tone">tone burst</option>
            <option value="noise">noise</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-stream-kind`}>
          <span>Kind</span>
          <select id={`${id}-stream-kind`}>
            <option value="lowpass" selected>lowpass</option>
            <option value="highpass">highpass</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-stream-chunk`}>
          <span>Chunk</span>
          <select id={`${id}-stream-chunk`}>
            <option value="16">16</option>
            <option value="32">32</option>
            <option value="64" selected>64</option>
            <option value="128">128</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-stream-cutoff`}>
          <span>Cutoff</span>
          <output id={`${id}-stream-cutoff-value`}></output>
          <input id={`${id}-stream-cutoff`} type="range" min="120" max="8000" step="20" value="1200" />
        </label>
      </div>

      <canvas id={`${id}-stream`} width="960" height="260"></canvas>
      <div class="sg-lab-readout">
        <span>chunks <output id={`${id}-stream-chunks`}></output></span>
        <span>max error <output id={`${id}-stream-error`}></output></span>
        <span>state <output id={`${id}-stream-state`}></output></span>
      </div>
      <p class="sg-footnote">
        Processes the same signal as one whole buffer and as chunks, showing that persistent filter state makes streaming output match.
      </p>
    </article>

    <article class="sg-panel sg-lab sg-lab-wide">
      <header class="sg-lab-head">
        <div>
          <h3>FFT round-trip</h3>
          <p>fft.rfft + fft.irfft</p>
        </div>
        <code id={`${id}-roundtrip-code`}></code>
      </header>

      <div class="sg-lab-controls">
        <label class="sg-mini-control" for={`${id}-roundtrip-source`}>
          <span>Fixture</span>
          <select id={`${id}-roundtrip-source`}>
            <option value="tone" selected>tone stack</option>
            <option value="chirp">chirp</option>
            <option value="noise">noise</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-roundtrip-size`}>
          <span>Size</span>
          <select id={`${id}-roundtrip-size`}>
            <option value="512">512</option>
            <option value="1024" selected>1024</option>
            <option value="2048">2048</option>
          </select>
        </label>
        <label class="sg-mini-control" for={`${id}-roundtrip-trim`}>
          <span>Taper</span>
          <output id={`${id}-roundtrip-trim-value`}></output>
          <input id={`${id}-roundtrip-trim`} type="range" min="0" max="1" step="0.01" value="0.35" />
        </label>
      </div>

      <canvas id={`${id}-roundtrip`} width="960" height="300"></canvas>
      <div class="sg-lab-readout">
        <span>bins <output id={`${id}-roundtrip-bins`}></output></span>
        <span>rms <output id={`${id}-roundtrip-rms`}></output></span>
        <span>max error <output id={`${id}-roundtrip-error`}></output></span>
      </div>
      <p class="sg-footnote">
        Sends real samples into the real FFT and reconstructs them with `fft.irfft()`, exposing bin count and reconstruction error.
      </p>
    </article>
  </section>
</div>

<script>
  import { analysis, biquad, convolve, fft, fir, onepole, resample, window as signalWindow } from '@stopcock/signal'

  const root = document.querySelector('[data-signal-demo]') as HTMLElement
  if (!root) throw new Error('SignalDemo root not found')

  const id = root.id
  const $ = <T extends HTMLElement = HTMLElement>(suffix: string): T => {
    const el = root.querySelector(`#${id}-${suffix}`) as T | null
    if (!el) throw new Error(`SignalDemo missing ${suffix}`)
    return el
  }

  const sampleRate = 44100
  const length = 1024
  const fftSize = 2048
  const blockSize = 128
  const sources = {
    sine: { label: 'Sine', code: 'sine(220)' },
    chord: { label: 'Chord', code: 'chord([220, 330, 495])' },
    impulse: { label: 'Impulse', code: 'impulseTrain(8)' },
    noise: { label: 'Noise', code: 'noise(seed)' },
  } as const
  type SourceKey = keyof typeof sources
  type FilterMode = 'lowpass' | 'highpass'
  type ResponseKind = 'lowpass' | 'highpass' | 'bandpass' | 'notch' | 'peak' | 'lowshelf' | 'highshelf' | 'allpass'
  type FirKind = 'lowpass' | 'highpass' | 'bandpass' | 'notch'
  type WindowChoice = 'rect' | 'hann' | 'hamming' | 'blackman' | 'blackman-harris' | 'triangular'
  type ResampleMethod = 'linear' | 'sinc'
  type AnalysisSource = 'silence' | 'tone' | 'noise' | 'impulse'
  type SpectrogramMode = 'chirp' | 'voiceprint' | 'pulse'
  type SculptMode = 'spotlight' | 'notch' | 'lift'
  type EnvelopeSource = 'pluck' | 'drums' | 'speech'
  type PolyRatio = '2/1' | '3/2' | '1/2'
  type PolyTapPreset = 'hold' | 'soft' | 'stagger'
  type PolyFixture = 'steps' | 'wave' | 'impulses'
  type StreamSource = 'step' | 'tone' | 'noise'
  type RoundtripSource = 'tone' | 'chirp' | 'noise'

  const sourceButtons = $('sources')
  const cutoff = $('cutoff') as HTMLInputElement
  const resonance = $('resonance') as HTMLInputElement
  const tail = $('tail') as HTMLInputElement
  const ratio = $('ratio') as HTMLInputElement
  const cutoffValue = $('cutoff-value') as HTMLOutputElement
  const resonanceValue = $('resonance-value') as HTMLOutputElement
  const tailValue = $('tail-value') as HTMLOutputElement
  const ratioValue = $('ratio-value') as HTMLOutputElement
  const filterButton = $('filter') as HTMLButtonElement
  const resetButton = $('reset') as HTMLButtonElement
  const pipeline = $('pipeline') as HTMLElement
  const waveform = $('waveform') as HTMLCanvasElement
  const spectrumCanvas = $('spectrum') as HTMLCanvasElement
  const samplesOut = $('samples') as HTMLOutputElement
  const centroidOut = $('centroid') as HTMLOutputElement
  const rmsOut = $('rms') as HTMLOutputElement
  const peakOut = $('peak') as HTMLOutputElement
  const zcrOut = $('zcr') as HTMLOutputElement
  const rolloffOut = $('rolloff') as HTMLOutputElement
  const responseKind = $('response-kind') as HTMLSelectElement
  const responseFreq = $('response-freq') as HTMLInputElement
  const responseQ = $('response-q') as HTMLInputElement
  const responseGain = $('response-gain') as HTMLInputElement
  const responseFreqValue = $('response-freq-value') as HTMLOutputElement
  const responseQValue = $('response-q-value') as HTMLOutputElement
  const responseGainValue = $('response-gain-value') as HTMLOutputElement
  const responseCode = $('response-code') as HTMLElement
  const responseCanvas = $('response') as HTMLCanvasElement
  const responseMax = $('response-max') as HTMLOutputElement
  const responseMin = $('response-min') as HTMLOutputElement
  const responsePoints = $('response-points') as HTMLOutputElement
  const convSamples = $('conv-samples') as HTMLInputElement
  const convBlock = $('conv-block') as HTMLSelectElement
  const convKernel = $('conv-kernel') as HTMLInputElement
  const convDecay = $('conv-decay') as HTMLInputElement
  const convSamplesValue = $('conv-samples-value') as HTMLOutputElement
  const convKernelValue = $('conv-kernel-value') as HTMLOutputElement
  const convDecayValue = $('conv-decay-value') as HTMLOutputElement
  const convCode = $('conv-code') as HTMLElement
  const convCanvas = $('convolution') as HTMLCanvasElement
  const convBlocks = $('conv-blocks') as HTMLOutputElement
  const convTail = $('conv-tail') as HTMLOutputElement
  const convError = $('conv-error') as HTMLOutputElement
  const windowKind = $('window-kind') as HTMLSelectElement
  const windowSize = $('window-size') as HTMLSelectElement
  const windowFreq = $('window-freq') as HTMLInputElement
  const windowFreqValue = $('window-freq-value') as HTMLOutputElement
  const windowCode = $('window-code') as HTMLElement
  const windowCanvas = $('windowed-fft') as HTMLCanvasElement
  const windowPeak = $('window-peak') as HTMLOutputElement
  const windowCentroid = $('window-centroid') as HTMLOutputElement
  const windowFlatness = $('window-flatness') as HTMLOutputElement
  const firKind = $('fir-kind') as HTMLSelectElement
  const firWindow = $('fir-window') as HTMLSelectElement
  const firFreq = $('fir-freq') as HTMLInputElement
  const firTaps = $('fir-taps') as HTMLInputElement
  const firFreqValue = $('fir-freq-value') as HTMLOutputElement
  const firTapsValue = $('fir-taps-value') as HTMLOutputElement
  const firCode = $('fir-code') as HTMLElement
  const firCanvas = $('fir') as HTMLCanvasElement
  const firHistory = $('fir-history') as HTMLOutputElement
  const firSum = $('fir-sum') as HTMLOutputElement
  const firLatency = $('fir-latency') as HTMLOutputElement
  const resampleMethod = $('resample-method') as HTMLSelectElement
  const resampleRatio = $('resample-ratio') as HTMLInputElement
  const resampleWidth = $('resample-width') as HTMLInputElement
  const resampleRatioValue = $('resample-ratio-value') as HTMLOutputElement
  const resampleWidthValue = $('resample-width-value') as HTMLOutputElement
  const resampleCode = $('resample-code') as HTMLElement
  const resampleCanvas = $('resample') as HTMLCanvasElement
  const resampleInput = $('resample-input') as HTMLOutputElement
  const resampleOutput = $('resample-output') as HTMLOutputElement
  const resamplePeak = $('resample-peak') as HTMLOutputElement
  const analysisSource = $('analysis-source') as HTMLSelectElement
  const analysisAmp = $('analysis-amp') as HTMLInputElement
  const analysisRolloff = $('analysis-rolloff') as HTMLInputElement
  const analysisAmpValue = $('analysis-amp-value') as HTMLOutputElement
  const analysisRolloffValue = $('analysis-rolloff-value') as HTMLOutputElement
  const analysisCode = $('analysis-code') as HTMLElement
  const analysisCanvas = $('analysis') as HTMLCanvasElement
  const analysisCentroid = $('analysis-centroid') as HTMLOutputElement
  const analysisFlatness = $('analysis-flatness') as HTMLOutputElement
  const analysisRolloffOut = $('analysis-rolloff-out') as HTMLOutputElement
  const spectroMode = $('spectro-mode') as HTMLSelectElement
  const spectroWindow = $('spectro-window') as HTMLSelectElement
  const spectroSize = $('spectro-size') as HTMLSelectElement
  const spectroDrive = $('spectro-drive') as HTMLInputElement
  const spectroDriveValue = $('spectro-drive-value') as HTMLOutputElement
  const spectroCode = $('spectro-code') as HTMLElement
  const spectroCanvas = $('spectrogram') as HTMLCanvasElement
  const spectroFrames = $('spectro-frames') as HTMLOutputElement
  const spectroCentroid = $('spectro-centroid') as HTMLOutputElement
  const spectroPeak = $('spectro-peak') as HTMLOutputElement
  const sculptMode = $('sculpt-mode') as HTMLSelectElement
  const sculptCenter = $('sculpt-center') as HTMLInputElement
  const sculptWidth = $('sculpt-width') as HTMLInputElement
  const sculptDepth = $('sculpt-depth') as HTMLInputElement
  const sculptCenterValue = $('sculpt-center-value') as HTMLOutputElement
  const sculptWidthValue = $('sculpt-width-value') as HTMLOutputElement
  const sculptDepthValue = $('sculpt-depth-value') as HTMLOutputElement
  const sculptCode = $('sculpt-code') as HTMLElement
  const sculptCanvas = $('sculpt') as HTMLCanvasElement
  const sculptBefore = $('sculpt-before') as HTMLOutputElement
  const sculptAfter = $('sculpt-after') as HTMLOutputElement
  const sculptChanged = $('sculpt-changed') as HTMLOutputElement
  const envelopeSource = $('envelope-source') as HTMLSelectElement
  const envelopeCutoff = $('envelope-cutoff') as HTMLInputElement
  const envelopeDrive = $('envelope-drive') as HTMLInputElement
  const envelopeCutoffValue = $('envelope-cutoff-value') as HTMLOutputElement
  const envelopeDriveValue = $('envelope-drive-value') as HTMLOutputElement
  const envelopeCode = $('envelope-code') as HTMLElement
  const envelopeCanvas = $('envelope') as HTMLCanvasElement
  const envelopePeak = $('envelope-peak') as HTMLOutputElement
  const envelopeEnvPeak = $('envelope-env-peak') as HTMLOutputElement
  const envelopeState = $('envelope-state') as HTMLOutputElement
  const polyRatio = $('poly-ratio') as HTMLSelectElement
  const polyTaps = $('poly-taps') as HTMLSelectElement
  const polyShape = $('poly-shape') as HTMLSelectElement
  const polyCode = $('poly-code') as HTMLElement
  const polyCanvas = $('polyphase') as HTMLCanvasElement
  const polyRatioOut = $('poly-ratio-out') as HTMLOutputElement
  const polyOutput = $('poly-output') as HTMLOutputElement
  const polyPhases = $('poly-phases') as HTMLOutputElement
  const streamSource = $('stream-source') as HTMLSelectElement
  const streamKind = $('stream-kind') as HTMLSelectElement
  const streamChunk = $('stream-chunk') as HTMLSelectElement
  const streamCutoff = $('stream-cutoff') as HTMLInputElement
  const streamCutoffValue = $('stream-cutoff-value') as HTMLOutputElement
  const streamCode = $('stream-code') as HTMLElement
  const streamCanvas = $('stream') as HTMLCanvasElement
  const streamChunks = $('stream-chunks') as HTMLOutputElement
  const streamError = $('stream-error') as HTMLOutputElement
  const streamState = $('stream-state') as HTMLOutputElement
  const roundtripSource = $('roundtrip-source') as HTMLSelectElement
  const roundtripSize = $('roundtrip-size') as HTMLSelectElement
  const roundtripTrim = $('roundtrip-trim') as HTMLInputElement
  const roundtripTrimValue = $('roundtrip-trim-value') as HTMLOutputElement
  const roundtripCode = $('roundtrip-code') as HTMLElement
  const roundtripCanvas = $('roundtrip') as HTMLCanvasElement
  const roundtripBins = $('roundtrip-bins') as HTMLOutputElement
  const roundtripRms = $('roundtrip-rms') as HTMLOutputElement
  const roundtripError = $('roundtrip-error') as HTMLOutputElement

  let activeSource: SourceKey = 'chord'
  let filterMode: FilterMode = 'lowpass'

  const fmtHz = (hz: number) => hz >= 1000 ? `${(hz / 1000).toFixed(2)} kHz` : `${Math.round(hz)} Hz`
  const fmt = (n: number, digits = 3) => Number.isFinite(n) ? n.toFixed(digits) : String(n)
  const fmtDb = (db: number) => `${db >= 0 ? '+' : ''}${db.toFixed(1)} dB`
  const clamp = (value: number, min: number, max: number) => Math.max(min, Math.min(max, value))
  const setDisabled = (control: HTMLInputElement | HTMLSelectElement, disabled: boolean) => {
    control.disabled = disabled
    control.closest('label')?.toggleAttribute('data-disabled', disabled)
  }

  const makeButton = (key: SourceKey) => {
    const button = document.createElement('button')
    button.type = 'button'
    button.dataset.source = key
    button.setAttribute('role', 'radio')
    button.textContent = sources[key].label
    button.addEventListener('click', () => {
      activeSource = key
      render()
    })
    sourceButtons.append(button)
  }

  for (const key of Object.keys(sources) as SourceKey[]) makeButton(key)

  const makeNoise = (i: number) => {
    const x = Math.sin((i + 1) * 12.9898) * 43758.5453
    return (x - Math.floor(x)) * 2 - 1
  }

  const makeSource = (): Float32Array => {
    const out = new Float32Array(length)
    for (let i = 0; i < out.length; i++) {
      const t = i / sampleRate
      if (activeSource === 'sine') out[i] = Math.sin(2 * Math.PI * 220 * t)
      else if (activeSource === 'chord') {
        out[i] = (
          Math.sin(2 * Math.PI * 220 * t)
          + 0.65 * Math.sin(2 * Math.PI * 330 * t)
          + 0.42 * Math.sin(2 * Math.PI * 495 * t)
        ) / 2.07
      } else if (activeSource === 'impulse') {
        out[i] = i % 128 === 0 ? 1 : 0
      } else {
        out[i] = makeNoise(i) * 0.55
      }
    }
    return out
  }

  const makeKernel = (amount: number): Float32Array => {
    const kernel = new Float32Array(96)
    kernel[0] = 1
    for (let i = 1; i < kernel.length; i++) {
      kernel[i] = amount * Math.exp(-i / 18) * Math.sin(i * 0.58)
    }
    return kernel
  }

  const processSignal = () => {
    const source = makeSource()
    const coeffs = biquad.design({
      kind: filterMode,
      freq: Number(cutoff.value),
      q: Number(resonance.value),
      sampleRate,
    })
    const filtered = new Float32Array(source.length)
    biquad.process(source, coeffs, biquad.state(), filtered)

    const wet = Number(tail.value)
    const convolved = wet > 0
      ? convolve.direct(filtered, makeKernel(wet))
      : filtered
    const trimmed = convolved.subarray(0, source.length)

    const ratioValue = Number(ratio.value)
    const resampled = new Float32Array(resample.outputLength(trimmed.length, ratioValue))
    resample.linear(trimmed, ratioValue, resampled)

    return { source, filtered, output: resampled }
  }

  const drawWaveform = (canvas: HTMLCanvasElement, source: Float32Array, output: Float32Array) => {
    const ctx = canvas.getContext('2d')
    if (!ctx) return
    const width = canvas.width
    const height = canvas.height
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)
    ctx.strokeStyle = 'rgba(134, 239, 172, 0.18)'
    ctx.lineWidth = 1
    ctx.beginPath()
    ctx.moveTo(0, height / 2)
    ctx.lineTo(width, height / 2)
    ctx.stroke()

    const draw = (buf: Float32Array, color: string, widthScale: number) => {
      ctx.strokeStyle = color
      ctx.lineWidth = widthScale
      ctx.beginPath()
      for (let x = 0; x < width; x++) {
        const idx = Math.min(buf.length - 1, Math.floor((x / (width - 1)) * buf.length))
        const y = height / 2 - clamp(buf[idx], -1.2, 1.2) * (height * 0.34)
        if (x === 0) ctx.moveTo(x, y)
        else ctx.lineTo(x, y)
      }
      ctx.stroke()
    }

    draw(source, 'rgba(148, 163, 184, 0.62)', 1.1)
    draw(output, '#34d399', 2)
  }

  const drawSpectrum = (canvas: HTMLCanvasElement, signal: Float32Array) => {
    const ctx = canvas.getContext('2d')
    if (!ctx) return
    const padded = new Float32Array(fftSize)
    padded.set(signal.subarray(0, Math.min(signal.length, fftSize)))
    const w = signalWindow.hann(fftSize)
    signalWindow.apply(padded, w, padded)
    const bins = fft.rfft(padded)
    const magnitudes = new Float32Array(bins.length / 2)
    fft.magnitude(bins, magnitudes)

    const spec = analysis.spectrum(magnitudes, fftSize, sampleRate)
    const centroid = analysis.spectralCentroid(spec)
    const rolloff = analysis.spectralRolloff(spec, 0.85)

    const width = canvas.width
    const height = canvas.height
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)

    let max = 0
    for (let i = 0; i < magnitudes.length; i++) max = Math.max(max, magnitudes[i])
    const usableBins = Math.floor(magnitudes.length * 0.48)
    const barWidth = width / usableBins

    for (let i = 1; i < usableBins; i++) {
      const value = max === 0 ? 0 : magnitudes[i] / max
      const h = Math.pow(value, 0.38) * (height - 22)
      ctx.fillStyle = i % 2 === 0 ? '#22c55e' : '#14b8a6'
      ctx.fillRect(i * barWidth, height - h, Math.max(1, barWidth - 1), h)
    }

    const centroidX = clamp((centroid / (sampleRate / 2)) * width, 0, width)
    ctx.strokeStyle = '#facc15'
    ctx.lineWidth = 2
    ctx.beginPath()
    ctx.moveTo(centroidX, 10)
    ctx.lineTo(centroidX, height - 8)
    ctx.stroke()

    centroidOut.value = `centroid ${fmtHz(centroid)}`
    rolloffOut.value = fmtHz(rolloff)
  }

  const makeLogFreqs = (count: number, min = 20, max = sampleRate / 2): Float32Array => {
    const out = new Float32Array(count)
    const span = Math.log(max / min)
    for (let i = 0; i < out.length; i++) {
      out[i] = min * Math.exp((i / (out.length - 1)) * span)
    }
    return out
  }

  const drawResponseLab = () => {
    const ctx = responseCanvas.getContext('2d')
    if (!ctx) return

    const kind = responseKind.value as ResponseKind
    const freq = Number(responseFreq.value)
    const q = Number(responseQ.value)
    const gainDb = Number(responseGain.value)
    const gainActive = kind === 'peak' || kind === 'lowshelf' || kind === 'highshelf'
    setDisabled(responseGain, !gainActive)
    const coeffs = biquad.design({ kind, freq, q, gainDb, sampleRate })
    const freqs = makeLogFreqs(240)
    const mags = new Float32Array(freqs.length)
    const phases = new Float32Array(freqs.length)
    biquad.freqResponse(coeffs, freqs, sampleRate, mags, phases)

    const width = responseCanvas.width
    const height = responseCanvas.height
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)'
    ctx.lineWidth = 1
    for (let i = 1; i < 4; i++) {
      const y = (height / 4) * i
      ctx.beginPath()
      ctx.moveTo(0, y)
      ctx.lineTo(width, y)
      ctx.stroke()
    }

    let minDb = Infinity
    let maxDb = -Infinity
    const db = new Float32Array(mags.length)
    for (let i = 0; i < mags.length; i++) {
      const value = 20 * Math.log10(Math.max(1e-7, mags[i]))
      db[i] = value
      minDb = Math.min(minDb, value)
      maxDb = Math.max(maxDb, value)
    }

    const dbToY = (value: number) => {
      const clipped = clamp(value, -36, 18)
      return height - ((clipped + 36) / 54) * height
    }

    ctx.strokeStyle = '#facc15'
    ctx.lineWidth = 1.4
    ctx.beginPath()
    for (let i = 0; i < phases.length; i++) {
      const x = (i / (phases.length - 1)) * width
      const y = height / 2 - (phases[i] / Math.PI) * (height * 0.38)
      if (i === 0) ctx.moveTo(x, y)
      else ctx.lineTo(x, y)
    }
    ctx.stroke()

    ctx.strokeStyle = '#34d399'
    ctx.lineWidth = 2.2
    ctx.beginPath()
    for (let i = 0; i < db.length; i++) {
      const x = (i / (db.length - 1)) * width
      const y = dbToY(db[i])
      if (i === 0) ctx.moveTo(x, y)
      else ctx.lineTo(x, y)
    }
    ctx.stroke()

    const freqX = (Math.log(freq / 20) / Math.log((sampleRate / 2) / 20)) * width
    ctx.strokeStyle = 'rgba(52, 211, 153, 0.35)'
    ctx.setLineDash([5, 5])
    ctx.beginPath()
    ctx.moveTo(freqX, 0)
    ctx.lineTo(freqX, height)
    ctx.stroke()
    ctx.setLineDash([])

    responseFreqValue.value = fmtHz(freq)
    responseQValue.value = fmt(q, 2)
    responseGainValue.value = gainActive ? fmtDb(gainDb) : 'n/a'
    responseCode.textContent = gainActive
      ? `biquad.design({ kind: '${kind}', freq: ${Math.round(freq)}, q: ${fmt(q, 2)}, gainDb: ${fmt(gainDb, 1)} })`
      : `biquad.design({ kind: '${kind}', freq: ${Math.round(freq)}, q: ${fmt(q, 2)} })`
    responseMax.value = fmtDb(maxDb)
    responseMin.value = fmtDb(minDb)
    responsePoints.value = String(freqs.length)
  }

  const makeConvSignal = (samples: number): Float32Array => {
    const out = new Float32Array(samples)
    for (let i = 0; i < out.length; i++) {
      const env = Math.exp(-i / 170)
      out[i] = (
        Math.sin(i * 0.15)
        + 0.45 * Math.sin(i * 0.047)
        + (i % 53 === 0 ? 0.9 : 0)
      ) * env * 0.45
    }
    return out
  }

  const makeConvKernel = (kernelLength: number, decay: number): Float32Array => {
    const out = new Float32Array(kernelLength)
    out[0] = 1
    const falloff = Math.max(5, kernelLength * (0.16 + decay * 0.42))
    for (let i = 1; i < out.length; i++) {
      out[i] = decay * Math.exp(-i / falloff) * Math.sin(i * 0.42) * 0.38
    }
    return out
  }

  const runOverlapAdd = (signal: Float32Array, kernel: Float32Array, blockSize: number) => {
    const plan = convolve.plan(kernel, blockSize)
    const state = convolve.state(plan)
    const chunks: Float32Array[] = []
    for (let offset = 0; offset < signal.length; offset += blockSize) {
      const block = new Float32Array(blockSize)
      block.set(signal.subarray(offset, offset + blockSize))
      const out = new Float32Array(blockSize)
      convolve.overlapAdd(block, plan, state, out)
      chunks.push(out)
    }

    const tail = new Float32Array(plan.tailLength)
    convolve.flush(plan, state, tail)
    chunks.push(tail)

    const full = new Float32Array(chunks.reduce((n, chunk) => n + chunk.length, 0))
    let write = 0
    for (const chunk of chunks) {
      full.set(chunk, write)
      write += chunk.length
    }

    return { plan, out: full.subarray(0, signal.length + kernel.length - 1) }
  }

  const drawConvolutionLab = () => {
    const ctx = convCanvas.getContext('2d')
    if (!ctx) return

    const samples = Number(convSamples.value)
    const blockSizeValue = Number(convBlock.value)
    const kernelLength = Number(convKernel.value)
    const decay = Number(convDecay.value)
    const signal = makeConvSignal(samples)
    const kernel = makeConvKernel(kernelLength, decay)
    const direct = convolve.direct(signal, kernel)
    const streamed = runOverlapAdd(signal, kernel, blockSizeValue)

    let maxError = 0
    let maxAmp = 1e-6
    for (let i = 0; i < direct.length; i++) {
      maxError = Math.max(maxError, Math.abs(direct[i] - streamed.out[i]))
      maxAmp = Math.max(maxAmp, Math.abs(direct[i]), Math.abs(streamed.out[i]))
    }

    const width = convCanvas.width
    const height = convCanvas.height
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)

    const tailX = (samples / (direct.length - 1)) * width
    ctx.fillStyle = 'rgba(250, 204, 21, 0.08)'
    ctx.fillRect(tailX, 0, width - tailX, height)
    ctx.strokeStyle = 'rgba(250, 204, 21, 0.45)'
    ctx.lineWidth = 1
    ctx.beginPath()
    ctx.moveTo(tailX, 0)
    ctx.lineTo(tailX, height)
    ctx.stroke()

    ctx.strokeStyle = 'rgba(20, 184, 166, 0.16)'
    ctx.lineWidth = 1
    for (let sample = blockSizeValue; sample < samples; sample += blockSizeValue) {
      const x = (sample / (direct.length - 1)) * width
      ctx.beginPath()
      ctx.moveTo(x, 0)
      ctx.lineTo(x, height)
      ctx.stroke()
    }

    const draw = (buf: Float32Array, color: string, lineWidth: number) => {
      ctx.strokeStyle = color
      ctx.lineWidth = lineWidth
      ctx.beginPath()
      for (let x = 0; x < width; x++) {
        const idx = Math.min(buf.length - 1, Math.floor((x / (width - 1)) * buf.length))
        const y = height / 2 - (buf[idx] / maxAmp) * (height * 0.42)
        if (x === 0) ctx.moveTo(x, y)
        else ctx.lineTo(x, y)
      }
      ctx.stroke()
    }

    draw(direct, 'rgba(148, 163, 184, 0.72)', 1.2)
    draw(streamed.out, '#34d399', 2)

    convSamplesValue.value = String(samples)
    convKernelValue.value = String(kernelLength)
    convDecayValue.value = `${Math.round(decay * 100)}%`
    convCode.textContent = `block=${blockSizeValue}, kernel=${kernelLength}, flush=${streamed.plan.tailLength}`
    convBlocks.value = String(Math.ceil(samples / blockSizeValue))
    convTail.value = String(streamed.plan.tailLength)
    convError.value = maxError < 1e-7 ? '< 1e-7' : maxError.toExponential(1)
  }

  const drawWindowLab = () => {
    const ctx = windowCanvas.getContext('2d')
    if (!ctx) return

    const kind = windowKind.value as WindowChoice
    const size = Number(windowSize.value)
    const freq = Number(windowFreq.value)
    const tone = new Float32Array(size)
    for (let i = 0; i < tone.length; i++) {
      tone[i] = Math.sin((2 * Math.PI * freq * i) / sampleRate)
    }

    const win = signalWindow.create(kind, size)
    const frame = new Float32Array(size)
    signalWindow.apply(tone, win, frame)
    const bins = fft.rfft(frame)
    const magnitudes = new Float32Array(bins.length / 2)
    fft.magnitude(bins, magnitudes)
    const spec = analysis.spectrum(magnitudes, size, sampleRate)
    const centroid = analysis.spectralCentroid(spec)
    const flatness = analysis.spectralFlatness(spec)

    let peakBin = 0
    let maxMag = 0
    for (let i = 1; i < magnitudes.length; i++) {
      if (magnitudes[i] > maxMag) {
        maxMag = magnitudes[i]
        peakBin = i
      }
    }

    const width = windowCanvas.width
    const height = windowCanvas.height
    const topHeight = Math.floor(height * 0.42)
    const bottomTop = topHeight + 16
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)'
    ctx.lineWidth = 1
    ctx.beginPath()
    ctx.moveTo(0, topHeight)
    ctx.lineTo(width, topHeight)
    ctx.stroke()

    ctx.strokeStyle = '#facc15'
    ctx.lineWidth = 2
    ctx.beginPath()
    for (let x = 0; x < width; x++) {
      const idx = Math.min(win.length - 1, Math.floor((x / (width - 1)) * win.length))
      const y = topHeight - win[idx] * (topHeight - 10)
      if (x === 0) ctx.moveTo(x, y)
      else ctx.lineTo(x, y)
    }
    ctx.stroke()

    const usableBins = Math.min(160, magnitudes.length - 1)
    const barWidth = width / usableBins
    for (let i = 1; i <= usableBins; i++) {
      const value = maxMag === 0 ? 0 : magnitudes[i] / maxMag
      const barHeight = Math.pow(value, 0.34) * (height - bottomTop - 8)
      ctx.fillStyle = i === peakBin ? '#facc15' : (i % 2 === 0 ? '#34d399' : '#14b8a6')
      ctx.fillRect((i - 1) * barWidth, height - barHeight, Math.max(1, barWidth - 1), barHeight)
    }

    const peakHz = (peakBin * sampleRate) / size
    windowFreqValue.value = fmtHz(freq)
    windowCode.textContent = `${kind}(${size}) → rfft → ${magnitudes.length} bins`
    windowPeak.value = fmtHz(peakHz)
    windowCentroid.value = fmtHz(centroid)
    windowFlatness.value = fmt(flatness, 3)
  }

  const drawFirLab = () => {
    const ctx = firCanvas.getContext('2d')
    if (!ctx) return

    const kind = firKind.value as FirKind
    const windowKind = firWindow.value as WindowChoice
    const freq = Number(firFreq.value)
    const tapCount = Number(firTaps.value)
    const bandwidth = Math.min(6000, freq * 1.4, (sampleRate / 2 - freq) * 1.4)
    const taps = fir.design({
      kind,
      freq,
      bandwidth: kind === 'bandpass' || kind === 'notch' ? Math.max(40, bandwidth) : undefined,
      sampleRate,
      taps: tapCount,
      window: windowKind,
    })
    const frame = new Float32Array(2048)
    frame.set(taps)
    const bins = fft.rfft(frame)
    const mags = new Float32Array(bins.length / 2)
    fft.magnitude(bins, mags)

    const width = firCanvas.width
    const height = firCanvas.height
    const mid = Math.floor(height * 0.45)
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)'
    ctx.lineWidth = 1
    ctx.beginPath()
    ctx.moveTo(0, mid)
    ctx.lineTo(width, mid)
    ctx.stroke()

    let maxTap = 1e-6
    let sum = 0
    for (const value of taps) {
      maxTap = Math.max(maxTap, Math.abs(value))
      sum += value
    }

    const tapWidth = width / taps.length
    for (let i = 0; i < taps.length; i++) {
      const x = i * tapWidth + tapWidth / 2
      const y = mid - (taps[i] / maxTap) * (mid * 0.78)
      ctx.strokeStyle = taps[i] >= 0 ? '#34d399' : '#facc15'
      ctx.lineWidth = Math.max(1, tapWidth * 0.36)
      ctx.beginPath()
      ctx.moveTo(x, mid)
      ctx.lineTo(x, y)
      ctx.stroke()
    }

    const responseTop = mid + 20
    const responseHeight = height - responseTop - 8
    const cutoffX = (freq / (sampleRate / 2)) * width
    ctx.fillStyle = 'rgba(250, 204, 21, 0.08)'
    ctx.fillRect(Math.max(0, cutoffX - 2), responseTop, 4, responseHeight)
    ctx.strokeStyle = 'rgba(250, 204, 21, 0.46)'
    ctx.lineWidth = 1
    ctx.setLineDash([4, 5])
    ctx.beginPath()
    ctx.moveTo(cutoffX, responseTop)
    ctx.lineTo(cutoffX, responseTop + responseHeight)
    ctx.stroke()
    ctx.setLineDash([])

    ctx.strokeStyle = '#14b8a6'
    ctx.lineWidth = 2
    ctx.beginPath()
    const visibleBins = Math.floor(mags.length * 0.5)
    for (let i = 1; i < visibleBins; i++) {
      const db = 20 * Math.log10(Math.max(1e-7, mags[i]))
      const x = (i / (visibleBins - 1)) * width
      const y = responseTop + (1 - (clamp(db, -72, 6) + 72) / 78) * responseHeight
      if (i === 1) ctx.moveTo(x, y)
      else ctx.lineTo(x, y)
    }
    ctx.stroke()

    firFreqValue.value = fmtHz(freq)
    firTapsValue.value = String(tapCount)
    firCode.textContent = `fir.design({ kind: '${kind}', taps: ${tapCount}, window: '${windowKind}' })`
    firHistory.value = String(taps.length - 1)
    firSum.value = fmt(sum, 4)
    firLatency.value = `${fmt((tapCount - 1) / 2, 1)} samples`
  }

  const makeResampleFixture = (): Float32Array => {
    const out = new Float32Array(96)
    for (let i = 0; i < out.length; i++) {
      const t = i / out.length
      const sweep = Math.sin(2 * Math.PI * (3 + 17 * t) * t)
      const step = i > out.length * 0.52 ? 0.38 : -0.18
      out[i] = 0.58 * sweep + step
    }
    return out
  }

  const drawResampleLab = () => {
    const ctx = resampleCanvas.getContext('2d')
    if (!ctx) return

    const input = makeResampleFixture()
    const method = resampleMethod.value as ResampleMethod
    const ratio = Number(resampleRatio.value)
    const widthValue = Number(resampleWidth.value)
    const usesSinc = method === 'sinc'
    setDisabled(resampleWidth, !usesSinc)
    const out = new Float32Array(resample.outputLength(input.length, ratio))
    if (!usesSinc) resample.linear(input, ratio, out)
    else resample.sinc(input, ratio, { width: widthValue, window: 'hann', out })

    const canvasWidth = resampleCanvas.width
    const canvasHeight = resampleCanvas.height
    ctx.clearRect(0, 0, canvasWidth, canvasHeight)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, canvasWidth, canvasHeight)

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)'
    ctx.lineWidth = 1
    ctx.beginPath()
    ctx.moveTo(0, canvasHeight / 2)
    ctx.lineTo(canvasWidth, canvasHeight / 2)
    ctx.stroke()

    const draw = (buf: Float32Array, color: string, lineWidth: number) => {
      ctx.strokeStyle = color
      ctx.lineWidth = lineWidth
      ctx.beginPath()
      for (let x = 0; x < canvasWidth; x++) {
        const idx = Math.min(buf.length - 1, Math.floor((x / (canvasWidth - 1)) * buf.length))
        const y = canvasHeight / 2 - clamp(buf[idx], -1.2, 1.2) * (canvasHeight * 0.36)
        if (x === 0) ctx.moveTo(x, y)
        else ctx.lineTo(x, y)
      }
      ctx.stroke()
    }

    draw(input, 'rgba(148, 163, 184, 0.68)', 1.2)
    draw(out, '#34d399', 2)

    resampleRatioValue.value = `${fmt(ratio, 2)}x`
    resampleWidthValue.value = usesSinc ? String(widthValue) : 'n/a'
    resampleCode.textContent = method === 'linear'
      ? `resample.linear(input, ${fmt(ratio, 2)}, out)`
      : `resample.sinc(input, ${fmt(ratio, 2)}, { width: ${widthValue}, window: 'hann', out })`
    resampleInput.value = String(input.length)
    resampleOutput.value = String(out.length)
    resamplePeak.value = fmt(analysis.peak(out), 3)
  }

  const makeAnalysisFixture = (kind: AnalysisSource, amp: number): Float32Array => {
    const out = new Float32Array(1024)
    if (kind === 'silence') return out
    for (let i = 0; i < out.length; i++) {
      if (kind === 'tone') out[i] = amp * Math.sin((2 * Math.PI * 880 * i) / sampleRate)
      else if (kind === 'noise') out[i] = amp * makeNoise(i + 99)
      else out[i] = i === 0 ? amp : 0
    }
    return out
  }

  const drawAnalysisLab = () => {
    const ctx = analysisCanvas.getContext('2d')
    if (!ctx) return

    const fixture = analysisSource.value as AnalysisSource
    const amp = Number(analysisAmp.value)
    const percentile = Number(analysisRolloff.value)
    const isSilent = fixture === 'silence'
    setDisabled(analysisAmp, isSilent)
    setDisabled(analysisRolloff, isSilent)
    const frame = makeAnalysisFixture(fixture, amp)
    const win = signalWindow.hann(frame.length)
    const windowed = new Float32Array(frame.length)
    signalWindow.apply(frame, win, windowed)
    const bins = fft.rfft(windowed)
    const mags = new Float32Array(bins.length / 2)
    fft.magnitude(bins, mags)
    const spec = analysis.spectrum(mags, frame.length, sampleRate)
    const centroid = analysis.spectralCentroid(spec)
    const flatness = analysis.spectralFlatness(spec)
    const rolloff = analysis.spectralRolloff(spec, percentile)

    const width = analysisCanvas.width
    const height = analysisCanvas.height
    const topHeight = Math.floor(height * 0.43)
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)'
    ctx.lineWidth = 1
    ctx.beginPath()
    ctx.moveTo(0, topHeight)
    ctx.lineTo(width, topHeight)
    ctx.stroke()

    ctx.strokeStyle = '#34d399'
    ctx.lineWidth = 1.6
    ctx.beginPath()
    for (let x = 0; x < width; x++) {
      const idx = Math.min(frame.length - 1, Math.floor((x / (width - 1)) * frame.length))
      const y = topHeight / 2 - frame[idx] * (topHeight * 0.4)
      if (x === 0) ctx.moveTo(x, y)
      else ctx.lineTo(x, y)
    }
    ctx.stroke()

    let maxMag = 0
    for (const value of mags) maxMag = Math.max(maxMag, value)
    const usableBins = Math.min(180, mags.length - 1)
    const barWidth = width / usableBins
    for (let i = 1; i <= usableBins; i++) {
      const value = maxMag === 0 ? 0 : mags[i] / maxMag
      const barHeight = Math.pow(value, 0.38) * (height - topHeight - 18)
      ctx.fillStyle = maxMag === 0 ? 'rgba(148, 163, 184, 0.18)' : (i % 2 === 0 ? '#14b8a6' : '#34d399')
      ctx.fillRect((i - 1) * barWidth, height - barHeight, Math.max(1, barWidth - 1), barHeight)
    }

    analysisAmpValue.value = isSilent ? 'fixed 0%' : `${Math.round(amp * 100)}%`
    analysisRolloffValue.value = isSilent ? 'n/a' : fmt(percentile, 2)
    analysisCode.textContent = isSilent
      ? 'spectralCentroid(silence) === 0'
      : `analysis.spectralRolloff(spectrum, ${fmt(percentile, 2)})`
    analysisCentroid.value = fmtHz(centroid)
    analysisFlatness.value = fmt(flatness, 3)
    analysisRolloffOut.value = fmtHz(rolloff)
  }

  const heatColor = (value: number) => {
    const v = clamp(value, 0, 1)
    const stops = [
      [0, 7, 17, 15],
      [0.34, 20, 184, 166],
      [0.68, 250, 204, 21],
      [1, 244, 114, 82],
    ] as const
    let lo = stops[0]
    let hi = stops.at(-1)!
    for (let i = 1; i < stops.length; i++) {
      if (v <= stops[i][0]) {
        lo = stops[i - 1]
        hi = stops[i]
        break
      }
    }
    const t = (v - lo[0]) / Math.max(1e-6, hi[0] - lo[0])
    const mix = (a: number, b: number) => Math.round(a + (b - a) * t)
    return `rgb(${mix(lo[1], hi[1])}, ${mix(lo[2], hi[2])}, ${mix(lo[3], hi[3])})`
  }

  const makeSpectrogramSource = (mode: SpectrogramMode, samples: number): Float32Array => {
    const out = new Float32Array(samples)
    let phaseA = 0
    let phaseB = 0
    let phaseC = 0

    for (let i = 0; i < out.length; i++) {
      const t = i / sampleRate
      const n = i / Math.max(1, out.length - 1)
      if (mode === 'chirp') {
        const f1 = 120 * Math.pow(52, n)
        const f2 = 1800 - 1320 * n
        const f3 = 260 + 95 * Math.sin(2 * Math.PI * n * 5)
        phaseA += (2 * Math.PI * f1) / sampleRate
        phaseB += (2 * Math.PI * f2) / sampleRate
        phaseC += (2 * Math.PI * f3) / sampleRate
        const ladder = (Math.floor(n * 9) % 2 === 0 ? 1 : 0.45)
        out[i] = 0.48 * Math.sin(phaseA) + 0.22 * Math.sin(phaseB) + 0.22 * ladder * Math.sin(phaseC)
      } else if (mode === 'voiceprint') {
        const base = 94 + 28 * Math.sin(2 * Math.PI * n * 1.8)
        const f1 = 520 + 430 * Math.sin(2 * Math.PI * n * 0.72)
        const f2 = 1180 + 540 * Math.sin(2 * Math.PI * (n * 0.61 + 0.2))
        const f3 = 2450 + 760 * Math.sin(2 * Math.PI * (n * 0.37 + 0.45))
        let sample = 0
        let weight = 0
        for (let h = 1; h <= 22; h++) {
          const freq = base * h
          const formant =
            Math.exp(-Math.pow(Math.log2(freq / f1), 2) / 0.22)
            + 0.8 * Math.exp(-Math.pow(Math.log2(freq / f2), 2) / 0.16)
            + 0.55 * Math.exp(-Math.pow(Math.log2(freq / f3), 2) / 0.14)
          const amp = formant / h
          sample += amp * Math.sin(2 * Math.PI * freq * t)
          weight += amp
        }
        out[i] = weight > 0 ? (sample / weight) * 0.78 : 0
      } else {
        const beat = i % 640
        const ghost = (i + 240) % 920
        const kick = Math.exp(-beat / 52) * Math.sin((2 * Math.PI * (72 + beat * 3.1) * beat) / sampleRate)
        const tick = ghost < 70 ? Math.exp(-ghost / 16) * makeNoise(i + 77) : 0
        const air = 0.08 * makeNoise(i + Math.floor(n * 800))
        out[i] = 0.85 * kick + 0.34 * tick + air
      }
    }

    return out
  }

  const drawSpectrogramLab = () => {
    const ctx = spectroCanvas.getContext('2d')
    if (!ctx) return

    const mode = spectroMode.value as SpectrogramMode
    const windowKind = spectroWindow.value as WindowChoice
    const fftN = Number(spectroSize.value)
    const drive = Number(spectroDrive.value)
    const source = makeSpectrogramSource(mode, 8192)
    const hop = Math.max(32, Math.floor(fftN / 4))
    const frameCount = Math.floor((source.length - fftN) / hop) + 1
    const rows = 108
    const cells = new Float32Array(frameCount * rows)
    const centroids = new Float32Array(frameCount)
    const win = signalWindow.create(windowKind, fftN)
    const frame = new Float32Array(fftN)
    let globalMax = 0
    let peakBin = 0
    let peakMag = 0
    let centroidSum = 0

    const binForRow = (row: number, maxBin: number) => {
      const highAtTop = 1 - row / Math.max(1, rows - 1)
      return Math.max(1, Math.min(maxBin, Math.round(1 + Math.pow(highAtTop, 2.35) * (maxBin - 1))))
    }

    for (let frameIndex = 0; frameIndex < frameCount; frameIndex++) {
      frame.fill(0)
      frame.set(source.subarray(frameIndex * hop, frameIndex * hop + fftN))
      signalWindow.apply(frame, win, frame)
      const bins = fft.rfft(frame)
      const mags = new Float32Array(bins.length / 2)
      fft.magnitude(bins, mags)
      const spec = analysis.spectrum(mags, fftN, sampleRate)
      const centroid = analysis.spectralCentroid(spec)
      centroids[frameIndex] = centroid
      centroidSum += centroid

      const maxBin = Math.min(mags.length - 1, Math.floor(mags.length * 0.58))
      for (let row = 0; row < rows; row++) {
        const bin = binForRow(row, maxBin)
        const value = mags[bin]
        cells[frameIndex * rows + row] = value
        if (value > globalMax) globalMax = value
        if (value > peakMag) {
          peakMag = value
          peakBin = bin
        }
      }
    }

    const width = spectroCanvas.width
    const height = spectroCanvas.height
    const cellW = width / frameCount
    const cellH = height / rows
    const denom = Math.log1p(globalMax * drive) || 1
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)

    for (let frameIndex = 0; frameIndex < frameCount; frameIndex++) {
      for (let row = 0; row < rows; row++) {
        const raw = cells[frameIndex * rows + row]
        const glow = Math.log1p(raw * drive) / denom
        ctx.fillStyle = heatColor(Math.pow(glow, 0.82))
        ctx.fillRect(frameIndex * cellW, row * cellH, cellW + 0.7, cellH + 0.7)
      }
    }

    ctx.strokeStyle = 'rgba(233, 235, 232, 0.72)'
    ctx.lineWidth = 1.4
    ctx.beginPath()
    const minHz = 45
    const maxHz = sampleRate / 2
    const logSpan = Math.log(maxHz / minHz)
    for (let frameIndex = 0; frameIndex < frameCount; frameIndex++) {
      const x = frameIndex * cellW + cellW / 2
      const normalized = Math.log(Math.max(minHz, centroids[frameIndex]) / minHz) / logSpan
      const y = height - clamp(normalized, 0, 1) * height
      if (frameIndex === 0) ctx.moveTo(x, y)
      else ctx.lineTo(x, y)
    }
    ctx.stroke()

    spectroDriveValue.value = fmt(drive, 1)
    spectroCode.textContent = `${frameCount} frames × ${fftN}-point ${windowKind} FFT`
    spectroFrames.value = String(frameCount)
    spectroCentroid.value = fmtHz(centroidSum / frameCount)
    spectroPeak.value = fmtHz((peakBin * sampleRate) / fftN)
  }

  const makeSculptSource = (): Float32Array => {
    const n = 2048
    const out = new Float32Array(n)
    for (let i = 0; i < out.length; i++) {
      const t = i / sampleRate
      const env = Math.sin(Math.PI * i / (out.length - 1))
      const transient = i < 180 ? Math.exp(-i / 34) * makeNoise(i + 311) * 0.2 : 0
      out[i] = env * (
        0.32 * Math.sin(2 * Math.PI * 185 * t)
        + 0.28 * Math.sin(2 * Math.PI * 370 * t)
        + 0.24 * Math.sin(2 * Math.PI * 740 * t)
        + 0.18 * Math.sin(2 * Math.PI * 1480 * t)
        + 0.12 * Math.sin(2 * Math.PI * 2960 * t)
        + 0.08 * Math.sin(2 * Math.PI * 5920 * t)
      ) + transient
    }
    return out
  }

  const drawSculptLab = () => {
    const ctx = sculptCanvas.getContext('2d')
    if (!ctx) return

    const mode = sculptMode.value as SculptMode
    const center = Number(sculptCenter.value)
    const widthOctaves = Number(sculptWidth.value)
    const depth = Number(sculptDepth.value)
    const input = makeSculptSource()
    const bins = fft.rfft(input)
    const shapedBins = new Float64Array(bins)
    let changed = 0

    for (let k = 0; k < shapedBins.length / 2; k++) {
      const freq = (k * sampleRate) / input.length
      const distance = freq > 0 ? Math.log2(freq / center) : 999
      const band = Math.exp(-(distance * distance) / (2 * widthOctaves * widthOctaves))
      const gain = mode === 'spotlight'
        ? (1 - depth) + depth * band
        : mode === 'notch'
          ? 1 - depth * band
          : 1 + depth * band * 2.4
      if (Math.abs(gain - 1) > 0.05) changed++
      shapedBins[2 * k] *= gain
      shapedBins[2 * k + 1] *= gain
    }

    const output = fft.irfft(shapedBins, input.length)
    const magsBefore = new Float32Array(bins.length / 2)
    const magsAfter = new Float32Array(shapedBins.length / 2)
    fft.magnitude(bins, magsBefore)
    fft.magnitude(shapedBins, magsAfter)
    const specBefore = analysis.spectrum(magsBefore, input.length, sampleRate)
    const specAfter = analysis.spectrum(magsAfter, input.length, sampleRate)
    const centroidBefore = analysis.spectralCentroid(specBefore)
    const centroidAfter = analysis.spectralCentroid(specAfter)

    const width = sculptCanvas.width
    const height = sculptCanvas.height
    const split = Math.floor(height * 0.52)
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)

    let spectrumMax = 1e-7
    for (const value of magsBefore) spectrumMax = Math.max(spectrumMax, value)
    for (const value of magsAfter) spectrumMax = Math.max(spectrumMax, value)
    const xForFreq = (freq: number) => clamp(
      (Math.log(freq / 40) / Math.log((sampleRate / 2) / 40)) * width,
      0,
      width,
    )
    const bandMin = center / Math.pow(2, widthOctaves)
    const bandMax = center * Math.pow(2, widthOctaves)
    const bandX0 = xForFreq(bandMin)
    const bandX1 = xForFreq(bandMax)
    ctx.fillStyle = mode === 'notch' ? 'rgba(244, 114, 182, 0.12)' : 'rgba(52, 211, 153, 0.1)'
    ctx.fillRect(Math.min(bandX0, bandX1), 8, Math.max(2, Math.abs(bandX1 - bandX0)), split - 16)

    const drawSpectrumLine = (mags: Float32Array, color: string, lineWidth: number) => {
      ctx.strokeStyle = color
      ctx.lineWidth = lineWidth
      ctx.beginPath()
      for (let k = 1; k < mags.length * 0.52; k++) {
        const freq = (k * sampleRate) / input.length
        const x = xForFreq(freq)
        const normalized = Math.pow(mags[k] / spectrumMax, 0.38)
        const y = split - 10 - normalized * (split - 24)
        if (k === 1) ctx.moveTo(x, y)
        else ctx.lineTo(x, y)
      }
      ctx.stroke()
    }

    drawSpectrumLine(magsBefore, 'rgba(148, 163, 184, 0.6)', 1.2)
    drawSpectrumLine(magsAfter, '#f472b6', 2.1)

    const centerX = xForFreq(center)
    ctx.strokeStyle = 'rgba(250, 204, 21, 0.72)'
    ctx.setLineDash([5, 5])
    ctx.beginPath()
    ctx.moveTo(centerX, 8)
    ctx.lineTo(centerX, split - 8)
    ctx.stroke()
    ctx.setLineDash([])

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)'
    ctx.lineWidth = 1
    ctx.beginPath()
    ctx.moveTo(0, split)
    ctx.lineTo(width, split)
    ctx.stroke()

    const drawWave = (buf: Float32Array, color: string, lineWidth: number) => {
      ctx.strokeStyle = color
      ctx.lineWidth = lineWidth
      ctx.beginPath()
      for (let x = 0; x < width; x++) {
        const idx = Math.min(buf.length - 1, Math.floor((x / (width - 1)) * buf.length))
        const y = split + (height - split) / 2 - clamp(buf[idx], -1, 1) * ((height - split) * 0.34)
        if (x === 0) ctx.moveTo(x, y)
        else ctx.lineTo(x, y)
      }
      ctx.stroke()
    }

    drawWave(input, 'rgba(148, 163, 184, 0.62)', 1.1)
    drawWave(output, '#34d399', 2)

    sculptCenterValue.value = fmtHz(center)
    sculptWidthValue.value = `${fmt(widthOctaves, 2)} oct`
    sculptDepthValue.value = `${Math.round(depth * 100)}%`
    sculptCode.textContent = `fft.rfft → ${mode} mask @ ${fmtHz(center)} → fft.irfft`
    sculptBefore.value = fmtHz(centroidBefore)
    sculptAfter.value = fmtHz(centroidAfter)
    sculptChanged.value = `${Math.round((changed / (shapedBins.length / 2)) * 100)}% bins`
  }

  const makeEnvelopeFixture = (kind: EnvelopeSource, drive: number): Float32Array => {
    const out = new Float32Array(1024)
    for (let i = 0; i < out.length; i++) {
      const t = i / sampleRate
      if (kind === 'pluck') {
        const env = Math.exp(-i / 260)
        out[i] = drive * env * (
          0.58 * Math.sin(2 * Math.PI * 220 * t)
          + 0.32 * Math.sin(2 * Math.PI * 440 * t)
          + 0.14 * Math.sin(2 * Math.PI * 880 * t)
        )
      } else if (kind === 'drums') {
        const hit = i % 210
        const ghost = (i + 70) % 360
        out[i] = drive * (
          0.82 * Math.exp(-hit / 34) * Math.sin((2 * Math.PI * (68 + hit * 2.8) * hit) / sampleRate)
          + (ghost < 40 ? 0.34 * Math.exp(-ghost / 10) * makeNoise(i + 911) : 0)
        )
      } else {
        const gate = 0.52 + 0.48 * Math.max(0, Math.sin(2 * Math.PI * 5.4 * t))
        const formant = 0.55 * Math.sin(2 * Math.PI * 170 * t)
          + 0.28 * Math.sin(2 * Math.PI * 820 * t)
          + 0.16 * Math.sin(2 * Math.PI * 1420 * t)
        out[i] = drive * gate * formant
      }
    }
    return out
  }

  const drawEnvelopeLab = () => {
    const ctx = envelopeCanvas.getContext('2d')
    if (!ctx) return

    const sourceKind = envelopeSource.value as EnvelopeSource
    const cutoffValue = Number(envelopeCutoff.value)
    const drive = Number(envelopeDrive.value)
    const signal = makeEnvelopeFixture(sourceKind, drive)
    const rectified = new Float32Array(signal.length)
    for (let i = 0; i < signal.length; i++) rectified[i] = Math.min(1, Math.abs(signal[i]))
    const env = new Float32Array(signal.length)
    const state = onepole.state()
    onepole.process(rectified, onepole.lp(cutoffValue, sampleRate), state, env)

    const width = envelopeCanvas.width
    const height = envelopeCanvas.height
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)'
    ctx.lineWidth = 1
    ctx.beginPath()
    ctx.moveTo(0, height / 2)
    ctx.lineTo(width, height / 2)
    ctx.stroke()

    const draw = (buf: Float32Array, color: string, lineWidth: number, bipolar: boolean) => {
      ctx.strokeStyle = color
      ctx.lineWidth = lineWidth
      ctx.beginPath()
      for (let x = 0; x < width; x++) {
        const idx = Math.min(buf.length - 1, Math.floor((x / (width - 1)) * buf.length))
        const y = bipolar
          ? height / 2 - clamp(buf[idx], -1.2, 1.2) * (height * 0.34)
          : height - 18 - clamp(buf[idx], 0, 1.2) * (height * 0.68)
        if (x === 0) ctx.moveTo(x, y)
        else ctx.lineTo(x, y)
      }
      ctx.stroke()
    }

    draw(signal, 'rgba(148, 163, 184, 0.58)', 1.1, true)
    draw(rectified, 'rgba(250, 204, 21, 0.52)', 1.2, false)
    draw(env, '#34d399', 2.4, false)

    envelopeCutoffValue.value = fmtHz(cutoffValue)
    envelopeDriveValue.value = `${fmt(drive, 2)}x`
    envelopeCode.textContent = `onepole.process(abs(${sourceKind}), onepole.lp(${Math.round(cutoffValue)}, sampleRate), state, envelope)`
    envelopePeak.value = fmt(analysis.peak(signal), 3)
    envelopeEnvPeak.value = fmt(analysis.peak(env), 3)
    envelopeState.value = fmt(state[0], 3)
  }

  const parsePolyRatio = (value: PolyRatio): [up: number, down: number] => {
    const [up, down] = value.split('/').map(Number)
    return [up, down]
  }

  const makePolyFixture = (kind: PolyFixture): Float32Array => {
    const out = new Float32Array(48)
    for (let i = 0; i < out.length; i++) {
      if (kind === 'steps') out[i] = i < 12 ? -0.48 : i < 25 ? 0.25 : i < 36 ? 0.78 : -0.12
      else if (kind === 'wave') out[i] = 0.62 * Math.sin(i * 0.31) + 0.18 * Math.sin(i * 0.87)
      else out[i] = i % 12 === 0 ? 0.9 : i % 12 === 1 ? -0.35 : 0
    }
    return out
  }

  const makePolyTaps = (up: number, preset: PolyTapPreset): Float32Array => {
    if (preset === 'hold') {
      const taps = new Float32Array(up)
      taps.fill(1)
      return taps
    }

    const taps = new Float32Array((preset === 'soft' ? 2 : 3) * up)
    for (let phase = 0; phase < up; phase++) {
      if (preset === 'soft') {
        taps[phase] = 0.72
        taps[phase + up] = 0.28
      } else {
        taps[phase] = 0.62
        taps[phase + up] = 0.28
        taps[phase + 2 * up] = 0.1
      }
    }
    return taps
  }

  const drawPolyphaseLab = () => {
    const ctx = polyCanvas.getContext('2d')
    if (!ctx) return

    const ratioValue = polyRatio.value as PolyRatio
    const tapPreset = polyTaps.value as PolyTapPreset
    const fixture = polyShape.value as PolyFixture
    const [up, down] = parsePolyRatio(ratioValue)
    const input = makePolyFixture(fixture)
    const taps = makePolyTaps(up, tapPreset)
    const out = new Float32Array(Math.floor(input.length * up / down))
    resample.polyphase(input, up, down, taps, out)

    const width = polyCanvas.width
    const height = polyCanvas.height
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)'
    ctx.lineWidth = 1
    ctx.beginPath()
    ctx.moveTo(0, height / 2)
    ctx.lineTo(width, height / 2)
    ctx.stroke()

    const drawSeries = (buf: Float32Array, color: string, lineWidth: number, dots: boolean) => {
      ctx.strokeStyle = color
      ctx.lineWidth = lineWidth
      ctx.beginPath()
      for (let i = 0; i < buf.length; i++) {
        const x = (i / Math.max(1, buf.length - 1)) * width
        const y = height / 2 - clamp(buf[i], -1.2, 1.2) * (height * 0.34)
        if (i === 0) ctx.moveTo(x, y)
        else ctx.lineTo(x, y)
      }
      ctx.stroke()

      if (!dots) return
      ctx.fillStyle = color
      const step = Math.max(1, Math.ceil(buf.length / 72))
      for (let i = 0; i < buf.length; i += step) {
        const x = (i / Math.max(1, buf.length - 1)) * width
        const y = height / 2 - clamp(buf[i], -1.2, 1.2) * (height * 0.34)
        ctx.beginPath()
        ctx.arc(x, y, 2.3, 0, Math.PI * 2)
        ctx.fill()
      }
    }

    drawSeries(input, 'rgba(148, 163, 184, 0.62)', 1.25, true)
    drawSeries(out, '#34d399', 2.2, true)

    const sums = new Float32Array(up)
    for (let phase = 0; phase < up; phase++) {
      for (let i = phase; i < taps.length; i += up) sums[phase] += taps[i]
    }

    polyCode.textContent = `resample.polyphase(input, ${up}, ${down}, ${tapPreset}Taps, out)`
    polyRatioOut.value = `${up}:${down}`
    polyOutput.value = String(out.length)
    polyPhases.value = Array.from(sums).map((sum) => fmt(sum, 2)).join(' / ')
  }

  const makeStreamFixture = (kind: StreamSource): Float32Array => {
    const out = new Float32Array(768)
    for (let i = 0; i < out.length; i++) {
      if (kind === 'step') {
        out[i] = i < 180 ? -0.45 : i < 420 ? 0.72 : 0.18
      } else if (kind === 'tone') {
        const burst = i < 120 || i > 620 ? 0.25 : 1
        out[i] = burst * (
          0.52 * Math.sin((2 * Math.PI * 260 * i) / sampleRate)
          + 0.34 * Math.sin((2 * Math.PI * 1640 * i) / sampleRate)
        )
      } else {
        out[i] = 0.5 * makeNoise(i + 171) + 0.18 * Math.sin((2 * Math.PI * 430 * i) / sampleRate)
      }
    }
    return out
  }

  const drawStreamLab = () => {
    const ctx = streamCanvas.getContext('2d')
    if (!ctx) return

    const sourceKind = streamSource.value as StreamSource
    const kind = streamKind.value as FilterMode
    const chunkSize = Number(streamChunk.value)
    const cutoffValue = Number(streamCutoff.value)
    const signal = makeStreamFixture(sourceKind)
    const coeffs = biquad.design({ kind, freq: cutoffValue, q: 0.707, sampleRate })
    const whole = new Float32Array(signal.length)
    biquad.process(signal, coeffs, biquad.state(), whole)

    const chunked = new Float32Array(signal.length)
    const state = biquad.state()
    for (let offset = 0; offset < signal.length; offset += chunkSize) {
      const input = signal.subarray(offset, Math.min(signal.length, offset + chunkSize))
      const output = chunked.subarray(offset, offset + input.length)
      biquad.process(input, coeffs, state, output)
    }

    let maxError = 0
    let maxAmp = 1e-6
    for (let i = 0; i < signal.length; i++) {
      maxError = Math.max(maxError, Math.abs(whole[i] - chunked[i]))
      maxAmp = Math.max(maxAmp, Math.abs(signal[i]), Math.abs(whole[i]), Math.abs(chunked[i]))
    }

    const width = streamCanvas.width
    const height = streamCanvas.height
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)

    ctx.strokeStyle = 'rgba(20, 184, 166, 0.16)'
    ctx.lineWidth = 1
    for (let sample = chunkSize; sample < signal.length; sample += chunkSize) {
      const x = (sample / (signal.length - 1)) * width
      ctx.beginPath()
      ctx.moveTo(x, 0)
      ctx.lineTo(x, height)
      ctx.stroke()
    }

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)'
    ctx.beginPath()
    ctx.moveTo(0, height / 2)
    ctx.lineTo(width, height / 2)
    ctx.stroke()

    const draw = (buf: Float32Array, color: string, lineWidth: number) => {
      ctx.strokeStyle = color
      ctx.lineWidth = lineWidth
      ctx.beginPath()
      for (let x = 0; x < width; x++) {
        const idx = Math.min(buf.length - 1, Math.floor((x / (width - 1)) * buf.length))
        const y = height / 2 - (buf[idx] / maxAmp) * (height * 0.38)
        if (x === 0) ctx.moveTo(x, y)
        else ctx.lineTo(x, y)
      }
      ctx.stroke()
    }

    draw(signal, 'rgba(148, 163, 184, 0.52)', 1.1)
    draw(whole, '#facc15', 1.5)
    draw(chunked, '#34d399', 2.3)

    streamCutoffValue.value = fmtHz(cutoffValue)
    streamCode.textContent = `biquad.process(block, coeffs, sharedState, out) // ${chunkSize}-sample chunks`
    streamChunks.value = String(Math.ceil(signal.length / chunkSize))
    streamError.value = maxError < 1e-7 ? '< 1e-7' : maxError.toExponential(1)
    streamState.value = Array.from(state).map((value) => fmt(value, 2)).join(' / ')
  }

  const makeRoundtripFixture = (kind: RoundtripSource, n: number, taper: number): Float32Array => {
    const out = new Float32Array(n)
    let phase = 0
    for (let i = 0; i < out.length; i++) {
      const t = i / sampleRate
      const env = (1 - taper) + taper * Math.sin((Math.PI * i) / (out.length - 1))
      if (kind === 'tone') {
        out[i] = env * (
          0.52 * Math.sin(2 * Math.PI * 220 * t)
          + 0.28 * Math.sin(2 * Math.PI * 660 * t)
          + 0.16 * Math.sin(2 * Math.PI * 1980 * t)
        )
      } else if (kind === 'chirp') {
        const f = 140 + 4200 * (i / Math.max(1, out.length - 1))
        phase += (2 * Math.PI * f) / sampleRate
        out[i] = env * 0.72 * Math.sin(phase)
      } else {
        out[i] = env * 0.52 * makeNoise(i + 2221)
      }
    }
    return out
  }

  const drawRoundtripLab = () => {
    const ctx = roundtripCanvas.getContext('2d')
    if (!ctx) return

    const sourceKind = roundtripSource.value as RoundtripSource
    const n = Number(roundtripSize.value)
    const taper = Number(roundtripTrim.value)
    const input = makeRoundtripFixture(sourceKind, n, taper)
    const bins = fft.rfft(input)
    const reconstructed = fft.irfft(bins, n)
    const mags = new Float32Array(bins.length / 2)
    fft.magnitude(bins, mags)

    let maxError = 0
    let maxAmp = 1e-6
    let maxMag = 1e-7
    for (let i = 0; i < input.length; i++) {
      maxError = Math.max(maxError, Math.abs(input[i] - reconstructed[i]))
      maxAmp = Math.max(maxAmp, Math.abs(input[i]), Math.abs(reconstructed[i]))
    }
    for (const value of mags) maxMag = Math.max(maxMag, value)

    const width = roundtripCanvas.width
    const height = roundtripCanvas.height
    const split = Math.floor(height * 0.52)
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = '#07110f'
    ctx.fillRect(0, 0, width, height)

    const drawWave = (buf: Float32Array, color: string, lineWidth: number) => {
      ctx.strokeStyle = color
      ctx.lineWidth = lineWidth
      ctx.beginPath()
      for (let x = 0; x < width; x++) {
        const idx = Math.min(buf.length - 1, Math.floor((x / (width - 1)) * buf.length))
        const y = split / 2 - (buf[idx] / maxAmp) * (split * 0.38)
        if (x === 0) ctx.moveTo(x, y)
        else ctx.lineTo(x, y)
      }
      ctx.stroke()
    }

    drawWave(input, 'rgba(148, 163, 184, 0.64)', 1.1)
    drawWave(reconstructed, '#34d399', 2.1)

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)'
    ctx.lineWidth = 1
    ctx.beginPath()
    ctx.moveTo(0, split)
    ctx.lineTo(width, split)
    ctx.stroke()

    const usableBins = Math.min(220, mags.length - 1)
    const barWidth = width / usableBins
    for (let i = 1; i <= usableBins; i++) {
      const value = Math.pow(mags[i] / maxMag, 0.34)
      const barHeight = value * (height - split - 10)
      ctx.fillStyle = i % 2 === 0 ? '#14b8a6' : '#34d399'
      ctx.fillRect((i - 1) * barWidth, height - barHeight, Math.max(1, barWidth - 1), barHeight)
    }

    roundtripTrimValue.value = `${Math.round(taper * 100)}%`
    roundtripCode.textContent = `const bins = fft.rfft(${n} samples); fft.irfft(bins, ${n})`
    roundtripBins.value = String(mags.length)
    roundtripRms.value = fmt(analysis.rms(input), 4)
    roundtripError.value = maxError < 1e-6 ? '< 1e-6' : maxError.toExponential(1)
  }

  const render = () => {
    for (const button of sourceButtons.querySelectorAll<HTMLButtonElement>('button')) {
      const selected = button.dataset.source === activeSource
      button.classList.toggle('is-active', selected)
      button.setAttribute('aria-checked', String(selected))
    }

    cutoffValue.value = fmtHz(Number(cutoff.value))
    resonanceValue.value = fmt(Number(resonance.value), 1)
    tailValue.value = `${Math.round(Number(tail.value) * 100)}%`
    ratioValue.value = `${fmt(Number(ratio.value), 2)}x`
    filterButton.textContent = filterMode === 'lowpass' ? 'Low-pass' : 'High-pass'

    const { source, output } = processSignal()
    const rms = analysis.rms(output)
    const peak = analysis.peak(output)
    const zcr = analysis.zeroCrossings(output)

    pipeline.textContent = `${sources[activeSource].code} → biquad.${filterMode}(${fmtHz(Number(cutoff.value))}) → convolve.direct → resample.linear(${fmt(Number(ratio.value), 2)})`
    samplesOut.value = `${output.length} samples`
    rmsOut.value = fmt(rms, 4)
    peakOut.value = fmt(peak, 4)
    zcrOut.value = String(zcr)

    drawWaveform(waveform, source, output)
    drawSpectrum(spectrumCanvas, output)
  }

  for (const input of [cutoff, resonance, tail, ratio]) input.addEventListener('input', render)
  filterButton.addEventListener('click', () => {
    filterMode = filterMode === 'lowpass' ? 'highpass' : 'lowpass'
    render()
  })
  resetButton.addEventListener('click', () => {
    activeSource = 'chord'
    filterMode = 'lowpass'
    cutoff.value = '1800'
    resonance.value = '0.9'
    tail.value = '0.35'
    ratio.value = '1'
    render()
  })

  for (const input of [responseFreq, responseQ, responseGain]) input.addEventListener('input', drawResponseLab)
  responseKind.addEventListener('change', drawResponseLab)
  for (const input of [convSamples, convKernel, convDecay]) input.addEventListener('input', drawConvolutionLab)
  convBlock.addEventListener('change', drawConvolutionLab)
  windowFreq.addEventListener('input', drawWindowLab)
  for (const input of [windowKind, windowSize]) input.addEventListener('change', drawWindowLab)
  for (const input of [firFreq, firTaps]) input.addEventListener('input', drawFirLab)
  for (const input of [firKind, firWindow]) input.addEventListener('change', drawFirLab)
  for (const input of [resampleRatio, resampleWidth]) input.addEventListener('input', drawResampleLab)
  resampleMethod.addEventListener('change', drawResampleLab)
  for (const input of [analysisAmp, analysisRolloff]) input.addEventListener('input', drawAnalysisLab)
  analysisSource.addEventListener('change', () => {
    if (analysisSource.value === 'silence') analysisAmp.value = '0'
    else if (analysisAmp.value === '0') analysisAmp.value = '0.72'
    drawAnalysisLab()
  })
  spectroDrive.addEventListener('input', drawSpectrogramLab)
  for (const input of [spectroMode, spectroWindow, spectroSize]) input.addEventListener('change', drawSpectrogramLab)
  for (const input of [sculptCenter, sculptWidth, sculptDepth]) input.addEventListener('input', drawSculptLab)
  sculptMode.addEventListener('change', drawSculptLab)
  for (const input of [envelopeCutoff, envelopeDrive]) input.addEventListener('input', drawEnvelopeLab)
  envelopeSource.addEventListener('change', drawEnvelopeLab)
  for (const input of [polyRatio, polyTaps, polyShape]) input.addEventListener('change', drawPolyphaseLab)
  streamCutoff.addEventListener('input', drawStreamLab)
  for (const input of [streamSource, streamKind, streamChunk]) input.addEventListener('change', drawStreamLab)
  roundtripTrim.addEventListener('input', drawRoundtripLab)
  for (const input of [roundtripSource, roundtripSize]) input.addEventListener('change', drawRoundtripLab)

  render()
  drawResponseLab()
  drawConvolutionLab()
  drawWindowLab()
  drawFirLab()
  drawResampleLab()
  drawAnalysisLab()
  drawSpectrogramLab()
  drawSculptLab()
  drawEnvelopeLab()
  drawPolyphaseLab()
  drawStreamLab()
  drawRoundtripLab()
</script>

