<style is:inline>
  .signal-demo {
    --sg-bg: #07110f;
    --sg-panel: color-mix(in srgb, var(--sl-color-gray-6) 78%, #052e2b);
    --sg-border: color-mix(in srgb, var(--sl-color-gray-5) 74%, #22c55e);
    --sg-accent: #34d399;
    --sg-accent-2: #facc15;
    margin: 2rem 0;
    color: var(--sl-color-white);
  }

