    box-sizing: border-box;
  }

  .signal-demo :where(h2, h3, p, code, output, label, span, div, section, article, header) {
    margin-top: 0;
  }

  .sg-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.78fr);
    gap: 1rem;
    align-items: end;
    margin-bottom: 1rem;
  }

  .sg-header h2 {
    margin: 0;
    font-size: 1.4rem;
  }

  .sg-header p {
    margin: 0.3rem 0 0;
    color: var(--sl-color-gray-2);
  }

  .sg-code,
  .sg-panel,
  .sg-readout {
    border: 1px solid var(--sg-border);
    background: var(--sg-panel);
