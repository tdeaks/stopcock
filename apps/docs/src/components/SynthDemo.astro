  .sy-control-knob span {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    color: #a5b1bd;
    white-space: nowrap;
  }

  .sy-control-knob output {
    grid-column: 1;
    grid-row: 3;
    justify-self: start;
    min-width: 0;
    width: 100%;
    max-width: 4.8rem;
    border-color: #1f2a34;
    background: #060a0f;
    color: #d8e3ed;
  }

  .sy-control-knob input[type='range'] {
    grid-column: 2;
    grid-row: 1 / 4;
    align-self: center;
    justify-self: center;
    z-index: 2;
    width: 3.35rem;
    height: 3.35rem;
    margin: 0;
    opacity: 0;
    cursor: ns-resize;
  }

  .sy-control-knob::before,
  .sy-control-knob::after {
    content: '';
    grid-column: 2;
    grid-row: 1 / 4;
    align-self: center;
    justify-self: center;
    pointer-events: none;
  }

  .sy-control-knob::before {
    width: 3.1rem;
    height: 3.1rem;
    border: 1px solid #313d4a;
    border-radius: 50%;
