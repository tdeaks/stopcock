      radial-gradient(circle at 50% 50%, #202833 0 43%, transparent 44%),
      conic-gradient(from -135deg, var(--module-accent) 0 var(--knob-arc), #343f4c var(--knob-arc) 75%, transparent 75% 100%),
      radial-gradient(circle at 38% 30%, #394553, #161d26 66%, #0a0e13 100%);
    box-shadow:
      inset 0 1px 1px color-mix(in srgb, white 10%, transparent),
      0 0.1rem 0.25rem color-mix(in srgb, black 45%, transparent);
  }

  .sy-control-knob::after {
    width: 0.16rem;
    height: 1.16rem;
    border-radius: 999px;
    background: #edf4f9;
    box-shadow: 0 0 0.35rem color-mix(in srgb, var(--module-accent) 50%, transparent);
    transform: rotate(var(--knob-turn)) translateY(-0.62rem);
    transform-origin: 50% 1.16rem;
  }

  .sy-control select,
  .sy-midi-row select {
    border-color: #2a3541;
    background: #0d131a;
    color: #dce5ee;
  }

  .sy-step {
    border-color: #26313d;
    border-radius: 6px;
    background: #0d131a;
  }

  .sy-step::before {
    opacity: 0.72;
