    --knob-arc: 38%;
    --knob-turn: 0deg;
    grid-template-columns: minmax(0, 1fr) 3.35rem;
    grid-template-rows: auto 1fr auto;
    min-height: 4.9rem;
    column-gap: 0.55rem;
    isolation: isolate;
