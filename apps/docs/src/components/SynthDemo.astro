  .sy-header h2,
  .sy-seq-head h3 {
    font-size: 1.08rem;
    font-weight: 760;
  }

  .sy-header p,
  .sy-seq-head p {
    color: var(--sy-muted);
  }

  .sy-graph-pill code {
    color: #b8c7d6;
  }

  .sy-screen,
  .sy-spectrum {
    border: 1px solid #1e2b30;
    border-radius: 8px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--sy-screen) 88%, #15382c 12%), var(--sy-screen));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, white 4%, transparent);
  }

  .sy-controls {
    border-top: 1px solid var(--sy-line);
    background: #0b0e13;
