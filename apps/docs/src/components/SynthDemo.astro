  }

  .sy-rack {
    gap: 0.7rem;
    border: 1px solid #05070a;
    border-radius: 10px;
    padding: 0.75rem;
    background:
      linear-gradient(90deg, #07090c 0 0.55rem, transparent 0.55rem calc(100% - 0.55rem), #07090c calc(100% - 0.55rem)),
      #0d1117;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, white 4%, transparent);
