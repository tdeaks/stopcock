  .sy-control:has(input[type='range']) input[type='range'] {
    grid-column: 1;
    grid-row: 2;
    z-index: 3;
    width: 3.55rem;
    height: 3.55rem;
    margin: 0;
    border: 0;
    border-radius: 50%;
