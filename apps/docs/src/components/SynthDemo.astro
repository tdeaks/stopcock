	    wave = patch.wave
	    steps = patch.pattern.map(cloneStep)
  }

  const renderSegments = () => {
    patchGroup.replaceChildren()
    for (const key of Object.keys(patches) as PatchKey[]) {
      patchGroup.append(makeButton(patches[key].label, activePatch === key, () => {
        activePatch = key
        sourceMode = sourceForPatch(key)
        fmMatrix = matrixForPatch(key)
        syncControls(patches[key])
        renderSegments()
        renderSteps()
        markDirty()
      }))
    }

	    sourceGroup.replaceChildren()
	    const sourceLabels: Record<SourceMode, string> = {
	      classic: 'Analog stack',
	      wavetable: 'Wavetable',
	      fm: 'FM',
	      acid: 'Acid',
	      poly: 'Poly',
	    }
	    for (const candidate of ['classic', 'wavetable', 'fm', 'acid', 'poly'] as SourceMode[]) {
	      sourceGroup.append(makeButton(sourceLabels[candidate], sourceMode === candidate, () => {
	        sourceMode = candidate
	        renderSegments()
	        markDirty()
	      }, candidate))
	    }

    waveGroup.replaceChildren()
    for (const candidate of ['sine', 'saw', 'square', 'triangle'] as Waveform[]) {
      waveGroup.append(makeButton(candidate, wave === candidate, () => {
        wave = candidate
        renderSegments()
        markDirty()
      }))
    }
    renderFmMatrix()
  }

  const renderFmMatrix = () => {
    fmMatrixEl.replaceChildren()
    const corner = document.createElement('span')
    corner.className = 'sy-fm-corner'
    corner.textContent = 'src'
    fmMatrixEl.append(corner)
    for (let destination = 0; destination < 6; destination++) {
      const head = document.createElement('span')
      head.className = 'sy-fm-head'
      head.textContent = `op${destination + 1}`
      fmMatrixEl.append(head)
    }
    for (let source = 0; source < 6; source++) {
      const rowHead = document.createElement('span')
      rowHead.className = 'sy-fm-head'
      rowHead.textContent = `op${source + 1}`
      fmMatrixEl.append(rowHead)
      for (let destination = 0; destination < 6; destination++) {
        const input = document.createElement('input')
        input.type = 'range'
        input.min = '0'
        input.max = '2'
        input.step = '0.05'
        input.value = String(fmMatrix[source][destination] ?? 0)
        input.title = `op${source + 1} -> op${destination + 1}`
        input.ariaLabel = input.title
        input.addEventListener('input', () => {
          fmMatrix[source][destination] = Number(input.value)
          patches[activePatch].fmMatrix = cloneFmMatrix(fmMatrix)
          sourceMode = 'fm'
          for (const button of Array.from(sourceGroup.querySelectorAll('button'))) {
	            const selected = button.dataset.value === 'fm'
            button.classList.toggle('is-active', selected)
            button.setAttribute('aria-checked', String(selected))
          }
          markDirty()
        })
        fmMatrixEl.append(input)
      }
    }
  }

  const renderSteps = () => {
    const n = numeric()
    const perBar = stepsPerBar(n.timeSignature)
    stepsEl.replaceChildren()
    const grid = document.createElement('div')
    grid.className = 'sy-arp-grid'
    grid.style.setProperty('--step-count', String(steps.length))

    const corner = document.createElement('div')
    corner.className = 'sy-arp-corner'
    corner.textContent = 'note'
    grid.append(corner)

    for (let index = 0; index < steps.length; index++) {
      const count = (index % perBar) + 1
      const header = document.createElement('div')
      header.className = [
        'sy-arp-step-head',
        count === 1 ? 'is-bar-start' : '',
        n.timeSignature === '6/8' && count === 4 ? 'is-secondary' : '',
      ].filter(Boolean).join(' ')
      header.textContent = String(count)
      header.title = `Bar ${Math.floor(index / perBar) + 1}, count ${count}`
      grid.append(header)
    }

    for (const lane of arpGridLanes()) {
      const label = document.createElement('div')
      label.className = `sy-arp-lane is-${lane.tone}`
      label.innerHTML = `<b>${lane.label}</b><span>${lane.detail}</span>`
      grid.append(label)

	      for (let index = 0; index < steps.length; index++) {
	        const count = (index % perBar) + 1
	        const step = steps[index]
	        const laneNotes = notesForLane(lane)
	        const active = sameNotes(notesForStep(step), laneNotes)
	        const hasNotes = laneNotes.length > 0
	        const cell = document.createElement('button')
	        cell.type = 'button'
        cell.className = [
          'sy-arp-cell',
          count === 1 ? 'is-bar-start' : '',
          n.timeSignature === '6/8' && count === 4 ? 'is-secondary' : '',
          active ? 'is-active' : '',
          active && step.velocity > 0.76 ? 'is-accent' : '',
          active && step.fx ? 'is-fx-lock' : '',
          `is-${lane.tone}`,
	        ].filter(Boolean).join(' ')
	        cell.style.setProperty('--level', String(step.velocity || 0.18))
	        cell.setAttribute('aria-label', `Step ${index + 1}: ${lane.label} ${active && step.velocity > 0.76 ? 'accent' : ''}${active && step.fx ? ' effect lock' : ''}`)
	        cell.addEventListener('click', (event) => {
	          if (active && hasNotes && event.shiftKey) {
	            step.fx = !step.fx
	          } else if (active && hasNotes) {
	            step.velocity = step.velocity > 0.76 ? 0.5 : 0.96
	          } else {
	            step.midi = lane.midi
	            if (lane.chord && lane.chord.length > 0) {
	              step.chord = [...lane.chord]
	            } else {
	              delete step.chord
	            }
	            step.velocity = hasNotes ? Math.max(step.velocity || 0, clamp(0.52 + ((index * 17) % 42) / 100, 0.46, 0.98)) : 0
	            step.fx = hasNotes && event.shiftKey
	          }
	          if (!hasNotes) {
	            step.fx = false
	            delete step.chord
	          }
	          renderSteps()
	          markDirty()
	        })
	        cell.addEventListener('contextmenu', (event) => {
	          event.preventDefault()
	          step.midi = null
	          step.velocity = 0
	          step.fx = false
	          delete step.chord
	          renderSteps()
	          markDirty()
	        })
        grid.append(cell)
      }
    }

    stepsEl.append(grid)
  }

  const updateReadouts = () => {
    const n = numeric()
    const delayMs = effectiveDelayTime(n)
    values.cutoff.value = `${Math.round(n.cutoff)} Hz`
    values.q.value = fmt(n.q, 1)
    values.hpBase.value = `${Math.round(n.hpBase)} Hz`
    values.hpTop.value = `${Math.round(n.hpTop)} Hz`
    values.drive.value = fmt(n.drive, 2)
    values.delay.value = `${Math.round(n.delay * 100)}%`
    values.delayTime.value = n.delaySync === 'free'
      ? `${Math.round(delayMs)} ms`
      : `${delaySyncLabels[n.delaySync]} · ${Math.round(delayMs)} ms`
    values.delayFeedback.value = `${Math.round(n.delayFeedback * 100)}%`
    values.chorusRate.value = `${fmt(n.chorusRate, 2)} Hz`
