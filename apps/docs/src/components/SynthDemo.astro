    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 12%, transparent),
      inset 0 -1px 0 color-mix(in srgb, black 52%, transparent),
      0 9px 18px color-mix(in srgb, black 24%, transparent);
  }

  .sy-rack-module::before,
  .sy-rack-module::after {
    content: '';
    position: absolute;
    top: 0.35rem;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 35%, #c1c6c9 0 12%, #565e65 28%, #171b1f 62%);
    box-shadow: 0 1px 0 color-mix(in srgb, white 8%, transparent);
  }

  .sy-rack-module::before {
    left: 0.42rem;
  }

  .sy-rack-module::after {
    right: 0.42rem;
  }

  .sy-rack-compact {
    grid-column: span 3;
  }

  .sy-rack-medium {
    grid-column: span 4;
  }

  .sy-rack-large {
    grid-column: span 8;
  }

  .sy-rack-large .sy-grid-controls {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .sy-group {
    display: grid;
    gap: 0.45rem;
  }

  .sy-label {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    justify-self: start;
    min-height: 1.35rem;
    border: 1px solid color-mix(in srgb, var(--sy-line) 72%, black 28%);
    border-radius: 999px;
    background: color-mix(in srgb, black 54%, var(--sy-module) 46%);
    color: var(--sy-ink);
    font-size: 0.68rem;
    padding: 0.18rem 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 720;
  }

  .sy-label::before {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--sy-spectrum-hot);
    box-shadow: 0 0 0.65rem color-mix(in srgb, var(--sy-spectrum-hot) 90%, transparent);
  }

  .sy-segments {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .sy-wave {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .sy-file-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .sy-file-button,
  .sy-file-row button {
    min-height: 2rem;
    border: 1px solid color-mix(in srgb, var(--sy-line) 72%, black 28%);
    border-radius: 6px;
    background: #10161d;
    color: var(--sy-ink);
    font-size: 0.74rem;
    font-weight: 720;
    display: inline-grid;
    place-items: center;
    cursor: pointer;
  }

  .sy-file-button input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .sy-fm-matrix {
    display: grid;
    grid-template-columns: 2.1rem repeat(6, minmax(0, 1fr));
    gap: 0.22rem;
    align-items: center;
    padding: 0.42rem;
    border: 1px solid color-mix(in srgb, var(--sy-line) 72%, black 28%);
    border-radius: 6px;
    background: #090d11;
  }

  .sy-fm-head,
  .sy-fm-corner {
    color: var(--sy-muted);
    font-size: 0.56rem;
    font-weight: 760;
    text-transform: uppercase;
    text-align: center;
  }

  .sy-fm-matrix input[type='range'] {
    inline-size: 100%;
    min-inline-size: 0;
    accent-color: var(--sy-accent);
  }

  .sy-segments button {
    min-height: 2.2rem;
    padding: 0.35rem 0.45rem;
    font-size: 0.78rem;
  }

  .sy-segments button.is-active {
    border-color: var(--sy-accent);
    box-shadow:
      inset 0 -2px 0 var(--sy-accent),
      0 0 0.65rem color-mix(in srgb, var(--sy-accent) 22%, transparent);
  }

  .sy-grid-controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem 0.75rem;
  }

  .sy-control {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 0.5rem;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--sy-line) 72%, #111 28%);
    border-radius: 6px;
    background:
      linear-gradient(180deg, color-mix(in srgb, black 42%, var(--sy-module) 58%), #0e1215);
    padding: 0.45rem;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 7%, transparent),
      inset 0 -1px 0 color-mix(in srgb, black 48%, transparent);
  }

  .sy-control span,
  .sy-control output {
    font-size: 0.76rem;
  }

  .sy-control span {
    color: color-mix(in srgb, var(--sy-muted) 82%, white 18%);
    text-transform: uppercase;
    font-size: 0.64rem;
    letter-spacing: 0.04em;
  }

  .sy-control output {
    min-width: 4.25rem;
    border: 1px solid color-mix(in srgb, var(--sy-scope) 32%, black 68%);
    border-radius: 4px;
    background: color-mix(in srgb, #02100b 78%, black 22%);
    color: var(--sy-scope);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    line-height: 1.5;
    text-align: right;
    padding: 0 0.3rem;
    box-shadow: inset 0 0 0.75rem color-mix(in srgb, black 48%, transparent);
  }

  .sy-control input[type='range'] {
    grid-column: 1 / -1;
    width: 100%;
    accent-color: var(--sy-accent);
    appearance: none;
    height: 1.05rem;
    border-radius: 999px;
    background:
      linear-gradient(180deg, #050607, #20262b 48%, #080a0b);
    border: 1px solid color-mix(in srgb, var(--sy-line) 72%, black 28%);
    padding: 0 0.18rem;
  }

  .sy-control input[type='range']::-webkit-slider-thumb {
    appearance: none;
    width: 1.05rem;
    height: 1.05rem;
    border: 1px solid color-mix(in srgb, white 36%, #20252a 64%);
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 28%, #d4dadf 0 12%, #79838c 28%, #293037 68%);
    box-shadow:
      inset 0 -1px 0 color-mix(in srgb, black 48%, transparent),
      0 0 0.35rem color-mix(in srgb, black 45%, transparent);
  }

  .sy-control input[type='range']::-moz-range-thumb {
    width: 1.05rem;
    height: 1.05rem;
    border: 1px solid color-mix(in srgb, white 36%, #20252a 64%);
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 28%, #d4dadf 0 12%, #79838c 28%, #293037 68%);
    box-shadow:
      inset 0 -1px 0 color-mix(in srgb, black 48%, transparent),
      0 0 0.35rem color-mix(in srgb, black 45%, transparent);
  }

  .sy-control select {
    grid-column: 1 / -1;
    min-height: 2.25rem;
    min-width: 0;
    width: 100%;
    border: 1px solid var(--sy-line);
    border-radius: 6px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--sy-module-high) 44%, #111 56%), #11161a);
    color: var(--sy-ink);
    font: inherit;
    font-size: 0.82rem;
    padding: 0.35rem 0.45rem;
  }

  .sy-mini-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .sy-mini-actions button {
    min-height: 2.25rem;
    border: 1px solid var(--sy-line);
    border-radius: 6px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--sy-module-high) 38%, #10151a 62%), #0e1318);
    color: var(--sy-ink);
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
  }

  .sy-mini-actions button:hover,
  .sy-mini-actions button:focus-visible {
    border-color: var(--sy-accent);
    outline: none;
  }

  .sy-midi-row {
    display: grid;
    grid-template-columns: minmax(7rem, auto) minmax(0, 1fr);
    gap: 0.5rem;
    align-items: center;
  }

  .sy-midi-row select {
    min-height: 2.35rem;
    min-width: 0;
    width: 100%;
    border: 1px solid var(--sy-line);
    border-radius: 6px;
    background: var(--sy-panel-strong);
    color: var(--sy-ink);
    font: inherit;
    font-size: 0.82rem;
    padding: 0 0.55rem;
  }

  .sy-midi-toggle {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--sy-muted);
    font-size: 0.78rem;
  }

  .sy-midi-toggle input {
    accent-color: var(--sy-accent);
  }

  .sy-midi-readout {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .sy-midi-readout b {
    color: var(--sy-ink);
    font-weight: 650;
  }

  .sy-sequencer {
    padding: 1rem;
  }

  .sy-seq-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-bottom: 0.9rem;
  }

  .sy-meter {
    display: flex;
    align-items: flex-end;
    gap: 0.25rem;
    height: 2rem;
  }

  .sy-meter span {
    width: 0.4rem;
    height: calc(var(--v) * 100%);
    border-radius: 3px;
    background: var(--sy-spectrum-hot);
  }

  .sy-meter span:nth-child(2n) {
    background: var(--sy-spectrum);
  }

  .sy-steps {
    display: grid;
    grid-template-columns: repeat(16, minmax(2.6rem, 1fr));
    gap: 0.4rem;
    overflow-x: auto;
    padding-bottom: 0.15rem;
  }

  .sy-step {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    align-items: end;
    min-width: 2.6rem;
    min-height: 4.5rem;
    padding: 0.45rem;
    overflow: hidden;
    min-width: 0;
  }

  .sy-step::before {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: calc(var(--level) * 100%);
    background: color-mix(in srgb, var(--sy-accent) 30%, transparent);
  }

  .sy-step:nth-child(4n + 1)::before {
    background: color-mix(in srgb, var(--sy-spectrum-hot) 35%, transparent);
  }

  .sy-step span,
  .sy-step b {
    position: relative;
    z-index: 1;
  }

  .sy-step span {
    align-self: start;
    color: var(--sy-muted);
    font-size: 0.68rem;
  }

  .sy-step b {
    font-size: 0.82rem;
    font-family: var(--sl-font-mono);
    font-weight: 700;
  }

  .sy-step.is-rest {
    color: var(--sy-muted);
  }

  .sy-step.is-rest::before {
    height: 12%;
    background: color-mix(in srgb, var(--sy-line) 65%, transparent);
  }

  @media (max-width: 58rem) {
    .sy-header,
    .sy-seq-head {
      display: grid;
    }

    .sy-graph-pill {
      max-width: none;
      text-align: left;
    }

    .sy-rack {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .sy-rack-compact,
    .sy-rack-medium {
      grid-column: span 3;
    }

    .sy-rack-large {
      grid-column: 1 / -1;
    }

    .sy-rack-large .sy-grid-controls {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .sy-rack {
      grid-template-columns: 1fr;
    }

    .sy-rack-compact,
    .sy-rack-medium,
    .sy-rack-large {
      grid-column: 1 / -1;
    }

    .sy-grid-controls,
    .sy-rack-large .sy-grid-controls {
      grid-template-columns: 1fr;
    }

    .sy-midi-row {
      grid-template-columns: 1fr;
    }

    .sy-screen {
      min-height: 13rem;
    }

    .sy-spectrum {
      min-height: 6.5rem;
    }
  }

  /* Studio rack finish: sober plugin faceplates, not toy hardware. */
  .sy-demo {
    --sy-ink: #eef4f8;
    --sy-muted: #8f9aa7;
    --sy-panel: #11161d;
    --sy-panel-strong: #1a2029;
    --sy-module: #151a22;
    --sy-module-low: #10141a;
    --sy-module-high: #202733;
    --sy-line: #2b3440;
    --sy-line-hot: #4c5968;
    --sy-screen: #06110e;
    --sy-accent: #7dc8ff;
    --sy-scope: #51e0aa;
    --sy-spectrum: #a898ff;
    --sy-spectrum-hot: #f0c76b;
  }

  .sy-header,
  .sy-shell,
  .sy-sequencer {
    border: 1px solid var(--sy-line);
    border-radius: 10px;
    background: linear-gradient(180deg, #151a22, #10141a);
    box-shadow: none;
  }

  .sy-header {
    border-left: 3px solid var(--sy-accent);
