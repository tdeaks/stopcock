    values.reverbMix.value = `${Math.round(n.reverbMix * 100)}%`
    values.reverbRoom.value = fmt(n.reverbRoom, 2)
    values.reverbDecay.value = `${fmt(n.reverbDecay, 2)} s`
    values.combDelay.value = `${Math.round(n.combDelay)} ms`
    values.combFeedback.value = `${Math.round(n.combFeedback * 100)}%`
    values.combDamp.value = `${Math.round(n.combDamp * 100)}%`
    values.bitcrushBits.value = `${Math.round(n.bitcrushBits)} bit`
    values.bitcrushDownsample.value = `${Math.round(n.bitcrushDownsample)}x`
    values.masterLowCut.value = `${Math.round(n.masterLowCut)} Hz`
    values.masterHighCut.value = `${Math.round(n.masterHighCut)} Hz`
    values.masterLowShelf.value = `${fmt(n.masterLowShelf, 1)} dB`
    values.masterPeakFreq.value = `${Math.round(n.masterPeakFreq)} Hz`
    values.masterPeakGain.value = `${fmt(n.masterPeakGain, 1)} dB`
    values.masterPeakQ.value = fmt(n.masterPeakQ, 1)
    values.masterHighShelf.value = `${fmt(n.masterHighShelf, 1)} dB`
    values.specialFilterFreq.value = `${Math.round(n.specialFilterFreq)} Hz`
    values.specialFilterQ.value = fmt(n.specialFilterQ, 1)
    values.compThreshold.value = `${Math.round(n.compThreshold)} dB`
    values.compRatio.value = `${fmt(n.compRatio, 1)}:1`
    values.compAttack.value = `${Math.round(n.compAttack)} ms`
    values.compRelease.value = `${Math.round(n.compRelease)} ms`
    values.compKnee.value = `${Math.round(n.compKnee)} dB`
    values.pan.value = fmt(n.pan, 2)
    values.outputGain.value = `${Math.round(n.outputGain * 100)}%`
    values.macroBloom.value = `${Math.round(n.macroBloom * 100)}%`
    values.macroMotion.value = `${Math.round(n.macroMotion * 100)}%`
    values.macroDirt.value = `${Math.round(n.macroDirt * 100)}%`
    values.macroSpace.value = `${Math.round(n.macroSpace * 100)}%`
    values.autoRate.value = `${fmt(n.autoRate, 1)} bars`
    values.autoDepth.value = `${Math.round(n.autoDepth * 100)}%`
    values.wetDucking.value = `${Math.round(n.wetDucking * 100)}%`
    values.snapshotMorph.value = `${Math.round(n.snapshotMorph * 100)}%`
    values.outputClip.value = `${Math.round(n.outputClip * 100)}%`
    values.tempo.value = `${Math.round(n.tempo)} bpm`
    values.gate.value = `${Math.round(n.gate * 100)}%`
    values.detune.value = `${Math.round(n.detune)} ct`
    values.noise.value = fmt(n.noise, 2)
    values.bars.value = `${Math.round(n.bars)} x ${n.timeSignature}`
    values.hpMotion.value = `${Math.round(n.hpMotion * 100)}%`
    values.hpRate.value = `${fmt(n.hpRate, 1)}x`
    graphText.textContent = `${n.timeSignature} -> ${n.effectOrder} -> ${n.driveShape}(${fmt(n.drive + n.macroDirt * 0.22, 2)}) -> ${n.delayMode} delay(${delaySyncLabels[n.delaySync]}, ${Math.round(delayMs)}ms) -> bloom ${Math.round(n.macroBloom * 100)}% -> duck ${Math.round(n.wetDucking * 100)}%`
  }

	  const buildVoiceGraph = (): Node => {
	    const n = numeric()
	    if (sourceMode === 'acid') {
	      return pipe(
	        instrument.acidBass({
	          wave: wave === 'square' ? 'square' : 'saw',
	          freq: 110,
	          cutoff: clamp(n.cutoff + n.macroMotion * 420 + (n.autoTarget === 'filter' ? n.autoDepth * 520 : 0), 120, 5200),
	          resonance: clamp(n.q / 8.6, 0.12, 0.98),
	          envMod: clamp(0.58 + n.macroMotion * 0.24 + n.autoDepth * 0.12, 0, 1),
	          decay: clamp(0.07 + n.gate * 0.34, 0.04, 0.62),
	          accent: clamp(0.48 + n.macroDirt * 0.4, 0, 1),
	          slide: clamp(0.08 + n.macroMotion * 0.28, 0, 0.68),
	          drive: clamp(n.drive + n.macroDirt * 0.34, 0, 1),
	          level: 0.92,
	        }),
	        filter.highpass(24, 0.7),
	        filter.peak(760, 1.1, 2.2),
	      )
	    }

	    if (sourceMode === 'poly') {
	      return pipe(
	        instrument.polySynth({
	          freq: 110,
	          detune: n.detune,
	          pulseWidth: clamp(0.46 + n.macroMotion * 0.12, 0.18, 0.82),
	          sub: activePatch === 'tapeEcho' ? 0.16 : 0.28,
	          noise: clamp(n.noise * 0.55, 0, 0.18),
	          cutoff: clamp(n.cutoff + (n.autoTarget === 'filter' ? n.autoDepth * 900 : 0), 180, 9200),
	          resonance: clamp(n.q / 8.5, 0.05, 0.9),
	          envMod: clamp(0.34 + n.macroMotion * 0.24, 0, 1),
	          attack: activePatch === 'tapeEcho' ? 0.012 : 0.006,
	          decay: clamp(0.18 + n.gate * 0.28, 0.05, 0.8),
	          sustain: activePatch === 'tapeEcho' ? 0.42 : 0.32,
	          release: clamp(0.22 + n.delay * 0.72 + n.macroSpace * 0.28, 0.08, 1.4),
	          drive: clamp(n.drive * 0.72 + n.macroDirt * 0.22, 0, 1),
	          chorus: clamp(n.chorusMix + n.macroBloom * 0.18, 0, 1),
	          modulation: clamp(0.08 + n.macroMotion * 0.3, 0, 1),
	          width: 1,
	          level: activePatch === 'tapeEcho' ? 0.52 : 0.62,
	        }),
	        filter.highpass(activePatch === 'tapeEcho' ? 82 : 52, 0.72),
	      )
	    }

	    const layers = activePatch === 'euphoric' && sourceMode === 'classic'
	      ? [
          ...Array.from({ length: euphoricLayerCount }, (_, index) => {
            const spread = euphoricLayerCount === 1 ? 0 : (index / (euphoricLayerCount - 1)) * 2 - 1
            const octaveVoice = index === euphoricLayerCount - 1
            const waveForLayer: Waveform = octaveVoice
              ? 'sine'
              : index % 4 === 0
                ? 'triangle'
                : 'saw'
            const detune = octaveVoice
              ? 1200 + spread * 4
              : spread * Math.max(1, Math.abs(n.detune)) * 1.65 + (index % 2 === 0 ? -1.5 : 1.5)
            const amount = octaveVoice ? 0.08 : waveForLayer === 'triangle' ? 0.12 : 0.075
            return pipe(
              oscillator(waveForLayer, 110, { detune }),
              gain(amount),
              pan(spread * 0.74),
            )
          }),
          pipe(noise('pink', { seed: 1138 }), gain(n.noise)),
        ]
      : sourceMode === 'wavetable'
        ? [
            oscillator.wavetable(importedWavetable ?? glassWavetable, 110, { position: 0.15 }),
            pipe(oscillator.wavetable(importedWavetable ?? glassWavetable, 110, { detune: n.detune, position: 0.55 }), gain(0.48)),
            pipe(noise('pink', { seed: 1138 }), gain(n.noise)),
          ]
        : sourceMode === 'fm'
          ? [
              fm({
                freq: 110,
                index: 1.45 + n.macroMotion * 2.2,
                operators: [
                  operator.sine({ ratio: 1, level: 1, output: 0 }),
                  operator.polyblep('square', { ratio: 2, level: 0.46, output: 1 }),
                  operator.sine({ ratio: 3, level: 0.2, output: 0.18 }),
                ],
                matrix: fmMatrix,
              }),
              pipe(oscillator('sine', 110, { detune: -1200 }), gain(0.18)),
              pipe(noise('pink', { seed: 1138 }), gain(n.noise)),
            ]
          : [
          oscillator(wave, 110),
          pipe(oscillator(wave, 110, { detune: n.detune }), gain(0.62)),
          pipe(noise('pink', { seed: 1138 }), gain(n.noise)),
        ]

    const voice = mix(layers)
    const shaped = pipe(
      voice,
      filter.highpass(activePatch === 'euphoric' ? 145 : 40, 0.7),
      filter.lowpass(n.cutoff, n.q),
      ...(activePatch === 'euphoric' ? [filter.peak(1450, 0.9, 3.2)] : []),
    )

    return pipe(
      shaped,
      envelope({
        attack: activePatch === 'euphoric' ? 0.018 : 0.006,
        decay: activePatch === 'euphoric' ? 0.18 + n.gate * 0.2 : 0.11 + n.gate * 0.18,
        sustain: activePatch === 'euphoric' ? 0.1 + n.gate * 0.24 : 0.18 + n.gate * 0.42,
        release: activePatch === 'euphoric' ? 0.18 + n.delay * 0.36 : 0.08 + n.delay * 0.3,
      }),
    )
  }

  const rackEffects = (): Transform[] => {
    const n = numeric()
    const delayMs = effectiveDelayTime(n)
    const wetScale = clamp(1 - n.wetDucking * 0.36, 0.4, 1)
    const driveAmount = clamp(n.drive + n.macroDirt * 0.22, 0, 0.95)
    const delayMix = clamp(
      (n.delay + n.macroSpace * 0.16 + (n.autoTarget === 'delay' ? n.autoDepth * 0.22 : 0)) * wetScale,
      0,
      0.88,
    )
    const delayFeedback = n.delayMode === 'freeze'
      ? clamp(Math.max(n.delayFeedback, 0.84) + n.macroSpace * 0.04, 0, 0.93)
      : clamp(n.delayFeedback + n.macroSpace * 0.06, 0, 0.9)
    const chorusMix = clamp(
      n.chorusMix + n.macroBloom * 0.1 + (n.autoTarget === 'chorus' ? n.autoDepth * 0.22 : 0),
      0,
      0.92,
    )
    const chorusDepth = clamp(n.chorusDepth + n.macroBloom * 5, 0, 32)
    const reverbMix = clamp((n.reverbMix + n.macroBloom * 0.16 + n.macroSpace * 0.08) * wetScale, 0, 0.5)
    const peakGain = clamp(n.masterPeakGain + (n.autoTarget === 'filter' ? n.autoDepth * 2.4 : 0), -12, 12)
    const outputGain = clamp(n.outputGain * (1 - n.outputClip * 0.12), 0.05, 1.4)
    const pingPongDelay = (mixAmount: number): Transform => (node) => mix([
      pipe(node, gain(clamp(1 - mixAmount * 0.58, 0.28, 1))),
      pipe(node, effects.delay(delayMs, delayFeedback, mixAmount), pan(-0.58), gain(0.72)),
      pipe(node, effects.delay(delayMs * 1.5, delayFeedback * 0.82, mixAmount * 0.86), pan(0.58), gain(0.66)),
    ])

    const eq: Transform[] = [
      filter.highpass(n.masterLowCut, 0.7),
      filter.lowpass(n.masterHighCut, 0.7),
      filter.lowshelf(180, n.masterLowShelf),
      filter.peak(n.masterPeakFreq, n.masterPeakQ, peakGain),
      filter.highshelf(6500, n.masterHighShelf),
    ]

    if (n.specialFilter === 'bandpass') eq.push(filter.bandpass(n.specialFilterFreq, n.specialFilterQ))
    if (n.specialFilter === 'notch') eq.push(filter.notch(n.specialFilterFreq, n.specialFilterQ))
    if (n.specialFilter === 'allpass') eq.push(filter.allpass(n.specialFilterFreq, n.specialFilterQ))

    const dirt: Transform[] = [effects.distortion(driveAmount, n.driveShape)]
    if (n.bitcrushBits < 24 || n.bitcrushDownsample > 1) {
      dirt.push(effects.degrade({
        bits: n.bitcrushBits,
        downsample: n.bitcrushDownsample,
        jitter: 0,
        noise: 0,
        tone: 1,
        mix: 1,
      }))
    }
    if (Math.abs(n.combFeedback) > 0.001) {
      dirt.push(filter.comb(n.combDelay, n.combFeedback, n.combDamp))
    }
    if (n.outputClip > 0.001) {
      dirt.push(effects.distortion(n.outputClip, 'softclip'))
    }

    const delayEffect = n.delayMode === 'space-echo'
      ? effects.spaceEcho({
          timeMs: delayMs,
          feedback: delayFeedback,
          mix: delayMix,
          reverbMix,
          wow: clamp(0.12 + n.macroMotion * 0.42 + n.autoDepth * 0.12, 0, 1),
          flutter: clamp(0.04 + n.macroBloom * 0.18, 0, 1),
          tapeAge: clamp(0.3 + n.macroDirt * 0.48 + n.macroSpace * 0.16, 0, 1),
          drive: driveAmount,
          mode: n.delaySync === '1/16' ? 'heads-1-2' : 'heads-1-2-3',
        })
      : n.delayMode === 'tape'
        ? effects.tapeDelay({
            timeMs: delayMs,
            feedback: delayFeedback,
            mix: delayMix,
            wow: clamp(0.08 + n.macroMotion * 0.32 + n.autoDepth * 0.08, 0, 1),
            flutter: clamp(0.03 + n.macroBloom * 0.14, 0, 1),
            tapeAge: clamp(0.18 + n.macroDirt * 0.5 + n.macroSpace * 0.12, 0, 1),
            drive: driveAmount,
            tone: clamp(0.82 - n.macroDirt * 0.24, 0, 1),
            width: clamp(0.62 + n.macroSpace * 0.36, 0, 1),
          })
      : n.delayMode === 'pingpong' || n.delayMode === 'freeze'
        ? pingPongDelay(delayMix)
        : effects.delay(delayMs, delayFeedback, delayMix)
    const space: Transform[] = [
      effects.ensembleChorus({
        rate: n.chorusRate + n.macroMotion * 0.12,
        depth: chorusDepth,
        mix: chorusMix,
        width: 1,
        tone: 0.84,
        noise: 0.04,
      }),
      delayEffect,
    ]
    if (reverbMix > 0.001 && n.delayMode !== 'space-echo') {
      space.push(effects.plateReverb({
        preDelayMs: clamp(n.reverbRoom * 80, 0, 40),
        decay: clamp(n.reverbDecay + n.macroBloom * 0.34, 0.05, 0.94),
        damping: clamp(0.48 - n.macroBloom * 0.18 + n.macroDirt * 0.12, 0, 1),
        diffusion: clamp(0.64 + n.macroSpace * 0.28, 0, 0.95),
        modulation: clamp(0.08 + n.macroMotion * 0.2, 0, 1),
        mix: reverbMix,
        width: 1,
      }))
    }

    const glue: Transform[] = [
      effects.compressor({
        threshold: n.compThreshold,
        ratio: n.compRatio,
        attack: n.compAttack / 1000,
        release: n.compRelease / 1000,
        knee: n.compKnee,
      }),
      gain(outputGain),
      pan(n.pan),
    ]

    if (n.effectOrder === 'space-first') return [...eq, ...space, ...dirt, ...glue]
    if (n.effectOrder === 'dirty-echo') {
      return [
        ...eq,
        ...dirt,
        delayEffect,
        effects.ensembleChorus({
          rate: n.chorusRate,
          depth: chorusDepth,
          mix: chorusMix,
          width: 1,
          tone: 0.84,
          noise: 0.04,
        }),
        ...glue,
      ]
    }
    return [...eq, ...dirt, ...space, ...glue]
  }

  const buildEffectsGraph = (): Node => pipe(input(0), ...rackEffects())

  const buildGraph = (): Node => pipe(buildVoiceGraph(), ...rackEffects())

  const phraseDuration = () => {
    const n = numeric()
    return stepDuration(n) * steps.length
  }

	  const renderDuration = () => phraseDuration()
	    + (activePatch === 'tapeEcho' || activePatch === 'dub' ? 2.4 : activePatch === 'euphoric' ? 1.25 : activePatch === 'synthwave' || activePatch === 'lofi' ? 1.1 : 0.75)

  const variedMidi = (midi: number, _stepIndex: number, _cycleIndex: number) => {
    return midi
  }

  const triggersFor = (duration: number): Trigger[] => {
    const n = numeric()
	    const stepSec = stepDuration(n)
	    return steps.flatMap((step, stepIndex) => {
	      const notes = notesForStep(step)
	      if (notes.length === 0) return []
	      const atSec = stepIndex * stepSec
	      const fxLift = step.fx ? 1 + n.macroSpace * 0.24 + n.macroBloom * 0.1 : 1
	      const chordScale = notes.length > 1 ? 0.74 : 1
	      return notes.map((midi, noteIndex) => ({
	        midi: variedMidi(midi, stepIndex, noteIndex),
	        velocity: clamp(step.velocity * fxLift * chordScale, 0.25, 1),
	        atSec: atSec + (notes.length > 1 ? noteIndex * 0.004 : 0),
	        gateMs: Math.max(20, stepSec * n.gate * 1000 * (step.fx ? 1.24 : 1) * (notes.length > 1 ? 1.08 : 1)),
	      }))
	    }).filter(trigger => trigger.atSec < duration)
	  }

  const applyHighpassMotion = (samples: Samples, duration: number): Samples => {
    const n = numeric()
    const amount = effectiveHpMotion(n)
    const rate = effectiveHpRate(n)
    if (amount <= 0) return samples
    const process = (input: Float32Array) => {
      const out = new Float32Array(input.length)
      let prevInput = 0
      let prevOutput = 0
      const base = Math.max(20, Math.min(n.hpBase, n.hpTop - 1))
      const top = Math.max(base + 1, n.hpTop)
      const sweep = (top - base) * amount
      for (let i = 0; i < input.length; i++) {
        const t = i / sampleRate
        const phase = (2 * Math.PI * rate * t) / Math.max(0.001, duration)
        const motion = 0.5 - 0.5 * Math.cos(phase)
        const cutoff = base + sweep * motion
        const rc = 1 / (2 * Math.PI * cutoff)
        const alpha = rc / (rc + 1 / sampleRate)
        const y = alpha * (prevOutput + input[i] - prevInput)
        out[i] = y
        prevInput = input[i]
        prevOutput = y
      }
      return out
    }
    return Array.isArray(samples) ? [process(samples[0]), process(samples[1])] : process(samples)
  }

  const addRenderedAt = (target: Samples, source: Samples, offset: number) => {
    if (Array.isArray(target)) {
      const left = Array.isArray(source) ? source[0] : source
      const right = Array.isArray(source) ? source[1] : source
      for (let i = 0; i < left.length && i + offset < target[0].length; i++) {
        target[0][i + offset] += left[i]
        target[1][i + offset] += right[i]
      }
      return
    }

    const monoSource = Array.isArray(source) ? mono(source) : source
    for (let i = 0; i < monoSource.length && i + offset < target.length; i++) {
      target[i + offset] += monoSource[i]
    }
  }

  const renderTriggeredPhrase = (graph: Node, duration: number): Samples => {
    const n = numeric()
    const length = Math.max(0, Math.floor(duration * sampleRate))
    const output: Samples = graph.out === 2
      ? [new Float32Array(length), new Float32Array(length)]
      : new Float32Array(length)
	    const noteTailSec = activePatch === 'tapeEcho' || activePatch === 'dub'
	      ? 1.45 + n.delay * 1.7
	      : activePatch === 'euphoric' || activePatch === 'lofi'
	        ? 1.05 + n.delay * 0.9
	        : activePatch === 'dnb'
	          ? 0.55 + n.delay * 0.4
	          : 0.75 + n.delay * 0.6
    const voiceCache = new Map<string, Samples>()

    for (const trigger of triggersFor(duration)) {
      const start = Math.max(0, Math.floor(trigger.atSec * sampleRate))
      if (start >= length) continue
      const localDuration = Math.min(noteTailSec, duration - trigger.atSec)
      const key = `${trigger.midi ?? trigger.freq}:${trigger.velocity ?? 1}:${trigger.gateMs ?? 0}:${localDuration.toFixed(3)}`
      let voice = voiceCache.get(key)
      if (!voice) {
        voice = render(graph, {
          duration: localDuration,
          sampleRate,
          triggers: [{ ...trigger, atSec: 0 }],
        })
        voiceCache.set(key, voice)
      }
      addRenderedAt(output, voice, start)
    }

    return output
  }

  const renderPhrase = (duration: number): Samples => renderTriggeredPhrase(buildGraph(), duration)

  const renderLiveVoicePhrase = (duration: number): Samples => renderTriggeredPhrase(buildVoiceGraph(), duration)

  const audioBufferFor = (ctx: AudioContext, samples: Samples) => {
    const channels = Array.isArray(samples) ? samples : [samples]
    const buffer = ctx.createBuffer(channels.length, channels[0].length, sampleRate)
    channels.forEach((channel, index) => buffer.copyToChannel(channel as Float32Array<ArrayBuffer>, index))
    return buffer
  }

  const renderSequence = () => {
    if (rendering) return cachedSamples
    rendering = true
    playButton.disabled = true
    renderButton.disabled = true
    exportButton.disabled = true
    setStatus('rendering')
    const duration = renderDuration()
    try {
      const rawSamples = renderPhrase(duration)
      cachedSamples = applyHighpassMotion(rawSamples, duration)
      dirty = false
      setStatus('rendered')
      draw(cachedSamples)
    } finally {
      rendering = false
      playButton.disabled = false
      renderButton.disabled = false
      exportButton.disabled = false
    }
    return cachedSamples
  }

  const mono = (samples: Samples) => {
    if (!Array.isArray(samples)) return samples
    const out = new Float32Array(samples[0].length)
    for (let i = 0; i < out.length; i++) out[i] = (samples[0][i] + samples[1][i]) * 0.5
    return out
  }

  const analyze = (samples: Samples) => {
    const data = mono(samples)
    let sum = 0
    let peak = 0
    for (const sample of data) {
      sum += sample * sample
      peak = Math.max(peak, Math.abs(sample))
    }
    return {
      peak,
      rms: Math.sqrt(sum / Math.max(1, data.length)),
      duration: data.length / sampleRate,
    }
  }

  const setupCanvas = (canvas: HTMLCanvasElement) => {
    const ctx = canvas.getContext('2d')
    if (!ctx) throw new Error('Canvas context unavailable')
    const dpr = Math.max(1, window.devicePixelRatio || 1)
    const rect = canvas.getBoundingClientRect()
    canvas.width = Math.max(1, Math.floor(rect.width * dpr))
    canvas.height = Math.max(1, Math.floor(rect.height * dpr))
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    return { ctx, width: rect.width, height: rect.height }
  }

  const draw = (samples: Samples) => {
    updateReadouts()
    const data = mono(samples)
    const stats = analyze(samples)
    peakOut.textContent = fmt(stats.peak, 3)
    rmsOut.textContent = fmt(stats.rms, 3)
    durationOut.textContent = `${fmt(stats.duration, 2)}s`
    drawScope(data)
    drawSpectrum(data)
  }

  const drawScope = (data: Float32Array, showMarkers = true) => {
    const { ctx, width, height } = setupCanvas(scope)
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = getCss('--sy-screen')
    ctx.fillRect(0, 0, width, height)

    ctx.strokeStyle = getCss('--sy-grid')
    ctx.lineWidth = 1
    for (let i = 1; i < 6; i++) {
      const y = (height / 6) * i
      ctx.beginPath()
      ctx.moveTo(0, y)
      ctx.lineTo(width, y)
      ctx.stroke()
    }

    const step = Math.max(1, Math.floor(data.length / width))
    ctx.beginPath()
    for (let x = 0; x < width; x++) {
      let min = 1
      let max = -1
      const start = x * step
      for (let i = 0; i < step && start + i < data.length; i++) {
        const value = data[start + i]
        min = Math.min(min, value)
        max = Math.max(max, value)
      }
      const y1 = height * (0.5 - max * 0.42)
      const y2 = height * (0.5 - min * 0.42)
      if (x === 0) ctx.moveTo(x, y1)
      ctx.lineTo(x, y1)
      ctx.lineTo(x, y2)
    }
    ctx.strokeStyle = getCss('--sy-scope')
    ctx.lineWidth = 2
    ctx.stroke()

    if (showMarkers) {
      ctx.fillStyle = getCss('--sy-accent-soft')
      const stepSec = stepDuration()
      for (let i = 0; i < steps.length; i++) {
        if (steps[i].midi === null) continue
        const x = (i * stepSec * sampleRate / Math.max(1, data.length)) * width
        ctx.fillRect(x, 0, 2, height)
      }
    }
  }

  const drawSpectrum = (data: Float32Array) => {
    const { ctx, width, height } = setupCanvas(spectrum)
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = getCss('--sy-screen')
    ctx.fillRect(0, 0, width, height)

    const fftSize = 512
    const bins = 52
    const offset = Math.max(0, Math.floor(data.length * 0.18))
    const magnitudes = new Float32Array(bins)
    for (let b = 0; b < bins; b++) {
      const freq = 40 * Math.pow(2, b / 10)
      let re = 0
      let im = 0
      for (let i = 0; i < fftSize; i++) {
        const sample = data[offset + i] ?? 0
        const win = 0.5 - 0.5 * Math.cos(2 * Math.PI * i / (fftSize - 1))
        const phase = 2 * Math.PI * freq * i / sampleRate
        re += sample * win * Math.cos(phase)
        im -= sample * win * Math.sin(phase)
      }
      magnitudes[b] = Math.hypot(re, im) / fftSize
    }

    const max = Math.max(0.00001, ...magnitudes)
    const gap = 2
    const barW = (width - gap * (bins - 1)) / bins
    for (let b = 0; b < bins; b++) {
      const value = Math.log10(1 + (magnitudes[b] / max) * 18) / Math.log10(19)
      const h = value * (height - 18)
      ctx.fillStyle = b % 5 === 0 ? getCss('--sy-spectrum-hot') : getCss('--sy-spectrum')
      ctx.fillRect(b * (barW + gap), height - h, barW, h)
    }
  }

  const drawAnalyserSpectrum = (data: Float32Array) => {
    const { ctx, width, height } = setupCanvas(spectrum)
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = getCss('--sy-screen')
    ctx.fillRect(0, 0, width, height)

    const bins = 58
    const gap = 2
    const barW = (width - gap * (bins - 1)) / bins
    for (let b = 0; b < bins; b++) {
      const start = Math.floor(Math.pow(b / bins, 1.85) * data.length)
      const end = Math.max(start + 1, Math.floor(Math.pow((b + 1) / bins, 1.85) * data.length))
      let sum = 0
      for (let i = start; i < end && i < data.length; i++) sum += data[i]
      const db = sum / Math.max(1, end - start)
      const value = clamp((db + 100) / 78, 0, 1)
      const h = value * (height - 14)
      ctx.fillStyle = b % 6 === 0 ? getCss('--sy-spectrum-hot') : getCss('--sy-spectrum')
      ctx.fillRect(b * (barW + gap), height - h, barW, h)
    }
  }

  const drawLive = () => {
    if (!playing || !liveAnalyser) return
    const timeData = new Float32Array(liveAnalyser.fftSize)
    const freqData = new Float32Array(liveAnalyser.frequencyBinCount)
    liveAnalyser.getFloatTimeDomainData(timeData)
    liveAnalyser.getFloatFrequencyData(freqData)
    const stats = analyze(timeData)
    peakOut.textContent = fmt(stats.peak, 3)
    rmsOut.textContent = fmt(stats.rms, 3)
    durationOut.textContent = 'live'
    updateReadouts()
    drawScope(timeData, false)
    drawAnalyserSpectrum(freqData)
    visualFrame = window.requestAnimationFrame(drawLive)
  }

  const startLiveVisuals = () => {
    if (visualFrame !== undefined) window.cancelAnimationFrame(visualFrame)
    visualFrame = window.requestAnimationFrame(drawLive)
  }

  const stopLiveVisuals = () => {
    if (visualFrame === undefined) return
    window.cancelAnimationFrame(visualFrame)
    visualFrame = undefined
  }

  const ensureAudioOutput = async () => {
    audioCtx ??= new AudioContext({ sampleRate })
    const ctx = audioCtx
    await ctx.resume()
    if (!gainNode) {
      gainNode = ctx.createGain()
      gainNode.gain.value = 0.84
      gainNode.connect(ctx.destination)
    }
    if (!liveBus) {
      liveBus = ctx.createGain()
      liveBus.gain.value = 0.96
    }
    if (!liveAnalyser) {
      liveAnalyser = ctx.createAnalyser()
      liveAnalyser.fftSize = 2048
      liveAnalyser.smoothingTimeConstant = 0.72
      liveAnalyser.minDecibels = -105
      liveAnalyser.maxDecibels = -18
      liveAnalyser.connect(gainNode)
    }
    if (!liveHighpass) {
      liveHighpass = ctx.createBiquadFilter()
      liveHighpass.type = 'highpass'
      liveHighpass.Q.value = 0.72
      liveHighpass.frequency.value = numeric().hpBase
      liveHighpass.connect(liveAnalyser)
    }
    return { ctx, output: gainNode, liveBus, liveHighpass, liveAnalyser }
  }

  const clearSequenceTimers = () => {
    while (sequenceTimers.length > 0) {
      const timer = sequenceTimers.pop()
      if (timer !== undefined) window.clearTimeout(timer)
    }
  }

  const rackSignature = () => {
    const n = numeric()
    return [
      n.driveShape,
      n.drive,
      n.delay,
      n.delaySync,
      effectiveDelayTime(n),
      n.delayFeedback,
      n.chorusRate,
      n.chorusDepth,
      n.chorusMix,
      n.reverbMix,
      n.reverbRoom,
      n.reverbDecay,
      n.combDelay,
      n.combFeedback,
      n.combDamp,
      n.bitcrushBits,
      n.bitcrushDownsample,
      n.masterLowCut,
      n.masterHighCut,
      n.masterLowShelf,
      n.masterPeakFreq,
      n.masterPeakGain,
      n.masterPeakQ,
      n.masterHighShelf,
      n.specialFilter,
      n.specialFilterFreq,
      n.specialFilterQ,
      n.compThreshold,
      n.compRatio,
      n.compAttack,
      n.compRelease,
      n.compKnee,
      n.pan,
      n.outputGain,
      n.macroBloom,
      n.macroMotion,
      n.macroDirt,
      n.macroSpace,
      n.autoTarget,
      n.autoRate,
      n.autoDepth,
      n.delayMode,
      n.wetDucking,
      n.effectOrder,
      n.snapshotMorph,
      n.outputClip,
      n.tempo,
    ].join(':')
  }

  const voiceSignature = () => {
    const n = numeric()
    return [
      activePatch,
      sourceMode,
      wave,
      n.cutoff,
      n.q,
      n.gate,
      n.detune,
      n.noise,
      n.delay,
      fmMatrix.map(row => row.map(value => value.toFixed(2)).join(',')).join(';'),
    ].join(':')
  }

  const motionSignature = () => {
    const n = numeric()
    return [
      activePatch,
      n.hpBase,
      n.hpTop,
      effectiveHpMotion(n),
      effectiveHpRate(n),
    ].join(':')
  }

  const sequenceSignature = () => {
    const n = numeric()
    return [
      activePatch,
      n.timeSignature,
      n.tempo,
      n.gate,
	      steps.map(step => `${notesForStep(step).join('/') || 'x'}:${step.velocity.toFixed(3)}:${step.fx ? 1 : 0}`).join(','),
    ].join(':')
  }

  const scheduleHighpassMotion = (target: BiquadFilterNode, startTime: number, duration: number) => {
    const n = numeric()
    const base = Math.max(20, Math.min(n.hpBase, n.hpTop - 1))
    const top = Math.max(base + 1, n.hpTop)
    const sweep = (top - base) * effectiveHpMotion(n)
    const rate = effectiveHpRate(n)
    target.Q.setValueAtTime(activePatch === 'euphoric' ? 0.82 : 0.65, startTime)
    target.frequency.cancelScheduledValues(startTime)
    if (sweep <= 0.001) {
      target.frequency.setTargetAtTime(base, startTime, 0.02)
      liveMotionSignature = motionSignature()
      return
    }

    const points = 128
    const curve = new Float32Array(points)
    for (let i = 0; i < points; i++) {
      const phase = (2 * Math.PI * rate * i) / Math.max(1, points - 1)
      const motion = 0.5 - 0.5 * Math.cos(phase)
      curve[i] = base + sweep * motion
    }
    target.frequency.setValueCurveAtTime(curve, startTime, Math.max(0.08, duration))
    liveMotionSignature = motionSignature()
  }

  const stopLiveEngine = () => {
    if (liveRebuildTimer !== undefined) {
      window.clearTimeout(liveRebuildTimer)
      liveRebuildTimer = undefined
    }
    liveBuildId++
    try {
      liveBus?.disconnect()
    } catch {
      // Already disconnected.
    }
    liveRack?.stop()
    liveSequenceSource?.stop()
    liveSequenceSource?.disconnect()
    midiLiveVoice?.stop()
    liveRack = null
    liveSequenceSource = null
    midiLiveVoice = null
    liveRackSignature = ''
    liveVoiceSignature = ''
    liveSequenceSignature = ''
    liveMotionSignature = ''
  }

  const rebuildLiveEngine = async () => {
    const engine = await ensureAudioOutput()
    const nextRackSignature = rackSignature()
    const nextVoiceSignature = voiceSignature()
    const needsRack = nextRackSignature !== liveRackSignature || !liveRack
    const needsVoice = nextVoiceSignature !== liveVoiceSignature || !midiLiveVoice
    if (!needsRack && !needsVoice) return engine

    if (needsRack) {
      const buildId = ++liveBuildId
      const effectsGraph = buildEffectsGraph()
      await compileWorklet(engine.ctx, effectsGraph)
      if (buildId !== liveBuildId) return engine

      try {
        engine.liveBus.disconnect()
      } catch {
        // The bus may be new.
      }
      liveRack?.stop()
      liveRack = playGraph(engine.ctx, effectsGraph, { destination: engine.liveHighpass })
      liveRack.connectInput(0, engine.liveBus)
      liveRackSignature = nextRackSignature
    }

    if (needsVoice) {
      liveSequenceSource?.stop()
      liveSequenceSource?.disconnect()
      liveSequenceSource = null
      midiLiveVoice?.stop()
      midiLiveVoice = voice.trigger(buildVoiceGraph()).play(engine.ctx, { destination: engine.liveBus })
      liveVoiceSignature = nextVoiceSignature
      liveSequenceSignature = ''
    }
    return engine
  }

  const scheduleLiveRebuild = () => {
    if (!playing && !liveRack && !midiLiveVoice) return
    if (liveRebuildTimer !== undefined) window.clearTimeout(liveRebuildTimer)
    liveRebuildTimer = window.setTimeout(() => {
      liveRebuildTimer = undefined
      void rebuildLiveEngine()
        .then((engine) => {
          if (!playing) return
          const nextSequenceSignature = sequenceSignature()
          const nextMotionSignature = motionSignature()
          if (nextSequenceSignature !== liveSequenceSignature) {
            scheduleLiveCycle(engine.ctx, engine.liveHighpass, phraseDuration())
            return
          }
          if (nextMotionSignature !== liveMotionSignature) {
            scheduleHighpassMotion(engine.liveHighpass, engine.ctx.currentTime + 0.01, phraseDuration())
          }
        })
        .catch(() => setStatus('worklet unavailable'))
    }, 80)
  }

  const scheduleLiveCycle = (ctx: AudioContext, highpass: BiquadFilterNode, duration: number) => {
    if (!playing || !liveBus) return
    clearSequenceTimers()
    const startAt = ctx.currentTime + 0.02
    const nextSequenceSignature = sequenceSignature()
    if (!liveSequenceSource || nextSequenceSignature !== liveSequenceSignature) {
      liveSequenceSource?.stop()
      liveSequenceSource?.disconnect()
      const source = ctx.createBufferSource()
      source.buffer = audioBufferFor(ctx, renderLiveVoicePhrase(duration))
      source.loop = true
      source.connect(liveBus)
      source.start(startAt)
      liveSequenceSource = source
      liveSequenceSignature = nextSequenceSignature
    }
    scheduleHighpassMotion(highpass, startAt, duration)
    sequenceTimers.push(window.setTimeout(() => {
      scheduleLiveCycle(ctx, highpass, duration)
    }, Math.max(50, duration * 1000)))
  }

  const stop = () => {
    clearSequenceTimers()
    stopLiveVisuals()
    stopLiveEngine()
    playing = false
    playLabel.textContent = 'Play'
    playButton.classList.remove('is-playing')
    draw(cachedSamples)
  }

  const play = async () => {
    if (playing) {
      stop()
      return
    }
    if (renderTimer !== undefined) {
      window.clearTimeout(renderTimer)
      renderTimer = undefined
    }
    const { ctx, liveHighpass } = await ensureAudioOutput()
    try {
      await rebuildLiveEngine()
    } catch {
      setStatus('worklet unavailable')
      stop()
      return
    }
    playing = true
    playLabel.textContent = 'Stop'
    playButton.classList.add('is-playing')
    startLiveVisuals()
    scheduleLiveCycle(ctx, liveHighpass, phraseDuration())
    setStatus('playing worklet')
  }

  const renderCurrent = () => {
    if (renderTimer !== undefined) {
      window.clearTimeout(renderTimer)
      renderTimer = undefined
    }
    renderSequence()
  }

  const releaseMidiNote = (_midi: number) => undefined

  const playMidiNote = async (midi: number, velocity: number) => {
    const { ctx, liveHighpass } = await rebuildLiveEngine()
    const n = numeric()
    const stepSec = stepDuration(n)
    scheduleHighpassMotion(liveHighpass, ctx.currentTime + 0.01, Math.max(0.6, phraseDuration()))
    midiLiveVoice?.trigger({
      midi,
      velocity: Math.round(velocity * 16) / 16,
      gateMs: Math.max(50, stepSec * n.gate * 1000),
    })
  }

  const midiInputs = () => Array.from(midiAccess?.inputs.values() ?? [])

  const refreshMidiInputs = () => {
    const inputs = midiInputs()
    midiInputSelect.replaceChildren()
    if (inputs.length === 0) {
      midiInputSelect.append(new Option('No MIDI input', ''))
      midiInputSelect.disabled = true
      setMidiStatus(midiAccess ? 'no devices' : 'off')
      return
    }

    for (const input of inputs) {
      const label = [input.manufacturer, input.name].filter(Boolean).join(' ') || `MIDI ${input.id}`
      midiInputSelect.append(new Option(label, input.id))
    }
    midiInputSelect.disabled = false
    if (!selectedMidiInput || !inputs.some(input => input.id === selectedMidiInput?.id)) {
      connectMidiInput(inputs[0]?.id ?? '')
    }
  }

  const handleMidiMessage = (event: { data?: Uint8Array | number[] }) => {
    const data = Array.from(event.data ?? [])
    const status = data[0] ?? 0
    const command = status & 0xF0
    const midi = data[1]
    const velocityByte = data[2] ?? 0
    if (midi === undefined) return

    if (command === 0x90 && velocityByte > 0) {
      const velocity = clamp(velocityByte / 127, 0.05, 1)
      midiNoteOut.textContent = `${labelForMidi(midi)} ${velocityByte}`
      setMidiStatus('playing')
      if (midiTrackRoot.checked && activePatch === 'euphoric') setArpRoot(midi)
      void playMidiNote(midi, velocity).catch(() => setMidiStatus('audio blocked'))
      return
    }

    if (command === 0x80 || (command === 0x90 && velocityByte === 0)) {
      releaseMidiNote(midi)
      midiNoteOut.textContent = labelForMidi(midi)
      setMidiStatus('released')
    }
  }

  const connectMidiInput = (id: string) => {
    if (selectedMidiInput) selectedMidiInput.onmidimessage = null
    selectedMidiInput = midiInputs().find(input => input.id === id) ?? null
    if (!selectedMidiInput) {
      setMidiStatus(midiAccess ? 'no input' : 'off')
      return
    }
    selectedMidiInput.onmidimessage = handleMidiMessage
    midiInputSelect.value = selectedMidiInput.id
    setMidiStatus('armed')
  }

  const enableMidi = async () => {
    const requestMIDIAccess = (navigator as Navigator & {
      requestMIDIAccess?: () => Promise<MidiAccessLike>
    }).requestMIDIAccess

    if (!requestMIDIAccess) {
      setMidiStatus('unsupported')
      midiEnableButton.disabled = true
      return
    }

    midiEnableButton.disabled = true
    setMidiStatus('requesting')
    try {
      midiAccess = await requestMIDIAccess.call(navigator)
      midiAccess.onstatechange = refreshMidiInputs
      refreshMidiInputs()
      setMidiStatus(selectedMidiInput ? 'armed' : 'no devices')
      midiEnableButton.textContent = 'MIDI armed'
    } catch {
      setMidiStatus('denied')
      midiEnableButton.disabled = false
    }
  }

  const randomize = () => {
    const n = numeric()
    controls.cutoff.value = String(clamp(n.cutoff * (0.72 + Math.random() * 0.72), 120, 12000))
    controls.q.value = String(clamp(n.q + (Math.random() - 0.5) * 2.8, 0.4, 9))
    controls.hpBase.value = String(clamp(n.hpBase + (Math.random() - 0.5) * 48, 20, Math.min(380, n.hpTop - 20)))
    controls.hpTop.value = String(clamp(n.hpTop * (0.78 + Math.random() * 0.55), Math.max(300, n.hpBase + 80), 4000))
    const shapes: DistortionShape[] = ['tanh', 'softclip', 'hardclip']
    if (Math.random() < 0.18) controls.driveShape.value = shapes[Math.floor(Math.random() * shapes.length)]
    controls.drive.value = String(clamp(n.drive + (Math.random() - 0.5) * 0.28, 0, 0.9))
    controls.delay.value = String(clamp(n.delay + (Math.random() - 0.5) * 0.24, 0, 0.75))
    if (Math.random() < 0.18) {
      const syncs: DelaySync[] = ['1/16', '1/8t', '1/8', '1/8d', '1/4', '1/2', 'free']
      controls.delaySync.value = syncs[Math.floor(Math.random() * syncs.length)]
    }
    controls.delayTime.value = String(clamp(n.delayTime + (Math.random() - 0.5) * 130, 40, 680))
    controls.delayFeedback.value = String(clamp(n.delayFeedback + (Math.random() - 0.5) * 0.2, 0, 0.88))
    controls.chorusRate.value = String(clamp(n.chorusRate + (Math.random() - 0.5) * 0.24, 0.05, 1.8))
    controls.chorusDepth.value = String(clamp(n.chorusDepth + (Math.random() - 0.5) * 4, 0, 24))
    controls.chorusMix.value = String(clamp(n.chorusMix + (Math.random() - 0.5) * 0.18, 0, 0.85))
    controls.compThreshold.value = String(clamp(n.compThreshold + Math.round((Math.random() - 0.5) * 8), -48, -4))
    controls.compRatio.value = String(clamp(n.compRatio + (Math.random() - 0.5) * 1.6, 1, 12))
    controls.compAttack.value = String(clamp(n.compAttack + (Math.random() - 0.5) * 10, 1, 80))
    controls.compRelease.value = String(clamp(n.compRelease + (Math.random() - 0.5) * 90, 30, 700))
    controls.compKnee.value = String(clamp(n.compKnee + Math.round((Math.random() - 0.5) * 8), 0, 40))
    controls.pan.value = String(clamp(n.pan + (Math.random() - 0.5) * 0.28, -1, 1))
    controls.detune.value = String(clamp(n.detune + Math.round((Math.random() - 0.5) * 12), -24, 24))
	    controls.hpMotion.value = String(clamp(n.hpMotion + (Math.random() - 0.5) * 0.28, 0, 1))
	    controls.hpRate.value = String(clamp(Math.round((n.hpRate + (Math.random() - 0.5)) * 2) / 2, 0.5, 4))
	    for (const step of steps) {
	      if (Math.random() < 0.22) {
	        const chordLaneOptions = chordLanesForPatch()
	        if (activePatch !== 'dnb' && Math.random() < 0.24 && chordLaneOptions.length > 0) {
	          const next = chordLaneOptions[Math.floor(Math.random() * chordLaneOptions.length)]
	          step.midi = next.midi
	          step.chord = next.chord ? [...next.chord] : undefined
	          step.velocity = 0.52 + Math.random() * 0.34
	        } else if (activePatch === 'euphoric') {
	          const next = euphoricStepOptions[Math.floor(Math.random() * euphoricStepOptions.length)]
	          step.midi = next.offset === null ? null : arpRootMidi + next.offset
	          step.velocity = next.offset === null ? 0 : 0.5 + Math.random() * 0.46
	          delete step.chord
	        } else {
	          const next = notePool[Math.floor(Math.random() * notePool.length)]
	          step.midi = next
	          step.velocity = next === null ? 0 : 0.42 + Math.random() * 0.58
	          delete step.chord
	        }
	        if (step.midi === null) delete step.chord
	      }
	    }
    renderSteps()
    markDirty()
  }

  const exportWav = () => {
    if (renderTimer !== undefined) {
      window.clearTimeout(renderTimer)
      renderTimer = undefined
    }
    const samples = dirty ? renderSequence() : cachedSamples
    const wav = toWav(samples, { sampleRate })
    const url = URL.createObjectURL(new Blob([wav], { type: 'audio/wav' }))
    const a = document.createElement('a')
    a.href = url
    a.download = `stopcock-synth-${patches[activePatch].label.toLowerCase()}.wav`
    a.click()
    URL.revokeObjectURL(url)
    setStatus('wav')
  }

  const importWavetable = async () => {
    const file = wavetableImport.files?.[0]
    if (!file) return
    try {
      audioCtx ??= new AudioContext({ sampleRate })
      const decoded = await audioCtx.decodeAudioData(await file.arrayBuffer())
      importedWavetable = wavetableFromAudio(decoded, { fundamentalHz: 110, size: 2048 })
      sourceMode = 'wavetable'
      renderSegments()
      markDirty()
      setStatus(`loaded ${file.name}`)
    } catch {
      setStatus('audio import failed')
    } finally {
      wavetableImport.value = ''
    }
  }

  const getCss = (name: string) =>
    getComputedStyle(root).getPropertyValue(name).trim()

  const syncRangeVisual = (input: HTMLInputElement) => {
    if (input.type !== 'range') return
    const control = input.closest('.sy-control') as HTMLElement | null
    if (!control) return
    const min = Number(input.min || 0)
    const max = Number(input.max || 100)
    const value = Number(input.value || 0)
    const pct = max === min ? 0.5 : clamp((value - min) / (max - min), 0, 1)
    control.classList.add('sy-control-knob')
    control.style.setProperty('--knob-fill', `${Math.round(pct * 100)}%`)
    control.style.setProperty('--knob-arc', `${Math.round(pct * 75)}%`)
    control.style.setProperty('--knob-turn', `${Math.round(-135 + pct * 270)}deg`)
    control.setAttribute('aria-valuemin', String(min))
    control.setAttribute('aria-valuemax', String(max))
    control.setAttribute('aria-valuenow', String(value))
  }

  const syncRangeVisuals = () => {
    for (const input of Object.values(controls)) {
      if (input instanceof HTMLInputElement) syncRangeVisual(input)
    }
  }

  const stepDecimals = (step: number) => {
    const text = String(step)
    return text.includes('.') ? text.split('.')[1].length : 0
  }

  const setRangeInputValue = (input: HTMLInputElement, value: number) => {
    const min = Number(input.min || 0)
    const max = Number(input.max || 100)
    const step = Number(input.step || 1) || 1
    const stepped = min + Math.round((clamp(value, min, max) - min) / step) * step
    input.value = String(Number(stepped.toFixed(stepDecimals(step))))
    syncRangeVisual(input)
  }

  type ControlKey = keyof typeof controls
  type Snapshot = Partial<Record<ControlKey, string>>
  const snapshotControlKeys: ControlKey[] = [
    'driveShape',
    'drive',
    'delay',
    'delaySync',
    'delayTime',
    'delayFeedback',
    'chorusRate',
    'chorusDepth',
    'chorusMix',
    'reverbMix',
    'reverbRoom',
    'reverbDecay',
    'combDelay',
    'combFeedback',
    'combDamp',
    'bitcrushBits',
    'bitcrushDownsample',
    'masterLowCut',
    'masterHighCut',
    'masterLowShelf',
    'masterPeakFreq',
    'masterPeakGain',
    'masterPeakQ',
    'masterHighShelf',
    'specialFilter',
    'specialFilterFreq',
    'specialFilterQ',
    'compThreshold',
    'compRatio',
    'compAttack',
    'compRelease',
    'compKnee',
    'pan',
    'outputGain',
    'macroBloom',
    'macroMotion',
    'macroDirt',
    'macroSpace',
    'autoTarget',
    'autoRate',
    'autoDepth',
    'delayMode',
    'wetDucking',
    'effectOrder',
    'outputClip',
  ]
  let snapshotA: Snapshot = {}
  let snapshotB: Snapshot = {}

  const takeRackSnapshot = (): Snapshot =>
    Object.fromEntries(snapshotControlKeys.map(key => [key, controls[key].value])) as Snapshot

  const applySnapshotMorph = () => {
    if (!snapshotA.drive || !snapshotB.drive) return
    const amount = Number(controls.snapshotMorph.value)
    applyingSnapshotMorph = true
    for (const key of snapshotControlKeys) {
      const control = controls[key]
      const a = snapshotA[key]
      const b = snapshotB[key]
      if (a === undefined || b === undefined) continue
      if (control instanceof HTMLInputElement && control.type === 'range') {
        setRangeInputValue(control, Number(a) + (Number(b) - Number(a)) * amount)
      } else {
        control.value = amount < 0.5 ? a : b
      }
    }
    applyingSnapshotMorph = false
    syncRangeVisuals()
    updateReadouts()
    markDirty()
  }

  const handleEditedControl = (input: HTMLInputElement | HTMLSelectElement) => {
    if (input === controls.snapshotMorph && !applyingSnapshotMorph) {
      applySnapshotMorph()
      return
    }
    markDirty()
    if (input === controls.timeSignature) renderSteps()
  }

  const setupKnobControl = (input: HTMLInputElement) => {
    if (input.type !== 'range') return
    const control = input.closest('.sy-control') as HTMLElement | null
    if (!control) return
    control.tabIndex = 0
    control.setAttribute('role', 'slider')
    control.style.touchAction = 'none'
    input.tabIndex = -1

    control.addEventListener('pointerdown', (event) => {
      event.preventDefault()
      control.focus({ preventScroll: true })
      control.setPointerCapture(event.pointerId)
      const min = Number(input.min || 0)
      const max = Number(input.max || 100)
      const range = Math.max(0.000001, max - min)
      const startX = event.clientX
      const startY = event.clientY
      const startValue = Number(input.value || min)
      let moved = false

      const move = (moveEvent: PointerEvent) => {
        const delta = (moveEvent.clientX - startX) - (moveEvent.clientY - startY)
        if (Math.abs(delta) < 1) return
        moved = true
        setRangeInputValue(input, startValue + (delta / 180) * range * (moveEvent.shiftKey ? 0.2 : 1))
        handleEditedControl(input)
      }

      const up = (upEvent: PointerEvent) => {
        control.releasePointerCapture(upEvent.pointerId)
        control.removeEventListener('pointermove', move)
        control.removeEventListener('pointerup', up)
        control.removeEventListener('pointercancel', up)
        if (moved) handleEditedControl(input)
      }

      control.addEventListener('pointermove', move)
      control.addEventListener('pointerup', up)
      control.addEventListener('pointercancel', up)
    })

    control.addEventListener('keydown', (event) => {
      const min = Number(input.min || 0)
      const max = Number(input.max || 100)
      const step = Number(input.step || 1) || 1
      const unit = event.shiftKey ? step * 10 : step
      const current = Number(input.value || min)
      const next = {
        ArrowUp: current + unit,
        ArrowRight: current + unit,
        ArrowDown: current - unit,
        ArrowLeft: current - unit,
        PageUp: current + unit * 10,
        PageDown: current - unit * 10,
        Home: min,
        End: max,
      }[event.key]
      if (next === undefined) return
      event.preventDefault()
      setRangeInputValue(input, next)
      handleEditedControl(input)
    })
  }

  for (const input of Object.values(controls)) {
    if (input instanceof HTMLInputElement) setupKnobControl(input)
    const sync = () => {
      if (input instanceof HTMLInputElement) syncRangeVisual(input)
      handleEditedControl(input)
    }
    input.addEventListener('input', sync)
    input.addEventListener('change', sync)
  }

  playButton.addEventListener('click', () => void play())
  renderButton.addEventListener('click', renderCurrent)
  randomizeButton.addEventListener('click', randomize)
  exportButton.addEventListener('click', exportWav)
  wavetableImport.addEventListener('change', () => void importWavetable())
  wavetableClear.addEventListener('click', () => {
    importedWavetable = null
    sourceMode = 'wavetable'
    renderSegments()
    markDirty()
    setStatus('default table')
  })
  snapshotAButton.addEventListener('click', () => {
    snapshotA = takeRackSnapshot()
    setStatus('snapshot A')
  })
  snapshotBButton.addEventListener('click', () => {
    snapshotB = takeRackSnapshot()
    setStatus('snapshot B')
  })
  midiEnableButton.addEventListener('click', () => void enableMidi())
  midiInputSelect.addEventListener('change', () => connectMidiInput(midiInputSelect.value))
  window.addEventListener('resize', () => draw(cachedSamples))

  syncControls(patches[activePatch])
  snapshotA = takeRackSnapshot()
  snapshotB = {
    ...snapshotA,
    delay: '0.7',
    delayFeedback: '0.72',
    chorusMix: '0.66',
    reverbMix: '0.08',
    macroBloom: '0.42',
    macroSpace: '0.46',
    autoDepth: '0.3',
    delayMode: 'space-echo',
    wetDucking: '0.38',
    outputClip: '0.08',
  }
  syncRangeVisuals()
  renderSegments()
  renderSteps()
  updateReadouts()
  setStatus('ready')
  if (!('requestMIDIAccess' in navigator)) {
    setMidiStatus('unsupported')
    midiEnableButton.disabled = true
  }
  cachedSamples = new Float32Array(Math.floor(sampleRate * 0.6))
  draw(cachedSamples)
  markDirty(-1)
</script>

