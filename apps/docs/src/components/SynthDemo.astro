  /* User-directed layout: wide instrument, stacked modules, clearer arp editor. */
  .sy-demo {
    position: relative;
    left: 50%;
    width: min(calc(100vw - 5rem), 76rem);
    max-width: none;
    transform: translateX(-50%);
  }

  .sy-shell,
  .sy-sequencer,
  .sy-header {
    width: 100%;
  }

  .sy-rack {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) !important;
    align-items: stretch;
    gap: 0.85rem;
  }

  .sy-rack-module,
  .sy-rack-compact,
  .sy-rack-medium,
  .sy-rack-large {
    width: 100%;
    flex: none;
    grid-column: 1 / -1 !important;
