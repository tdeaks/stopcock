  .sy-rack-module:nth-child(1) { --module-accent: #8fc7ff; }
  .sy-rack-module:nth-child(2) { --module-accent: #f0c76b; }
	  .sy-rack-module:nth-child(3) { --module-accent: #51e0aa; }
	  .sy-rack-module:nth-child(4) { --module-accent: #ff9f7b; }
	  .sy-rack-module:nth-child(5) { --module-accent: #a898ff; }
	  .sy-rack-module:nth-child(6) { --module-accent: #8dd6f8; }
	  .sy-rack-module:nth-child(7) { --module-accent: #d7b3ff; }
	  .sy-rack-module:nth-child(8) { --module-accent: #90e0cf; }
	  .sy-rack-module:nth-child(9) { --module-accent: #ffd37a; }
	  .sy-rack-module:nth-child(10) { --module-accent: #9dc6ff; }

  .sy-rack-module::before {
    content: '';
    display: block;
    position: absolute;
    inset: 0 0 auto;
    width: auto;
    height: 3px;
    border-radius: 0;
