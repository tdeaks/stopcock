	          velocity: step.velocity,
	          fx: step.fx,
	          ...(step.chord && step.chord.length > 0
	            ? { chord: step.chord.map(note => arpRootMidi + (note - previousRoot)) }
	            : {}),
	        }))
	      : euphoricPatternFor(arpRootMidi)
	    if (activePatch === 'euphoric') {
	      steps = patches.euphoric.pattern.map(cloneStep)
      renderSteps()
      if (renderNow) markDirty()
    }
  }

  const markDirty = (delay = 160) => {
    dirty = true
    setStatus(delay < 0 ? 'ready' : 'edited')
    const stepCountChanged = syncStepCountToBars()
    syncRangeVisuals()
    updateReadouts()
    if (stepCountChanged) renderSteps()
    if (renderTimer !== undefined) window.clearTimeout(renderTimer)
    renderTimer = undefined
    scheduleLiveRebuild()
  }

	  const makeButton = (text: string, selected: boolean, onClick: () => void, value = text) => {
	    const button = document.createElement('button')
	    button.type = 'button'
	    button.textContent = text
	    button.dataset.value = value
	    button.setAttribute('role', 'radio')
    button.setAttribute('aria-checked', String(selected))
    button.className = selected ? 'is-active' : ''
    button.addEventListener('click', onClick)
    return button
  }

