  /* Reliable interaction layer: custom knobs and actual note selectors. */
  .sy-control:has(input[type='range']) input[type='range'] {
    pointer-events: none;
  }

  .sy-control:has(input[type='range']):focus-visible {
    outline: 2px solid var(--module-accent);
