  /* Rack rewrite: compact plugin modules with one real control layout. */
  .sy-rack {
    display: flex !important;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .sy-rack-module,
  .sy-rack-compact,
  .sy-rack-medium,
  .sy-rack-large {
