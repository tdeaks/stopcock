---
const id = 'synth-demo'
---

<div class="sy-demo not-content" id={id} data-synth-demo>
  <div class="sy-header">
    <div>
	      <h2>Rust synth rack</h2>
	      <p>Trance arps, tape echo chords, DnB Reese, lo-fi keys, dub skanks. Live worklet effects.</p>
    </div>
    <div class="sy-graph-pill" aria-live="polite">
      <span>signal</span>
      <code id={`${id}-graph`}></code>
    </div>
  </div>

  <div class="sy-shell">
    <section class="sy-stage" aria-label="Synth visualizer">
      <div class="sy-screen">
        <canvas id={`${id}-scope`} width="980" height="320"></canvas>
        <div class="sy-screen-readout">
          <span><b id={`${id}-peak`}></b> peak</span>
          <span><b id={`${id}-rms`}></b> rms</span>
          <span><b id={`${id}-duration`}></b> loop</span>
        </div>
      </div>

      <div class="sy-spectrum">
        <canvas id={`${id}-spectrum`} width="980" height="180"></canvas>
      </div>

      <div class="sy-transport">
        <button type="button" class="sy-primary" id={`${id}-play`}>
          <span class="sy-button-icon" aria-hidden="true"></span>
          <span id={`${id}-play-label`}>Play</span>
        </button>
        <button type="button" id={`${id}-render`}>Render</button>
        <button type="button" id={`${id}-randomize`}>Variation</button>
        <button type="button" id={`${id}-export`}>WAV</button>
        <output id={`${id}-status`} aria-live="polite"></output>
      </div>
    </section>

    <section class="sy-panel sy-controls" aria-label="Synth rack">
      <div class="sy-rack">
        <section class="sy-rack-module sy-rack-compact" aria-label="Preset module">
          <span class="sy-label">Preset</span>
          <div class="sy-segments" id={`${id}-patches`} role="radiogroup" aria-label="Patch"></div>
        </section>

	        <section class="sy-rack-module sy-rack-compact" aria-label="Voice module">
	          <span class="sy-label">Voice</span>
          <div class="sy-group">
            <div class="sy-segments" id={`${id}-sources`} role="radiogroup" aria-label="Source"></div>
            <div class="sy-segments sy-wave" id={`${id}-waves`} role="radiogroup" aria-label="Waveform"></div>
            <div class="sy-file-row">
              <label class="sy-file-button" for={`${id}-wavetable-import`}>
                Import audio
                <input id={`${id}-wavetable-import`} type="file" accept="audio/*" />
              </label>
              <button type="button" id={`${id}-wavetable-clear`}>Clear table</button>
            </div>
            <div class="sy-fm-matrix" id={`${id}-fm-matrix`} aria-label="FM modulation matrix"></div>
          </div>
          <div class="sy-grid-controls">
            <label class="sy-control" for={`${id}-detune`}>
	              <span>Tune spread</span>
              <output id={`${id}-detune-value`}></output>
              <input id={`${id}-detune`} type="range" min="-24" max="24" step="1" value="7" />
            </label>

            <label class="sy-control" for={`${id}-noise`}>
	              <span>Noise bed</span>
              <output id={`${id}-noise-value`}></output>
              <input id={`${id}-noise`} type="range" min="0" max="0.35" step="0.01" value="0.04" />
            </label>
          </div>
        </section>

	        <section class="sy-rack-module sy-rack-medium" aria-label="Tone filter module">
	          <span class="sy-label">Tone filter</span>
          <div class="sy-grid-controls">
            <label class="sy-control" for={`${id}-cutoff`}>
	              <span>Low-pass cut</span>
              <output id={`${id}-cutoff-value`}></output>
              <input id={`${id}-cutoff`} type="range" min="120" max="12000" step="20" value="1800" />
            </label>

            <label class="sy-control" for={`${id}-q`}>
	              <span>Resonance</span>
              <output id={`${id}-q-value`}></output>
              <input id={`${id}-q`} type="range" min="0.4" max="9" step="0.1" value="2.4" />
            </label>

            <label class="sy-control" for={`${id}-hp-motion`}>
	              <span>Low-cut sweep</span>
              <output id={`${id}-hp-motion-value`}></output>
              <input id={`${id}-hp-motion`} type="range" min="0" max="1" step="0.01" value="0.55" />
            </label>

            <label class="sy-control" for={`${id}-hp-rate`}>
	              <span>Sweep speed</span>
              <output id={`${id}-hp-rate-value`}></output>
              <input id={`${id}-hp-rate`} type="range" min="0.5" max="4" step="0.5" value="1" />
            </label>

            <label class="sy-control" for={`${id}-hp-base`}>
	              <span>Low-cut floor</span>
              <output id={`${id}-hp-base-value`}></output>
              <input id={`${id}-hp-base`} type="range" min="20" max="400" step="1" value="42" />
            </label>

            <label class="sy-control" for={`${id}-hp-top`}>
	              <span>Low-cut top</span>
              <output id={`${id}-hp-top-value`}></output>
              <input id={`${id}-hp-top`} type="range" min="300" max="4000" step="10" value="1650" />
            </label>
          </div>
        </section>

        <section class="sy-rack-module sy-rack-compact" aria-label="Sequencer module">
	          <span class="sy-label">Sequencer</span>
          <div class="sy-grid-controls">
            <label class="sy-control" for={`${id}-tempo`}>
              <span>Tempo</span>
              <output id={`${id}-tempo-value`}></output>
              <input id={`${id}-tempo`} type="range" min="82" max="176" step="1" value="128" />
            </label>

            <label class="sy-control" for={`${id}-gate`}>
	              <span>Note length</span>
              <output id={`${id}-gate-value`}></output>
              <input id={`${id}-gate`} type="range" min="0.08" max="0.9" step="0.01" value="0.42" />
            </label>

            <label class="sy-control" for={`${id}-time-signature`}>
	              <span>Meter</span>
              <select id={`${id}-time-signature`}>
                <option value="6/8">6/8</option>
                <option value="4/4">4/4</option>
                <option value="3/4">3/4</option>
                <option value="5/4">5/4</option>
                <option value="7/8">7/8</option>
              </select>
            </label>

            <label class="sy-control" for={`${id}-bars`}>
	              <span>Phrase bars</span>
              <output id={`${id}-bars-value`}></output>
              <input id={`${id}-bars`} type="range" min="1" max="16" step="1" value="8" />
            </label>
          </div>
        </section>

	        <section class="sy-rack-module sy-rack-medium" aria-label="Drive and grit module">
	          <span class="sy-label">Drive and grit</span>
	          <div class="sy-grid-controls">
	            <label class="sy-control" for={`${id}-drive-shape`} title="Saturation curve before the echo and output stages.">
	              <span>Clip curve</span>
	              <select id={`${id}-drive-shape`}>
	                <option value="tanh">Tanh</option>
	                <option value="softclip">Soft clip</option>
	                <option value="hardclip">Hard clip</option>
	              </select>
	            </label>

	            <label class="sy-control" for={`${id}-drive`} title="How hard the voice hits the saturation stage.">
	              <span>Input drive</span>
	              <output id={`${id}-drive-value`}></output>
	              <input id={`${id}-drive`} type="range" min="0" max="0.9" step="0.01" value="0.28" />
	            </label>

	            <label class="sy-control" for={`${id}-bitcrush-bits`} title="Lower values make the signal rougher and more digital.">
	              <span>Bit depth</span>
	              <output id={`${id}-bitcrush-bits-value`}></output>
	              <input id={`${id}-bitcrush-bits`} type="range" min="4" max="24" step="1" value="24" />
	            </label>

	            <label class="sy-control" for={`${id}-bitcrush-downsample`} title="Holds samples for longer to create sample-rate grit.">
	              <span>Sample hold</span>
	              <output id={`${id}-bitcrush-downsample-value`}></output>
	              <input id={`${id}-bitcrush-downsample`} type="range" min="1" max="16" step="1" value="1" />
	            </label>

	            <label class="sy-control" for={`${id}-comb-delay`} title="Short resonant delay time before the ambience.">
	              <span>Comb time</span>
	              <output id={`${id}-comb-delay-value`}></output>
	              <input id={`${id}-comb-delay`} type="range" min="1" max="120" step="1" value="28" />
	            </label>

	            <label class="sy-control" for={`${id}-comb-feedback`} title="Positive or negative resonance amount for the comb stage.">
	              <span>Comb ring</span>
	              <output id={`${id}-comb-feedback-value`}></output>
	              <input id={`${id}-comb-feedback`} type="range" min="-0.88" max="0.88" step="0.01" value="0" />
	            </label>

	            <label class="sy-control" for={`${id}-comb-damp`} title="Tames the high end inside the comb resonance.">
	              <span>Comb tone</span>
	              <output id={`${id}-comb-damp-value`}></output>
	              <input id={`${id}-comb-damp`} type="range" min="0" max="1" step="0.01" value="0.45" />
	            </label>
	          </div>
	        </section>

	        <section class="sy-rack-module sy-rack-medium" aria-label="Echo module">
	          <span class="sy-label">Echo</span>
	          <div class="sy-grid-controls">
	            <label class="sy-control" for={`${id}-delay-mode`} title="Chooses the delay processor. Tape modes add modulation and tone loss.">
	              <span>Echo type</span>
	              <select id={`${id}-delay-mode`}>
	                <option value="normal">Normal</option>
	                <option value="tape">Tape delay</option>
	                <option value="pingpong">Ping pong</option>
	                <option value="freeze">Freeze</option>
	                <option value="space-echo">Space Echo</option>
	              </select>
	            </label>

	            <label class="sy-control" for={`${id}-delay`}>
	              <span>Echo level</span>
	              <output id={`${id}-delay-value`}></output>
	              <input id={`${id}-delay`} type="range" min="0" max="0.75" step="0.01" value="0.25" />
	            </label>

	            <label class="sy-control" for={`${id}-delay-sync`}>
	              <span>Echo clock</span>
	              <select id={`${id}-delay-sync`}>
	                <option value="1/4">1/4</option>
	                <option value="1/8d">1/8 dotted</option>
	                <option value="1/8">1/8</option>
	                <option value="1/8t">1/8 triplet</option>
	                <option value="1/16">1/16</option>
	                <option value="1/2">1/2</option>
	                <option value="free">Free</option>
	              </select>
	            </label>

	            <label class="sy-control" for={`${id}-delay-time`} title="Manual delay time when Echo clock is set to Free.">
	              <span>Free time</span>
	              <output id={`${id}-delay-time-value`}></output>
	              <input id={`${id}-delay-time`} type="range" min="40" max="680" step="1" value="352" />
	            </label>

	            <label class="sy-control" for={`${id}-delay-feedback`} title="How much echo is fed back into itself.">
	              <span>Repeats</span>
	              <output id={`${id}-delay-feedback-value`}></output>
	              <input id={`${id}-delay-feedback`} type="range" min="0" max="0.88" step="0.01" value="0.5" />
	            </label>

	            <label class="sy-control" for={`${id}-wet-ducking`} title="Pulls the wet signal down while notes are active.">
	              <span>Echo ducking</span>
	              <output id={`${id}-wet-ducking-value`}></output>
	              <input id={`${id}-wet-ducking`} type="range" min="0" max="1" step="0.01" value="0.28" />
	            </label>

	            <label class="sy-control" for={`${id}-effect-order`} title="Changes whether tone, dirt, and space happen before or after each other.">
	              <span>Signal order</span>
	              <select id={`${id}-effect-order`}>
	                <option value="polished">Polished</option>
	                <option value="space-first">Space first</option>
	                <option value="dirty-echo">Dirty echo</option>
	              </select>
	            </label>
	          </div>
	        </section>

	        <section class="sy-rack-module sy-rack-medium" aria-label="Width and room module">
	          <span class="sy-label">Width and room</span>
	          <div class="sy-grid-controls">
	            <label class="sy-control" for={`${id}-chorus-rate`}>
	              <span>Chorus speed</span>
	              <output id={`${id}-chorus-rate-value`}></output>
	              <input id={`${id}-chorus-rate`} type="range" min="0.05" max="1.8" step="0.01" value="0.34" />
	            </label>

	            <label class="sy-control" for={`${id}-chorus-depth`}>
	              <span>Chorus width</span>
	              <output id={`${id}-chorus-depth-value`}></output>
	              <input id={`${id}-chorus-depth`} type="range" min="0" max="24" step="0.1" value="12" />
	            </label>

	            <label class="sy-control" for={`${id}-chorus-mix`}>
	              <span>Chorus level</span>
	              <output id={`${id}-chorus-mix-value`}></output>
	              <input id={`${id}-chorus-mix`} type="range" min="0" max="0.85" step="0.01" value="0.4" />
	            </label>

	            <label class="sy-control" for={`${id}-reverb-mix`}>
	              <span>Room level</span>
	              <output id={`${id}-reverb-mix-value`}></output>
	              <input id={`${id}-reverb-mix`} type="range" min="0" max="0.35" step="0.01" value="0" />
	            </label>

	            <label class="sy-control" for={`${id}-reverb-room`}>
	              <span>Room size</span>
	              <output id={`${id}-reverb-room-value`}></output>
	              <input id={`${id}-reverb-room`} type="range" min="0.02" max="0.12" step="0.01" value="0.08" />
	            </label>

	            <label class="sy-control" for={`${id}-reverb-decay`}>
	              <span>Room tail</span>
	              <output id={`${id}-reverb-decay-value`}></output>
	              <input id={`${id}-reverb-decay`} type="range" min="0.05" max="0.35" step="0.01" value="0.22" />
	            </label>
	          </div>
	        </section>

	        <section class="sy-rack-module sy-rack-large" aria-label="Tone shaping module">
	          <span class="sy-label">Tone shaping</span>
	          <div class="sy-grid-controls">
	            <label class="sy-control" for={`${id}-master-low-cut`}>
	              <span>Sub cleanup</span>
	              <output id={`${id}-master-low-cut-value`}></output>
	              <input id={`${id}-master-low-cut`} type="range" min="20" max="420" step="1" value="36" />
	            </label>

	            <label class="sy-control" for={`${id}-master-high-cut`}>
	              <span>Top rolloff</span>
	              <output id={`${id}-master-high-cut-value`}></output>
	              <input id={`${id}-master-high-cut`} type="range" min="1200" max="11800" step="20" value="9800" />
	            </label>

	            <label class="sy-control" for={`${id}-master-low-shelf`}>
	              <span>Low tone</span>
	              <output id={`${id}-master-low-shelf-value`}></output>
	              <input id={`${id}-master-low-shelf`} type="range" min="-12" max="12" step="0.1" value="-1.5" />
	            </label>

	            <label class="sy-control" for={`${id}-master-peak-freq`}>
	              <span>Focus freq</span>
	              <output id={`${id}-master-peak-freq-value`}></output>
	              <input id={`${id}-master-peak-freq`} type="range" min="180" max="9000" step="20" value="2800" />
	            </label>

	            <label class="sy-control" for={`${id}-master-peak-gain`}>
	              <span>Focus gain</span>
	              <output id={`${id}-master-peak-gain-value`}></output>
	              <input id={`${id}-master-peak-gain`} type="range" min="-12" max="12" step="0.1" value="-1.2" />
	            </label>

	            <label class="sy-control" for={`${id}-master-peak-q`}>
	              <span>Focus width</span>
	              <output id={`${id}-master-peak-q-value`}></output>
	              <input id={`${id}-master-peak-q`} type="range" min="0.2" max="12" step="0.1" value="0.9" />
	            </label>

	            <label class="sy-control" for={`${id}-master-high-shelf`}>
	              <span>Air tone</span>
	              <output id={`${id}-master-high-shelf-value`}></output>
	              <input id={`${id}-master-high-shelf`} type="range" min="-12" max="12" step="0.1" value="-2" />
	            </label>

	            <label class="sy-control" for={`${id}-special-filter`}>
	              <span>Extra filter</span>
	              <select id={`${id}-special-filter`}>
	                <option value="off">Off</option>
	                <option value="bandpass">Bandpass</option>
	                <option value="notch">Notch</option>
	                <option value="allpass">Allpass</option>
	              </select>
	            </label>

	            <label class="sy-control" for={`${id}-special-filter-freq`}>
	              <span>Extra freq</span>
	              <output id={`${id}-special-filter-freq-value`}></output>
	              <input id={`${id}-special-filter-freq`} type="range" min="80" max="9000" step="10" value="1450" />
	            </label>

	            <label class="sy-control" for={`${id}-special-filter-q`}>
	              <span>Extra Q</span>
	              <output id={`${id}-special-filter-q-value`}></output>
	              <input id={`${id}-special-filter-q`} type="range" min="0.2" max="18" step="0.1" value="1" />
	            </label>
	          </div>
	        </section>

	        <section class="sy-rack-module sy-rack-medium" aria-label="Dynamics and output module">
	          <span class="sy-label">Dynamics and output</span>
	          <div class="sy-grid-controls">
	            <label class="sy-control" for={`${id}-comp-threshold`}>
	              <span>Comp threshold</span>
	              <output id={`${id}-comp-threshold-value`}></output>
	              <input id={`${id}-comp-threshold`} type="range" min="-48" max="-4" step="1" value="-18" />
	            </label>

	            <label class="sy-control" for={`${id}-comp-ratio`}>
	              <span>Comp ratio</span>
	              <output id={`${id}-comp-ratio-value`}></output>
	              <input id={`${id}-comp-ratio`} type="range" min="1" max="12" step="0.1" value="2.4" />
	            </label>

	            <label class="sy-control" for={`${id}-comp-attack`}>
	              <span>Comp attack</span>
	              <output id={`${id}-comp-attack-value`}></output>
	              <input id={`${id}-comp-attack`} type="range" min="1" max="80" step="1" value="4" />
	            </label>

	            <label class="sy-control" for={`${id}-comp-release`}>
	              <span>Comp release</span>
	              <output id={`${id}-comp-release-value`}></output>
	              <input id={`${id}-comp-release`} type="range" min="30" max="700" step="5" value="180" />
	            </label>

	            <label class="sy-control" for={`${id}-comp-knee`}>
	              <span>Comp softness</span>
	              <output id={`${id}-comp-knee-value`}></output>
	              <input id={`${id}-comp-knee`} type="range" min="0" max="40" step="1" value="18" />
	            </label>

	            <label class="sy-control" for={`${id}-pan`}>
	              <span>Pan</span>
	              <output id={`${id}-pan-value`}></output>
	              <input id={`${id}-pan`} type="range" min="-1" max="1" step="0.01" value="0.08" />
	            </label>

	            <label class="sy-control" for={`${id}-output-gain`} title="Final level after all effects. Lower this first if the peak readout is hot.">
	              <span>Final level</span>
	              <output id={`${id}-output-gain-value`}></output>
	              <input id={`${id}-output-gain`} type="range" min="0.2" max="1.4" step="0.01" value="0.9" />
	            </label>

	            <label class="sy-control" for={`${id}-output-clip`} title="Final soft clipping amount. Use sparingly if the output is crunchy.">
	              <span>Final clip</span>
	              <output id={`${id}-output-clip-value`}></output>
	              <input id={`${id}-output-clip`} type="range" min="0" max="0.8" step="0.01" value="0.04" />
	            </label>
	          </div>
	        </section>

	        <section class="sy-rack-module sy-rack-medium" aria-label="Macros and motion module">
	          <span class="sy-label">Macros and motion</span>
	          <div class="sy-grid-controls">
	            <label class="sy-control" for={`${id}-macro-bloom`}>
	              <span>Width macro</span>
	              <output id={`${id}-macro-bloom-value`}></output>
	              <input id={`${id}-macro-bloom`} type="range" min="0" max="1" step="0.01" value="0.18" />
	            </label>

	            <label class="sy-control" for={`${id}-macro-motion`}>
	              <span>Motion macro</span>
	              <output id={`${id}-macro-motion-value`}></output>
	              <input id={`${id}-macro-motion`} type="range" min="0" max="1" step="0.01" value="0.35" />
	            </label>

	            <label class="sy-control" for={`${id}-macro-dirt`}>
	              <span>Grit macro</span>
	              <output id={`${id}-macro-dirt-value`}></output>
	              <input id={`${id}-macro-dirt`} type="range" min="0" max="1" step="0.01" value="0.08" />
	            </label>

	            <label class="sy-control" for={`${id}-macro-space`}>
	              <span>Space macro</span>
	              <output id={`${id}-macro-space-value`}></output>
	              <input id={`${id}-macro-space`} type="range" min="0" max="1" step="0.01" value="0.22" />
	            </label>

	            <label class="sy-control" for={`${id}-auto-target`}>
	              <span>Auto destination</span>
	              <select id={`${id}-auto-target`}>
	                <option value="hp">Low-cut sweep</option>
	                <option value="delay">Echo level</option>
	                <option value="chorus">Chorus level</option>
	                <option value="filter">Filter focus</option>
	                <option value="none">Off</option>
	              </select>
	            </label>

	            <label class="sy-control" for={`${id}-auto-rate`}>
	              <span>Auto speed</span>
	              <output id={`${id}-auto-rate-value`}></output>
	              <input id={`${id}-auto-rate`} type="range" min="0.5" max="8" step="0.5" value="2" />
	            </label>

	            <label class="sy-control" for={`${id}-auto-depth`}>
	              <span>Auto amount</span>
	              <output id={`${id}-auto-depth-value`}></output>
	              <input id={`${id}-auto-depth`} type="range" min="0" max="1" step="0.01" value="0.18" />
	            </label>

	            <label class="sy-control" for={`${id}-snapshot-morph`}>
	              <span>A/B blend</span>
	              <output id={`${id}-snapshot-morph-value`}></output>
