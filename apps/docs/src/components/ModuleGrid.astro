---
const modules = [
  { ns: '/array', name: 'Array', href: '/api/array' },
  { ns: '/iter', name: 'Iter', href: '/api/iter' },
  { ns: '/option', name: 'Option', href: '/api/option' },
  { ns: '/result', name: 'Result', href: '/api/result' },
  { ns: '/validation', name: 'Validation', href: '/api/validation' },
  { ns: '/schema', name: 'Schema', href: '/api/schema' },
  { ns: '/optic', name: 'Optic', href: '/api/optic' },
  { ns: '/eq', name: 'Algebra', href: '/api/algebra' },
  { ns: 'all', name: '40+ modules', href: '/api/modules' },
]
---

<div class="module-grid not-content">
  {modules.map(m => (
    <a class="module-card" href={m.href}>
      <span class="module-ns">{m.ns}</span>
      <span class="module-name">{m.name}</span>
    </a>
  ))}
</div>

<!-- Keep route-local styles inline: Astro 6 + Rolldown can orphan MDX component CSS assets. -->
<style is:inline>
  .module-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.5rem;
    margin: 2rem 0;
  }

  .module-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 0.5rem;
    background: var(--sl-color-gray-6, #141420);
    border: 1px solid var(--sl-color-gray-5, #1e1e2e);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .module-card:hover {
    border-color: var(--sl-color-accent, #00e5a0);
  }

  .module-ns {
    font-family: var(--sl-font-mono);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--sl-color-accent, #00e5a0);
  }

  .module-name {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #6e6e82);
  }
</style>
