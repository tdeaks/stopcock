---
const id = 'spectral-optimizer-demo'
---

<div class="so-demo not-content" id={id} data-spectral-optimizer>
  <section class="so-stage" aria-label="Spectral optimizer">
    <header class="so-header">
      <div>
        <p class="so-kicker">frequency target to synth patch to real audio</p>
        <h2>Fit a synth to a frequency target</h2>
        <p class="so-subtitle">Each bar is desired loudness in one frequency band: bass on the left, mids in the middle, brightness on the right. Fit the synth, then compare the blue model with the purple audio the analyser actually hears.</p>
      </div>
      <div class="so-header-readout">
        <div class="so-scoreboard" aria-label="Optimization metrics">
          <div><span>model error</span><output id={`${id}-loss`}>0.000</output></div>
          <div><span>proof match</span><output id={`${id}-match`}>waiting</output></div>
          <div><span>fit time</span><output id={`${id}-opt-ms`}>idle</output></div>
          <div><span>audio render</span><output id={`${id}-render-ms`}>idle</output></div>
          <div><span>live peak</span><output id={`${id}-fft`}>idle</output></div>
        </div>
        <div class="so-loop" aria-label="Demo signal flow">
          <div><span>1 Target</span><b>frequency bands</b></div>
          <div><span>2 Fitted synth</span><b>blue model</b></div>
          <div><span>3 Proof</span><b>measured bands</b></div>
        </div>
      </div>
    </header>

    <div class="so-layout">
      <section class="so-panel so-controls" aria-label="Target and optimizer controls">
        <div class="so-group">
          <span class="so-label">1. Frequency balance to match</span>
          <div class="so-presets" id={`${id}-presets`} role="radiogroup" aria-label="Target preset"></div>
        </div>

        <div class="so-target-shell">
          <div class="so-panel-head">
            <span>Target loudness by frequency</span>
            <output id={`${id}-target-label`}>Glass Pluck</output>
          </div>
          <svg id={`${id}-target-editor`} class="so-target-svg" viewBox="0 0 320 130" role="img" aria-label="Editable target spectrum bars"></svg>
          <div class="so-frequency-axis" aria-hidden="true">
            <span>Sub / bass</span>
            <span>Mids / presence</span>
            <span>Treble / air</span>
          </div>
          <p class="so-field-note">Taller means louder in that frequency band. These bars are an EQ-style target, not notes on a keyboard.</p>
        </div>

        <div class="so-actions">
          <button type="button" class="so-primary" id={`${id}-optimize`}>Fit synth</button>
          <button type="button" id={`${id}-play`}>Play sound</button>
          <button type="button" id={`${id}-mutate`}>Random shape</button>
          <button type="button" id={`${id}-reset`}>Reset</button>
          <button type="button" id={`${id}-wav`}>Download WAV</button>
        </div>

        <div class="so-toggles">
          <label><input type="checkbox" id={`${id}-live`} checked /> Morph while fitting</label>
          <label class="so-select" for={`${id}-lens`}>
            <span>CVD lens</span>
            <select id={`${id}-lens`}>
              <option value="none">Normal</option>
              <option value="protanopia">Protanopia</option>
              <option value="deuteranopia">Deuteranopia</option>
              <option value="tritanopia">Tritanopia</option>
              <option value="achromatopsia">Achromatopsia</option>
            </select>
          </label>
        </div>

        <div class="so-status" id={`${id}-status`} role="status" aria-live="polite">Pick a target or drag the bars, then fit the synth.</div>
      </section>

      <section class="so-panel so-spectrum-panel" aria-label="Live SVG spectrum">
        <div class="so-panel-head">
          <span>2. Target vs fitted synth vs real sound</span>
          <div class="so-legend" aria-hidden="true">
            <span><i class="so-key so-key-target"></i>target bars</span>
            <span><i class="so-key so-key-model"></i>synth model</span>
            <span><i class="so-key so-key-real"></i>real audio</span>
          </div>
        </div>
        <svg id={`${id}-spectrum-svg`} class="so-spectrum-svg" viewBox="0 0 920 330" role="img" aria-label="Target, model, and real FFT spectrum">
          <defs>
            <linearGradient id={`${id}-spectrum-gradient`} x1="0" y1="1" x2="0" y2="0">
              <stop offset="0%" stop-color="var(--so-cool)"></stop>
              <stop offset="58%" stop-color="var(--so-accent)"></stop>
              <stop offset="100%" stop-color="var(--so-hot)"></stop>
            </linearGradient>
          </defs>
          <g class="so-grid"></g>
          <g id={`${id}-spectrum-target`}></g>
          <g id={`${id}-spectrum-model`}></g>
          <g id={`${id}-spectrum-real`}></g>
        </svg>
        <div class="so-frequency-axis so-spectrum-axis" aria-hidden="true">
          <span>Low frequency energy</span>
          <span>Midrange energy</span>
          <span>High frequency energy</span>
        </div>
        <p class="so-panel-note">Each cluster is one frequency band. Grey is the target, blue is the optimizer's model, purple is measured from rendered or played audio. <output id={`${id}-proof-summary`}>Waiting for measured audio.</output></p>
      </section>

      <section class="so-panel so-spectrogram-panel" aria-label="SVG spectrogram">
        <div class="so-panel-head">
          <span>3. Audio visualizer</span>
          <output id={`${id}-audio-readout`}>no audio yet</output>
        </div>
        <svg id={`${id}-spectrogram`} class="so-spectrogram" role="img" aria-label="Rolling SVG spectrogram"></svg>
      </section>

      <section class="so-panel so-patch-panel" aria-label="Synth patch parameters">
        <div class="so-panel-head">
          <span>4. Synth knobs moved by the fit</span>
          <output>0 is low, 100 is high</output>
        </div>
        <div class="so-param-strip" id={`${id}-params`} aria-label="Optimized patch parameters"></div>
      </section>

      <section class="so-panel so-internals-panel" aria-label="Advanced optimizer artifacts">
        <div class="so-panel-head">
          <span>Exports and internals</span>
          <div class="so-export-actions">
            <button type="button" id={`${id}-fingerprint-download`}>Trail SVG</button>
            <button type="button" id={`${id}-poster`}>Poster SVG</button>
          </div>
        </div>
        <details class="so-internals">
          <summary>Show the optimizer map, gradient trail, and generated palette</summary>
          <div class="so-internals-grid">
            <div>
              <div class="so-panel-head">
                <span>Optimizer map</span>
                <output id={`${id}-landscape-readout`}>cutoff x resonance</output>
              </div>
              <div id={`${id}-landscape`} class="so-artifact"></div>
            </div>
            <div>
              <div class="so-panel-head">
                <span>Gradient trail</span>
              </div>
              <div id={`${id}-fingerprint`} class="so-artifact"></div>
            </div>
            <div class="so-poster-preview">
              <div id={`${id}-mini-glyph`} class="so-mini-glyph"></div>
              <div class="so-palette" id={`${id}-palette`} aria-label="Generated color palette"></div>
            </div>
          </div>
        </details>
      </section>
    </div>
  </section>
</div>

<script>
  import {
    DEFAULT_PARAMS,
    MODEL_BIN_COUNT,
    PARAM_DEFS,
    SPECTRAL_BIN_COUNT,
    TARGET_PRESETS,
    applyPaletteLens,
    derivePalette,
    forwardModel,
    lossFn,
    modelSpectrum,
    normalizeSpectrum,
    resampleSpectrum,
    runOptimization,
    spectralBinFrequencies,
    type LensKey,
    type OptimizationFrame,
    type SpectralPalette,
    type TargetPresetKey,
  } from '../lib/spectral-optimizer'
  import { renderPatchAudio, type RenderedPatch } from '../lib/spectral-optimizer-synth'
  import {
    downloadSvg,
    hydrateFingerprint,
    hydrateLandscape,
    labelForHistory,
    makeFingerprint,
    makeLandscape,
    makeMiniGlyph,
    makePoster,
    makeSpectrogramPool,
    type HistoryFrame,
    type SpectrogramPool,
  } from '../lib/spectral-optimizer-svg'
  import { bootWorklet, type SpectralWorklet } from '../lib/spectral-optimizer-worklet'

  type WorkerFrameMessage = {
    type: 'frame'
    step: number
    loss: number
    params: Float32Array
    model: Float32Array
    modelMag: Float32Array
    gradMag: Float32Array
  }
  type WorkerDoneMessage = { type: 'done'; durationMs: number }
  type WorkerLandscapeMessage = { type: 'landscape'; grid: Float32Array; size: number; durationMs: number }
  type WorkerMessage = WorkerFrameMessage | WorkerDoneMessage | WorkerLandscapeMessage

  const root = document.querySelector('[data-spectral-optimizer]') as HTMLElement
  if (!root) throw new Error('SpectralOptimizerDemo root not found')

  const id = root.id
  const $ = <T extends HTMLElement | SVGElement = HTMLElement>(suffix: string): T => {
    const el = root.querySelector(`#${id}-${suffix}`) as T | null
    if (!el) throw new Error(`SpectralOptimizerDemo missing ${suffix}`)
    return el
  }

  const presetKeys = ['warmBass', 'glassPluck', 'noisyComet', 'custom'] as const
  const presetGroup = $('presets')
  const targetSvg = $('target-editor') as SVGSVGElement
  const targetGroup = $('spectrum-target') as SVGGElement
  const modelGroup = $('spectrum-model') as SVGGElement
  const realGroup = $('spectrum-real') as SVGGElement
  const spectrogramSvg = $('spectrogram') as SVGSVGElement
  const landscapeEl = $('landscape')
  const fingerprintEl = $('fingerprint')
  const miniGlyphEl = $('mini-glyph')
  const paletteEl = $('palette')
  const paramsEl = $('params')
  const statusEl = $('status')
  const targetLabel = $('target-label') as HTMLOutputElement
  const lossOut = $('loss') as HTMLOutputElement
  const matchOut = $('match') as HTMLOutputElement
  const proofSummary = $('proof-summary') as HTMLOutputElement
  const optMsOut = $('opt-ms') as HTMLOutputElement
  const renderMsOut = $('render-ms') as HTMLOutputElement
  const fftOut = $('fft') as HTMLOutputElement
  const audioReadout = $('audio-readout') as HTMLOutputElement
  const landscapeReadout = $('landscape-readout') as HTMLOutputElement
  const optimizeButton = $('optimize') as HTMLButtonElement
  const playButton = $('play') as HTMLButtonElement
  const mutateButton = $('mutate') as HTMLButtonElement
  const resetButton = $('reset') as HTMLButtonElement
  const wavButton = $('wav') as HTMLButtonElement
  const posterButton = $('poster') as HTMLButtonElement
  const fingerprintButton = $('fingerprint-download') as HTMLButtonElement
  const lensSelect = $('lens') as HTMLSelectElement
  const liveToggle = $('live') as HTMLInputElement

  let activePreset: TargetPresetKey = 'glassPluck'
  let lens: LensKey = 'none'
  let target = [...TARGET_PRESETS[activePreset].target]
  let params = [...TARGET_PRESETS[activePreset].params]
  let modelMag = forwardModel(params)
  let model = modelSpectrum(params)
  let real = Array.from({ length: SPECTRAL_BIN_COUNT }, () => 0)
  let proofReal = Array.from({ length: SPECTRAL_BIN_COUNT }, () => 0)
  let loss = lossFn(modelMag, target)
  let history: HistoryFrame[] = []
  let landscapeGrid: Float32Array | null = null
  let landscapeSize = 48
  let renderedPatch: RenderedPatch | null = null
  let wavUrl: string | null = null
  let worker: Worker | null = null
  let runId = 0
  let dragIndex: number | null = null
  let spectrogram: SpectrogramPool | null = null
  let audioCtx: AudioContext | null = null
  let audioSource: AudioBufferSourceNode | null = null
  let analyser: AnalyserNode | null = null
  let analyserFrame = 0
  let worklet: SpectralWorklet | null = null
  let hasProofAudio = false
  let lastAudioStats = { centroid: 0, rolloff: 0, flatness: 0 }
  let optimizerFrame = 0
  let pendingSpectrogramMag: ArrayLike<number> | null = null

  const fmt = (value: number, digits = 3) => Number.isFinite(value) ? value.toFixed(digits) : '0'
  const clamp01 = (value: number) => Math.max(0, Math.min(1, value))
  const bandLabels = [
    'sub bass around 40 Hz',
    'bass around 63 Hz',
    'bass around 100 Hz',
    'low mids around 160 Hz',
    'body around 250 Hz',
    'body around 400 Hz',
    'mids around 630 Hz',
    'mids around 1 kHz',
    'presence around 1.6 kHz',
    'presence around 2.5 kHz',
    'brightness around 4 kHz',
    'brightness around 6 kHz',
    'air around 8 kHz',
    'air around 10 kHz',
    'noise around 12 kHz',
    'noise around 16 kHz',
  ]
  function setStatus(message: string) {
    statusEl.textContent = message
  }

  function palette(): SpectralPalette {
    return applyPaletteLens(derivePalette(params, model, loss), lens)
  }

  function revokeWav() {
    if (wavUrl) URL.revokeObjectURL(wavUrl)
    wavUrl = null
  }

  function renderTargetEditor() {
    targetSvg.replaceChildren()
    const width = 320
    const height = 130
    const pad = 10
    const binW = (width - pad * 2) / target.length
    const pal = palette()
    for (let i = 0; i < target.length; i++) {
      const value = clamp01(target[i])
      const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect')
      const barH = value * (height - pad * 2)
      rect.setAttribute('x', String(pad + i * binW + 2))
      rect.setAttribute('y', String(height - pad - barH))
      rect.setAttribute('width', String(Math.max(3, binW - 4)))
      rect.setAttribute('height', String(Math.max(2, barH)))
      rect.setAttribute('fill', `url(#${id}-target-gradient)`)
      rect.dataset.index = String(i)
      targetSvg.append(rect)
    }
    targetSvg.insertAdjacentHTML('afterbegin', `
      <defs>
        <linearGradient id="${id}-target-gradient" x1="0" y1="1" x2="0" y2="0">
          <stop offset="0%" stop-color="${pal.cool}"></stop>
          <stop offset="58%" stop-color="${pal.accent}"></stop>
          <stop offset="100%" stop-color="${pal.hot}"></stop>
        </linearGradient>
      </defs>
      <rect x="0" y="0" width="${width}" height="${height}" fill="rgba(237,244,237,.035)"></rect>
    `)
  }

  function scoreAgainst(reference: ArrayLike<number>, measured: ArrayLike<number>): number {
    const a = normalizeSpectrum(reference, SPECTRAL_BIN_COUNT)
    const b = normalizeSpectrum(measured, SPECTRAL_BIN_COUNT)
    let error = 0
    for (let i = 0; i < SPECTRAL_BIN_COUNT; i++) error += Math.abs((a[i] ?? 0) - (b[i] ?? 0))
    return clamp01(1 - error / SPECTRAL_BIN_COUNT)
  }

  function worstBand(reference: ArrayLike<number>, measured: ArrayLike<number>): number {
    const a = normalizeSpectrum(reference, SPECTRAL_BIN_COUNT)
    const b = normalizeSpectrum(measured, SPECTRAL_BIN_COUNT)
    let index = 0
    let error = -1
    for (let i = 0; i < SPECTRAL_BIN_COUNT; i++) {
      const next = Math.abs((a[i] ?? 0) - (b[i] ?? 0))
      if (next > error) {
        error = next
        index = i
      }
    }
    return index
  }

  function renderBar(group: SVGGElement, index: number, lane: number, value: number, fill: string, label: string) {
    const width = 920
    const height = 330
    const padX = 20
    const padY = 24
    const innerW = width - padX * 2
    const innerH = height - padY * 2
    const binW = innerW / SPECTRAL_BIN_COUNT
    const barW = binW * 0.24
    const x = padX + index * binW + binW * (0.08 + lane * 0.29)
    const barH = clamp01(value) * innerH
    const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect')
    rect.setAttribute('x', x.toFixed(2))
    rect.setAttribute('y', (height - padY - barH).toFixed(2))
    rect.setAttribute('width', barW.toFixed(2))
    rect.setAttribute('height', Math.max(1, barH).toFixed(2))
    rect.setAttribute('fill', fill)
    rect.setAttribute('rx', '1.5')
    const title = document.createElementNS('http://www.w3.org/2000/svg', 'title')
    title.textContent = `${label}: ${Math.round(clamp01(value) * 100)}% at ${bandLabels[index] ?? `band ${index + 1}`}`
    rect.append(title)
    group.append(rect)
  }

  function renderSpectrum() {
    targetGroup.replaceChildren()
    modelGroup.replaceChildren()
    realGroup.replaceChildren()
    const measured = normalizeSpectrum(proofReal, SPECTRAL_BIN_COUNT)
    for (let i = 0; i < SPECTRAL_BIN_COUNT; i++) {
      renderBar(targetGroup, i, 0, Number(target[i] ?? 0), 'rgba(237,244,237,.18)', 'target')
      renderBar(modelGroup, i, 1, Number(model[i] ?? 0), 'var(--so-accent)', 'model')
      renderBar(realGroup, i, 2, hasProofAudio ? Number(measured[i] ?? 0) : 0, 'var(--so-hot)', 'measured audio')
    }
  }

  function renderProof() {
    const modelScore = scoreAgainst(target, model)
    if (!hasProofAudio) {
      matchOut.value = `${Math.round(modelScore * 100)}% model`
      proofSummary.value = `Model prediction is ${Math.round(modelScore * 100)}%; render or play audio to measure the real patch.`
      return
    }
    const measured = normalizeSpectrum(proofReal, SPECTRAL_BIN_COUNT)
    const audioScore = scoreAgainst(target, measured)
    const worst = worstBand(target, measured)
    matchOut.value = `${Math.round(audioScore * 100)}% audio`
    proofSummary.value = `Measured audio match is ${Math.round(audioScore * 100)}%; largest miss is ${bandLabels[worst] ?? `band ${worst + 1}`}.`
  }

  function renderSpectrumPaths() {
    renderSpectrum()
    renderProof()
  }

  function renderReadout() {
    lossOut.value = fmt(loss, 4)
    renderProof()
    paramsEl.replaceChildren()
    for (let i = 0; i < PARAM_DEFS.length; i++) {
      const item = document.createElement('div')
      item.className = 'so-param'
      item.innerHTML = `<span>${PARAM_DEFS[i].label}: ${Math.round(params[i] * 100)}</span><i style="--v:${params[i]}"></i>`
      paramsEl.append(item)
    }
  }

  function renderPalette() {
    const pal = palette()
    root.style.setProperty('--so-accent', pal.accent)
    root.style.setProperty('--so-hot', pal.hot)
    root.style.setProperty('--so-cool', pal.cool)
    root.style.setProperty('--so-muted', pal.muted)
    paletteEl.replaceChildren()
    for (const key of ['accent', 'hot', 'cool', 'muted'] as const) {
      const swatch = document.createElement('div')
      swatch.className = 'so-swatch'
      swatch.style.background = pal[key]
      swatch.title = `${key}: ${pal[key]}`
      paletteEl.append(swatch)
    }
    miniGlyphEl.innerHTML = makeMiniGlyph(params, pal)
  }

  function renderArtifacts() {
    const pal = palette()
    if (history.length > 0) hydrateFingerprint(fingerprintEl, history, pal)
    else fingerprintEl.innerHTML = makeFingerprint([{ step: 0, params, loss, gradMag: params }], pal)

    if (landscapeGrid) hydrateLandscape(landscapeEl, landscapeGrid, history.map((frame) => frame.params), pal)
    else landscapeEl.innerHTML = makeLandscape(new Float32Array(48 * 48).fill(1), [params], pal)
  }

  function renderPresets() {
    presetGroup.replaceChildren()
    for (const key of presetKeys) {
      const preset = TARGET_PRESETS[key]
      const button = document.createElement('button')
      button.type = 'button'
      button.className = key === activePreset ? 'so-preset is-active' : 'so-preset'
      button.textContent = preset.label
      button.setAttribute('role', 'radio')
      button.setAttribute('aria-checked', String(key === activePreset))
      button.addEventListener('click', () => setPreset(key))
      presetGroup.append(button)
    }
    targetLabel.value = TARGET_PRESETS[activePreset].label
  }

  function renderAll() {
    modelMag = forwardModel(params)
    model = normalizeSpectrum(resampleSpectrum(modelMag, SPECTRAL_BIN_COUNT), SPECTRAL_BIN_COUNT)
    loss = lossFn(modelMag, target)
    renderPresets()
    renderTargetEditor()
    renderSpectrum()
    renderReadout()
    renderPalette()
    renderArtifacts()
  }

  function scheduleOptimizerPaint() {
    if (optimizerFrame) return
    optimizerFrame = requestAnimationFrame(() => {
      optimizerFrame = 0
      renderSpectrumPaths()
      renderReadout()
      renderPalette()
      if (pendingSpectrogramMag) {
        spectrogram?.writeColumn(pendingSpectrogramMag)
        pendingSpectrogramMag = null
      }
    })
  }

  function applyFrame(frame: { step: number; params: ArrayLike<number>; model: ArrayLike<number>; modelMag: ArrayLike<number>; loss: number; gradMag?: ArrayLike<number> }) {
    params = Array.from(frame.params, Number)
    model = Array.from(frame.model, Number)
    modelMag = Float32Array.from(Array.from(frame.modelMag, Number))
    loss = frame.loss
    history.push({
      step: frame.step,
      params: [...params],
      loss,
      gradMag: frame.gradMag ? Array.from(frame.gradMag, Number) : undefined,
    })
    if (frame.step % 3 === 0) pendingSpectrogramMag = modelMag
    worklet?.update(params)
    scheduleOptimizerPaint()
  }

  function setPreset(key: TargetPresetKey) {
    activePreset = key
    target = [...TARGET_PRESETS[key].target]
    params = [...TARGET_PRESETS[key].params]
    real = Array.from({ length: SPECTRAL_BIN_COUNT }, () => 0)
    proofReal = Array.from({ length: SPECTRAL_BIN_COUNT }, () => 0)
    hasProofAudio = false
    history = []
    renderedPatch = null
    landscapeGrid = null
    revokeWav()
    setStatus(`${TARGET_PRESETS[key].label} target loaded. Fit the synth to hear it.`)
    renderAll()
  }

  function setTargetAt(event: PointerEvent) {
    const rect = targetSvg.getBoundingClientRect()
    const x = clamp01((event.clientX - rect.left) / rect.width)
    const y = clamp01((event.clientY - rect.top) / rect.height)
    const index = Math.max(0, Math.min(target.length - 1, Math.floor(x * target.length)))
    dragIndex = index
    activePreset = 'custom'
    target[index] = clamp01(1 - y)
    renderedPatch = null
    proofReal = Array.from({ length: SPECTRAL_BIN_COUNT }, () => 0)
    hasProofAudio = false
    revokeWav()
    setStatus(`Target ${bandLabels[index] ?? `band ${index + 1}`} set to ${Math.round(target[index] * 100)}% loudness`)
    renderAll()
  }

  function bootWorker(): Worker | null {
    if (worker) return worker
    try {
      worker = new Worker(new URL('../lib/spectral-optimizer-worker.ts', import.meta.url), { type: 'module' })
      worker.addEventListener('message', (event: MessageEvent<WorkerMessage>) => {
        const message = event.data
        if (message.type === 'frame') {
          applyFrame(message)
        } else if (message.type === 'done') {
          optMsOut.value = `${Math.round(message.durationMs)}ms`
          void verifyRender(message.durationMs)
        } else if (message.type === 'landscape') {
          landscapeGrid = message.grid
          landscapeSize = message.size
          landscapeReadout.value = `grid ${message.size}x${message.size} / ${Math.round(message.durationMs)}ms`
          renderArtifacts()
        }
      })
      return worker
    } catch {
      worker = null
      return null
    }
  }

  async function ensureAudioContext(): Promise<AudioContext | null> {
    const Ctor = window.AudioContext || (window as any).webkitAudioContext
    if (!Ctor) return null
    audioCtx ??= new Ctor()
    await audioCtx.resume()
    return audioCtx
  }

  async function ensureWorklet() {
    if (!liveToggle.checked || worklet) return
    const ctx = await ensureAudioContext()
    if (!ctx) return
    try {
      worklet = await bootWorklet(ctx, params)
      analyser = worklet.analyser
      monitorAnalyser()
    } catch {
      setStatus('Live morph unavailable; fitting will verify with an offline render')
      worklet = null
    }
  }

  function stopAudio() {
    if (audioSource) {
      try { audioSource.stop() } catch { /* already stopped */ }
      audioSource.disconnect()
      audioSource = null
    }
    worklet?.stop()
    worklet = null
    if (analyserFrame) cancelAnimationFrame(analyserFrame)
    analyserFrame = 0
    analyser = null
    playButton.textContent = 'Play sound'
  }

  function analyserBins(bytes: Uint8Array): number[] {
    const grouped = Array.from({ length: SPECTRAL_BIN_COUNT }, (_, i) => {
      const { start, end } = analyserBandRange(i, SPECTRAL_BIN_COUNT, bytes.length, audioCtx?.sampleRate ?? 44_100)
      let peak = 0
      for (let j = start; j < end; j++) peak = Math.max(peak, bytes[j] ?? 0)
      return peak / 255
    })
    return normalizeSpectrum(grouped)
  }

  function analyserBandRange(index: number, binCount: number, magnitudeCount: number, sampleRate: number) {
    const freqs = spectralBinFrequencies({ binCount, sampleRate })
    const center = freqs[index] ?? 1
    const lo = index === 0 ? center / Math.sqrt((freqs[1] ?? center * 1.5) / center) : Math.sqrt((freqs[index - 1] ?? center) * center)
    const hi = index === binCount - 1 ? center * Math.sqrt(center / (freqs[index - 1] ?? center / 1.5)) : Math.sqrt(center * (freqs[index + 1] ?? center))
    const nyquist = sampleRate / 2
    const start = Math.max(1, Math.floor((lo / nyquist) * (magnitudeCount - 1)))
    const end = Math.max(start + 1, Math.min(magnitudeCount, Math.ceil((hi / nyquist) * (magnitudeCount - 1))))
    return { start, end }
  }

  function monitorAnalyser() {
    if (!analyser) return
    const freqBytes = new Uint8Array(analyser.frequencyBinCount)
    const tick = () => {
      if (!analyser) return
      analyser.getByteFrequencyData(freqBytes)
      real = analyserBins(freqBytes)
      let peakIndex = 0
      let peak = 0
      for (let i = 0; i < freqBytes.length; i++) {
        if (freqBytes[i] > peak) {
          peak = freqBytes[i]
          peakIndex = i
        }
      }
      const rate = audioCtx?.sampleRate ?? 44_100
      fftOut.value = `${Math.round((peakIndex / freqBytes.length) * (rate / 2))} Hz`
      audioReadout.value = `live analyser peak ${Math.round((peak / 255) * 100)}%`
      spectrogram?.writeColumn(real)
      analyserFrame = requestAnimationFrame(tick)
    }
    if (analyserFrame) cancelAnimationFrame(analyserFrame)
    tick()
  }

  async function verifyRender(optMs = 0) {
    renderedPatch = renderPatchAudio(params)
    revokeWav()
    wavUrl = URL.createObjectURL(new Blob([renderedPatch.wav], { type: 'audio/wav' }))
    real = renderedPatch.analysis.bins
    proofReal = [...renderedPatch.analysis.bins]
    hasProofAudio = true
    lastAudioStats = renderedPatch.analysis
    renderMsOut.value = `${fmt(renderedPatch.timings.renderMs, 1)}ms`
    fftOut.value = `${fmt(renderedPatch.analysis.fftMs, 2)}ms`
    audioReadout.value = `centroid ${Math.round(renderedPatch.analysis.centroid)} Hz / rms ${fmt(renderedPatch.analysis.rms, 3)}`
    setStatus('Fitted synth rendered; purple bars are measured audio from the analyser')
    renderSpectrumPaths()
    renderArtifacts()
  }

  async function optimize() {
    stopAudio()
    spectrogram?.reset()
    history = []
    real = Array.from({ length: SPECTRAL_BIN_COUNT }, () => 0)
    proofReal = Array.from({ length: SPECTRAL_BIN_COUNT }, () => 0)
    hasProofAudio = false
    renderedPatch = null
    revokeWav()
    const token = ++runId
    setStatus('Fitting synth parameters to the drawn target')
    optMsOut.value = 'running'
    await ensureWorklet()

    const targetCopy = Float32Array.from(target)
    const paramsCopy = Float32Array.from(params)
    const w = bootWorker()
    if (w) {
      w.postMessage({ type: 'landscape', target: Float32Array.from(target), center: Float32Array.from(params), size: 48 })
      w.postMessage({ type: 'run', target: targetCopy, params: paramsCopy, steps: 200, lrInit: 0.05, lrMin: 0.005 }, [targetCopy.buffer, paramsCopy.buffer])
      return
    }

    const started = performance.now()
    const run = runOptimization(target, params, { steps: 200 })
    let index = 0
    const tick = () => {
      if (token !== runId) return
      const frame: OptimizationFrame = run.frames[index]
      applyFrame({ ...frame, step: index })
      index++
      if (index < run.frames.length) requestAnimationFrame(tick)
      else {
        optMsOut.value = `${Math.round(performance.now() - started)}ms`
        void verifyRender(performance.now() - started)
      }
    }
    tick()
  }

  async function playRendered() {
    if (audioSource) {
      stopAudio()
      setStatus('Stopped')
      return
    }
    const ctx = await ensureAudioContext()
    if (!ctx) {
      setStatus('Web Audio is not available')
      return
    }
    if (!renderedPatch) await verifyRender()
    if (!renderedPatch) return

    const buffer = ctx.createBuffer(1, renderedPatch.mono.length, renderedPatch.sampleRate)
    buffer.copyToChannel(renderedPatch.mono, 0)
    const source = ctx.createBufferSource()
    const nextAnalyser = ctx.createAnalyser()
    nextAnalyser.fftSize = 2048
    nextAnalyser.smoothingTimeConstant = 0.72
    source.buffer = buffer
    source.connect(nextAnalyser)
    nextAnalyser.connect(ctx.destination)
    source.addEventListener('ended', () => {
      if (audioSource !== source) return
      stopAudio()
      setStatus('Playback complete; purple bars show the last analysed audio')
    }, { once: true })
    audioSource = source
    analyser = nextAnalyser
    playButton.textContent = 'Stop'
    setStatus('Playing fitted sound into the analyser')
    source.start()
    monitorAnalyser()
  }

  function mutate() {
    activePreset = 'custom'
    target = normalizeSpectrum(target.map((value, index) =>
      value * 0.78 + model[index] * 0.18 + Math.sin(index * 1.7 + params[0] * 5) * 0.04,
    ))
    params = params.map((value, index) => clamp01(value + Math.sin((index + 1) * 9.17 + loss * 31) * 0.12))
    history = []
    renderedPatch = null
    proofReal = Array.from({ length: SPECTRAL_BIN_COUNT }, () => 0)
    hasProofAudio = false
    landscapeGrid = null
    revokeWav()
    setStatus('New target shape. Fit the synth again to hear it.')
    renderAll()
  }

  function downloadWav() {
    if (!wavUrl) void verifyRender().then(downloadWav)
    else {
      const link = document.createElement('a')
      link.href = wavUrl
      link.download = 'stopcock-spectral-optimizer.wav'
      link.click()
      setStatus('Fitted sound exported as WAV')
    }
  }

  function downloadFingerprint() {
    downloadSvg('stopcock-trajectory-fingerprint.svg', makeFingerprint(history.length ? history : [{ step: 0, params, loss }], palette()))
    setStatus('Gradient trail exported as SVG')
  }

  function downloadPoster() {
    const svg = makePoster({
      finalParams: params,
      history: history.length ? history : [{ step: 0, params, loss }],
      audioStats: lastAudioStats,
      palette: palette(),
      lens,
    })
    downloadSvg('stopcock-spectral-poster.svg', svg)
    setStatus('Patch poster exported as SVG')
  }

  targetSvg.addEventListener('pointerdown', (event) => {
    targetSvg.setPointerCapture(event.pointerId)
    setTargetAt(event)
  })
  targetSvg.addEventListener('pointermove', (event) => {
    if (dragIndex !== null) setTargetAt(event)
  })
  targetSvg.addEventListener('pointerup', () => {
    dragIndex = null
  })
  targetSvg.addEventListener('pointercancel', () => {
    dragIndex = null
  })
  lensSelect.addEventListener('change', () => {
    lens = lensSelect.value as LensKey
    renderAll()
  })
  liveToggle.addEventListener('change', () => {
    if (!liveToggle.checked) stopAudio()
  })
  optimizeButton.addEventListener('click', () => void optimize())
  playButton.addEventListener('click', () => void playRendered())
  mutateButton.addEventListener('click', mutate)
  resetButton.addEventListener('click', () => setPreset(activePreset === 'custom' ? 'glassPluck' : activePreset))
  wavButton.addEventListener('click', downloadWav)
  fingerprintButton.addEventListener('click', downloadFingerprint)
  posterButton.addEventListener('click', downloadPoster)

  spectrogram = makeSpectrogramPool(spectrogramSvg)
  renderAll()
</script>

