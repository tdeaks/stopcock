{
  "name": "benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "vp test bench --run",
    "bench:bun": "bun run ../node_modules/vitest/vitest.mjs bench --run",
    "bench:node": "node --import=tsx node_modules/.bin/vitest bench --run",
    "bench:deno": "deno run -A ../node_modules/.bin/vitest bench --run",
    "bench:dist": "vp test bench --run --config vitest.config.dist.ts",
    "validate:autodiff": "vp test run --config vitest.config.validate.ts src/autodiff-validate.test.ts",
    "validate": "vp test run --config vitest.config.validate.ts",
    "perf:baseline:s1c:bun": "bun run src/reference/s1c-baseline-run.ts",
    "perf:baseline:s1c:node": "node --expose-gc --import=tsx src/reference/s1c-baseline-run.ts",
    "perf:allocation:bun": "bun run src/reference/allocation-perf-gate.ts",
    "perf:allocation:node": "node --import=tsx src/reference/allocation-perf-gate.ts",
    "perf:allocation:quick": "bun run src/reference/allocation-perf-gate.ts --quick",
    "perf:construction:s5b": "bun run src/reference/s5b-construction-gate.ts",
    "perf:map-history:bun": "bun run src/reference/s4-map-history-gate.ts",
    "perf:map-history:node": "node --import=tsx src/reference/s4-map-history-gate.ts",
    "perf:facades:s6": "bun run src/reference/s6-facade-gate.ts",
    "perf:lanes:s7:bun": "bun run src/reference/s7-optimized-sequential-lanes.ts",
    "perf:lanes:s7:node": "node --import=tsx src/reference/s7-optimized-sequential-lanes.ts",
    "perf:size:s3b": "bun run src/reference/s3b-untagged-size-gate.ts",
    "perf:competitors": "bun run src/reference/competitor-floor-gate.ts",
    "perf:gates": "bun run src/reference/run-gates.ts",
    "perf:gates:deterministic": "bun run src/reference/run-gates.ts --deterministic",
    "perf:profile": "bun run src/reference/perf-profile-gate.ts",
    "perf:profile:bun": "bun run src/reference/perf-profile-gate.ts",
    "perf:profile:node": "node --import=tsx src/reference/perf-profile-gate.ts",
    "perf:corpus": "bun run src/reference/run-perf.ts",
    "perf:corpus:quick": "bun run src/reference/run-perf.ts --quick",
    "perf:iter:gate": "bun run src/reference/iter-perf-gate.ts",
    "perf:iter:bun": "bun run src/reference/iter-perf-gate.ts",
    "perf:iter:node": "node --import=tsx src/reference/iter-perf-gate.ts",
    "perf:iter-broad:bun": "bun run src/reference/iter-broad-perf-gate.ts",
    "perf:iter-broad:node": "node --import=tsx src/reference/iter-broad-perf-gate.ts",
    "perf:hot-paths:bun": "bun run src/reference/transducer-collector-without-perf-gate.ts",
    "perf:hot-paths:node": "node --import=tsx src/reference/transducer-collector-without-perf-gate.ts",
    "perf:portable:gate": "bun run src/reference/portable-perf-gate.ts",
    "perf:portable:bun": "bun run src/reference/portable-perf-gate.ts",
    "perf:portable:node": "node --import=tsx src/reference/portable-perf-gate.ts",
    "perf:callback-churn:bun": "bun run src/reference/portable-callback-churn-gate.ts",
    "perf:callback-churn:node": "node --import=tsx src/reference/portable-callback-churn-gate.ts",
    "perf:pipe-dispatch:bun": "bun run src/reference/pipe-dispatch-gate.ts",
    "perf:pipe-dispatch:node": "node --import=tsx src/reference/pipe-dispatch-gate.ts",
    "perf:typed-array:bun": "bun run src/reference/typed-array-perf-gate.ts",
    "perf:typed-array:node": "node --import=tsx src/reference/typed-array-perf-gate.ts",
    "check:consumer-size:s3a": "tsc -p tsconfig.consumer-size-s3a.json --noEmit",
    "test:consumer-size": "vp test run src/bundle-size/fixture-runtime.test.ts src/reference/fp-consumer-size-gate.test.ts",
    "test:consumer-size:s3a": "vp test run src/reference/fp-consumer-size-s3a-contract.test.ts",
    "test:package-size": "vp test run src/reference/fp-package-size-gate.test.ts",
    "perf:consumer-size": "bun run src/bundle-size/measure.ts --profile release",
    "perf:consumer-size:s3a": "bun run src/reference/fp-consumer-size-s3a-gate.ts",
    "perf:consumer-size:s3a:repro": "bun run src/reference/fp-consumer-size-s3a-repro.ts",
    "perf:consumer-size:characterize": "bun run src/bundle-size/measure.ts --profile characterization",
    "perf:package-size": "bun run src/reference/fp-package-size-gate.ts",
    "perf:baseline": "bun run src/reference/baseline-compare.ts",
    "perf:compiler": "bun run perf:compiler:bun",
    "perf:compiler:bun": "bun run perf:compiler:stratified:bun && bun run perf:compiler-operations:bun",
    "perf:compiler:node": "bun run perf:compiler:stratified:node && bun run perf:compiler-operations:node",
    "perf:compiler:stratified:bun": "bun run src/reference/compiler-perf-gate.ts",
    "perf:compiler:stratified:node": "node --import=tsx src/reference/compiler-perf-gate.ts",
    "perf:compiler-operations:bun": "bun run src/reference/compiler-operation-perf-gate.ts",
    "perf:compiler-operations:node": "node --import=tsx src/reference/compiler-operation-perf-gate.ts",
    "perf:core-utilities": "bun run src/reference/core-utilities-perf-gate.ts",
    "perf:core-utilities:bun": "bun run src/reference/core-utilities-perf-gate.ts",
    "perf:core-utilities:node": "node --import=tsx src/reference/core-utilities-perf-gate.ts",
    "perf:data-functional": "bun run src/reference/data-functional-perf-gate.ts",
    "perf:data-functional:bun": "bun run src/reference/data-functional-perf-gate.ts",
    "perf:data-functional:node": "node --import=tsx src/reference/data-functional-perf-gate.ts",
    "perf:scalar-text-hash": "bun run src/reference/scalar-text-hash-perf-gate.ts",
    "perf:scalar-text-hash:bun": "bun run src/reference/scalar-text-hash-perf-gate.ts",
    "perf:scalar-text-hash:node": "node --import=tsx src/reference/scalar-text-hash-perf-gate.ts",
    "perf:structural": "bun run src/reference/structural-perf-gate.ts",
    "perf:structural:bun": "bun run src/reference/structural-perf-gate.ts",
    "perf:structural:node": "node --import=tsx src/reference/structural-perf-gate.ts",
    "perf:third-wave": "bun run src/reference/third-wave-perf-gate.ts",
    "perf:third-wave:bun": "bun run src/reference/third-wave-perf-gate.ts",
    "perf:third-wave:node": "node --import=tsx src/reference/third-wave-perf-gate.ts",
    "report:bun": "BENCH_IDENTITY_FILE=/tmp/stopcock-bench-identity-bun.json bun run ../node_modules/vitest/vitest.mjs bench --run --outputJson /tmp/stopcock-bench-results-bun.json && bun run generate-report.ts --lane bun --results /tmp/stopcock-bench-results-bun.json --identity /tmp/stopcock-bench-identity-bun.json --json > ../docs/benchmarks-bun.md",
    "report:node": "BENCH_IDENTITY_FILE=/tmp/stopcock-bench-identity-node.json npx vitest bench --run --outputJson /tmp/stopcock-bench-results-node.json && bun run generate-report.ts --lane node --results /tmp/stopcock-bench-results-node.json --identity /tmp/stopcock-bench-identity-node.json --json > ../docs/benchmarks-node.md",
    "report:deno": "BENCH_IDENTITY_FILE=/tmp/stopcock-bench-identity-deno.json deno run -A ../node_modules/.bin/vitest bench --run --outputJson /tmp/stopcock-bench-results-deno.json && bun run generate-report.ts --lane deno --results /tmp/stopcock-bench-results-deno.json --identity /tmp/stopcock-bench-identity-deno.json --json > ../docs/benchmarks-deno.md",
    "report:dist:bun": "BENCH_IDENTITY_FILE=/tmp/stopcock-bench-identity-bun-dist.json bun run ../node_modules/vitest/vitest.mjs bench --run --config vitest.config.dist.ts --outputJson /tmp/stopcock-bench-results-bun-dist.json && bun run generate-report.ts --lane bun-dist --results /tmp/stopcock-bench-results-bun-dist.json --identity /tmp/stopcock-bench-identity-bun-dist.json --json > ../docs/benchmarks-bun-dist.md",
    "report:dist:node": "BENCH_IDENTITY_FILE=/tmp/stopcock-bench-identity-node-dist.json npx vitest bench --run --config vitest.config.dist.ts --outputJson /tmp/stopcock-bench-results-node-dist.json && bun run generate-report.ts --lane node-dist --results /tmp/stopcock-bench-results-node-dist.json --identity /tmp/stopcock-bench-identity-node-dist.json --json > ../docs/benchmarks-node-dist.md",
    "report:dist:deno": "BENCH_IDENTITY_FILE=/tmp/stopcock-bench-identity-deno-dist.json deno run -A ../node_modules/.bin/vitest bench --run --config vitest.config.dist.ts --outputJson /tmp/stopcock-bench-results-deno-dist.json && bun run generate-report.ts --lane deno-dist --results /tmp/stopcock-bench-results-deno-dist.json --identity /tmp/stopcock-bench-identity-deno-dist.json --json > ../docs/benchmarks-deno-dist.md"
  },
  "dependencies": {
    "@mobily/ts-belt": "3.13.1",
    "@stopcock/autodiff": "workspace:*",
    "@stopcock/color": "workspace:*",
    "@stopcock/date": "workspace:*",
    "@stopcock/diff": "workspace:*",
    "@stopcock/fp": "workspace:*",
    "@stopcock/img": "workspace:*",
    "@stopcock/la": "workspace:*",
    "@stopcock/signal": "workspace:*",
    "@stopcock/state": "workspace:*",
    "@stopcock/svg": "workspace:*",
    "@stopcock/synth": "workspace:*",
    "date-fns": "4.3.0",
    "lodash-es": "4.18.1",
    "luxon": "3.7.2",
    "moment": "2.30.1",
    "rambda": "11.2.0",
    "ramda": "0.32.0",
    "remeda": "2.34.1"
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "@types/luxon": "3.7.2",
    "@types/ramda": "0.31.1",
    "esbuild": "0.28.1",
    "rolldown": "1.0.1",
    "rollup": "4.62.2",
    "terser": "5.49.0",
    "tsx": "4.22.3",
    "webpack": "5.108.4"
  }
}
