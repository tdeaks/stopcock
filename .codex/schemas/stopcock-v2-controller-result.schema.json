{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "outcome": {
      "type": "string",
      "enum": ["checkpoint_ready"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedHead": {
          "type": "string",
          "maxLength": 40
        },
        "message": {
          "type": "string",
          "maxLength": 120
        },
        "stage": {
          "type": "string",
          "maxLength": 16
        },
        "scope": {
          "type": "string",
          "maxLength": 32
        },
        "scopeTarget": {
          "type": "string",
          "maxLength": 80
        },
        "nextStage": {
          "type": "string",
          "maxLength": 16
        },
        "nextSlice": {
          "type": "string",
          "maxLength": 160
        },
        "postProgrammeStatus": {
          "type": "string",
          "enum": ["", "IN_PROGRESS", "BLOCKED", "PROGRAMME_COMPLETE"]
        },
        "postStageStatus": {
          "type": "string",
          "enum": ["", "IN_PROGRESS", "GATE_PASSED", "STOPPED_BY_PLAN", "BLOCKED"]
        },
        "contentDigest": {
          "type": "string",
          "maxLength": 71
        },
        "paths": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "required": [
        "expectedHead",
        "message",
        "stage",
        "scope",
        "scopeTarget",
        "nextStage",
        "nextSlice",
        "postProgrammeStatus",
        "postStageStatus",
        "contentDigest",
        "paths"
      ]
    }
  },
  "required": ["version", "outcome", "summary", "checkpoint"]
}
